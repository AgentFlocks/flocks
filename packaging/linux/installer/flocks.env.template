# Flocks offline installation — service environment.
# Managed by the offline installer: FLOCKS_INSTALL_ROOT, FLOCKS_REPO_ROOT, FLOCKS_NODE_HOME,
# FLOCKS_DEPLOY_MODE, FLOCKS_UPDATE_CHANNEL, FLOCKS_PRO_BUNDLE_DIR, UV_CACHE_DIR, UV_PYTHON and
# PATH are rewritten on every install/upgrade; FLOCKS_PORT only when the installer is run with
# FLOCKS_OFFLINE_PORT. A package without a Pro bundle removes the offline pins
# (FLOCKS_OFFLINE_INSTALL, FLOCKS_UPDATE_CHANNEL, FLOCKS_PRO_BUNDLE_DIR, UV_OFFLINE,
# npm_config_offline); every other line is kept as you left it.
# After editing: sudo systemctl restart flocks

HOME=@DATA_HOME@
FLOCKS_ROOT=@DATA_HOME@/.flocks
FLOCKS_INSTALL_ROOT=@INSTALL_ROOT@
FLOCKS_REPO_ROOT=@INSTALL_ROOT@/flocks
FLOCKS_NODE_HOME=@INSTALL_ROOT@/tools/node
# 'offline' (package with a Pro bundle): Pro comes from @INSTALL_ROOT@/bundle, network-based
#           in-place upgrades are refused, a newer flocks-offline.run upgrades the core
# 'source'  (open-source package): upgrades go online like a source install (Pro in the WebUI)
FLOCKS_DEPLOY_MODE=@DEPLOY_MODE@
FLOCKS_OFFLINE_INSTALL=1

# Listen on all interfaces so the WebUI is reachable at http://<server-ip>:@PORT@
FLOCKS_HOST=0.0.0.0
FLOCKS_PORT=@PORT@

# Flocks Pro / cloud console
FLOCKS_CONSOLE_BASE_URL=https://portalflocks.threatbook.cn
FLOCKS_UPDATE_CHANNEL=@UPDATE_CHANNEL@
FLOCKS_PRO_BUNDLE_DIR=@INSTALL_ROOT@/bundle

# Bundled uv / npm; with a Pro bundle they never reach the network from this machine
UV_OFFLINE=1
# `uv run` (the agent's skills call it) uses the shipped .venv as it is. Without this uv first
# syncs the project: it finds the editable flocks install stale (unpacking changed the files'
# ctime) and tries to rebuild it, which needs hatchling from PyPI and fails offline.
UV_NO_SYNC=1
UV_NO_PYTHON_DOWNLOADS=1
UV_CACHE_DIR=@INSTALL_ROOT@/cache/uv
UV_PYTHON=@INSTALL_ROOT@/tools/python/bin/python3
npm_config_offline=true
npm_config_audit=false
npm_config_fund=false

PATH=@INSTALL_ROOT@/flocks/.venv/bin:@INSTALL_ROOT@/tools/node/bin:@INSTALL_ROOT@/tools/uv:/usr/local/bin:/usr/bin:/bin
LANG=C.UTF-8
PYTHONUNBUFFERED=1
