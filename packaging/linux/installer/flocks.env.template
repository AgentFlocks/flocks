# Flocks offline installation — service environment.
# Managed by the offline installer: FLOCKS_INSTALL_ROOT, FLOCKS_REPO_ROOT, FLOCKS_NODE_HOME,
# FLOCKS_UPDATE_CHANNEL, FLOCKS_PRO_BUNDLE_DIR, UV_CACHE_DIR, UV_PYTHON and PATH are rewritten
# on every install/upgrade; FLOCKS_PORT only when the installer is run with FLOCKS_OFFLINE_PORT;
# every other line is kept as you left it.
# After editing: sudo systemctl restart flocks

HOME=@DATA_HOME@
FLOCKS_ROOT=@DATA_HOME@/.flocks
FLOCKS_INSTALL_ROOT=@INSTALL_ROOT@
FLOCKS_REPO_ROOT=@INSTALL_ROOT@/flocks
FLOCKS_NODE_HOME=@INSTALL_ROOT@/tools/node
# 'offline' = behaves like a source install but refuses network-based in-place upgrades
FLOCKS_DEPLOY_MODE=offline
FLOCKS_OFFLINE_INSTALL=1

# Listen on all interfaces so the WebUI is reachable at http://<server-ip>:@PORT@
FLOCKS_HOST=0.0.0.0
FLOCKS_PORT=@PORT@

# Flocks Pro / cloud console (the only outbound endpoint the server needs)
FLOCKS_CONSOLE_BASE_URL=https://portalflocks.threatbook.cn
FLOCKS_UPDATE_CHANNEL=@UPDATE_CHANNEL@
FLOCKS_PRO_BUNDLE_DIR=@INSTALL_ROOT@/bundle

# Never let uv / npm reach the network from this machine
UV_OFFLINE=1
UV_NO_PYTHON_DOWNLOADS=1
UV_CACHE_DIR=@INSTALL_ROOT@/cache/uv
UV_PYTHON=@INSTALL_ROOT@/tools/python/bin/python3
npm_config_offline=true
npm_config_audit=false
npm_config_fund=false

PATH=@INSTALL_ROOT@/flocks/.venv/bin:@INSTALL_ROOT@/tools/node/bin:@INSTALL_ROOT@/tools/uv:/usr/local/bin:/usr/bin:/bin
LANG=C.UTF-8
PYTHONUNBUFFERED=1
