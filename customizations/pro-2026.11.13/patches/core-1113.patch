+@t.overload
+def column(
+    col: str | Identifier,
+    table: t.Optional[str | Identifier] = None,
+    db: t.Optional[str | Identifier] = None,
+    catalog: t.Optional[str | Identifier] = None,
+    *,
+    fields: t.Collection[t.Union[str, Identifier]],
+    quoted: t.Optional[bool] = None,
+    copy: bool = True,
+) -> Dot:
+    pass
