+                                  "baseline_complete": bool(state.get("baseline_complete", False) or not index["truncated"]),
+                                  "sample_count": 0, "sample_limit": limit, "available_count": len(nodes),
+                                  "pending_count": 0, "base_version": base_version,
+                                  "generation_method": state.get("generation_method", "model"),
+                                  "scan_incomplete": bool(index["truncated"])}
+                    updated = {**saved, "daily_state": next_state}
+                    engine._check_read_scope(user, context)
+                    await engine._commit_locked_write(_seal_reused, engine, context, definition["id"], updated)
+                    counts["unchanged"] += 1
+                    counts["reused"] += 1
+                    results.append(read(engine, context, definition, config))
+                    continue
