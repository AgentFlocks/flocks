+class Recorder:
+    session_id = 'details-session'
+    def __init__(self):
+        self.summaries = []
+    async def call(self, name, params, operation):
+        outcome = await operation('details-message')
+        self.summaries.append((name, outcome[2] if len(outcome) > 2 else None))
+        return outcome[0]
