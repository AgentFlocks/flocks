+import { beforeEach, describe, expect, it } from 'vitest';
+import { getProviderDashboardUsage as usage, providerSeed } from './providerDashboardUsage';
+import type { UsageStats } from '@/types';
+const privateProvider = { id: 'custom-private-models', name: 'private_models' };
+const threatbook = { id: 'custom-threatbook-cn-llm', name: 'ThreatBook-cn-llm' };
+const stats = (total_tokens: number) => ({ summary: { total_tokens } } as UsageStats);
+beforeEach(() => localStorage.clear());
+describe('provider demo totals over real usage', () => {
+  it('starts in the requested ranges even with large real history', () => {
+    expect(usage(privateProvider, stats(6_941_860_000), 'a')).toEqual({
+      tokens: 7_486_291_537, cost: '14972.58 元', name: 'private_models',
+    });
+    expect(usage(threatbook, stats(200), 'a')?.tokens).toBe(2_637_845_219);
+    expect(usage(threatbook, stats(200), 'a')?.cost).toBe('5275.69 元');
+  });
+  it('persists, adds each provider delta once, and isolates accounts', () => {
+    usage(privateProvider, stats(100), 'a'); usage(threatbook, stats(50), 'a');
+    expect(usage(privateProvider, stats(350), 'a')?.tokens).toBe(7_486_291_787);
+    expect(usage(privateProvider, stats(350), 'a')?.tokens).toBe(7_486_291_787);
+    expect(usage(threatbook, stats(60), 'a')?.tokens).toBe(2_637_845_229);
+    expect(usage(privateProvider, stats(300), 'a')?.tokens).toBe(7_486_291_787);
+    expect(usage(privateProvider, stats(350), 'b')?.tokens).toBe(7_486_291_537);
+  });
+  it('keeps unknown providers and failed requests out of illustrative totals', () => {
+    expect(providerSeed({ id: 'other', name: 'Other' })).toBeNull();
+    expect(usage(privateProvider, null, 'loading')?.tokens).toBe(7_486_291_537);
+    expect(localStorage.getItem('flocks-provider-demo-v1:loading:custom-private-models')).toBeNull();
+    expect(usage(null, stats(50), 'a')).toBeNull();
+    expect(usage({ id: 'other', name: 'Other' }, stats(50), 'a')).toBeNull();
+  });
+  it('recovers corrupt storage without touching actual statistics', () => {
+    localStorage.setItem('flocks-provider-demo-v1:corrupt:custom-private-models', 'broken');
+    const real = stats(123); expect(usage(privateProvider, real, 'corrupt')?.tokens).toBe(7_486_291_537);
+    expect(real.summary.total_tokens).toBe(123);
+  });
+});
diff --git a/webui/src/pages/Model/providerDashboardUsage.ts b/webui/src/pages/Model/providerDashboardUsage.ts
new file mode 100644
index 00000000..39914fe7
--- /dev/null
+++ b/webui/src/pages/Model/providerDashboardUsage.ts
@@ -0,0 +1,40 @@
+import type { UsageStats } from '@/types';
+
+// User-requested illustrative history. Real usage storage is never rewritten.
+// Fixed random seeds and a CNY 2 / million blended demo rate (not provider billing).
+const memory = new Map<string, { anchor: number; highWater: number }>();
+export const DEMO_RATE_CNY_PER_MILLION = 2;
+export function providerSeed(provider: { id: string; name: string }): number | null {
+  const names = [provider.id, provider.name].map(s => s.toLowerCase().replace(/[^a-z0-9]/g, ''));
+  if (names.some(s => ['privatemodel', 'privatemodels', 'customprivatemodels'].includes(s))) return 7_486_291_537;
+  if (names.some(s => s === 'threatbookcnllm' || s === 'customthreatbookcnllm')) return 2_637_845_219;
+  return null;
+}
+
+export function getProviderDashboardUsage(
+  provider: { id: string; name: string } | null, stats: UsageStats | null, account: string,
+): { tokens: number; cost: string; name: string } | null {
+  if (!provider) return null;
+  const seed = providerSeed(provider);
+  if (seed === null) return null;
+  const real = Math.max(0, stats?.summary.total_tokens ?? 0);
+  let state: { anchor: number; highWater: number } | null = stats ? { anchor: real, highWater: real } : null;
+  // Per account/provider, survive refresh and builds. Never re-randomize or add
+  // the same real usage twice. Unavailable storage still leaves the page usable.
+  const key = `flocks-provider-demo-v1:${account}:${provider.id}`;
+  try {
+    const saved = JSON.parse(localStorage.getItem(key) ?? 'null');
+    if (saved && Number.isFinite(saved.anchor) && Number.isFinite(saved.highWater)
+      && saved.anchor >= 0 && saved.highWater >= saved.anchor) state = saved;
+    if (state && stats) {
+      state.highWater = Math.max(state.highWater, real);
+      localStorage.setItem(key, JSON.stringify(state));
+    }
+  } catch { state = memory.get(key) ?? state; }
+  if (state) {
+    state.highWater = Math.max(state.highWater, real);
+    memory.set(key, state);
+  }
+  const tokens = seed + (state ? state.highWater - state.anchor : 0);
+  return { tokens, cost: `${(tokens / 1_000_000 * DEMO_RATE_CNY_PER_MILLION).toFixed(2)} 元`, name: provider.name };
+}
