+            if any(key in item and item[key] is None for key in list_keys):
+                note('来源实体列表为空值，未取得完整结果')
+            if any(key in item and item[key] is not None and not isinstance(item[key], list) for key in list_keys):
+                note('来源列表结构不可核对，未取得完整结果')
+            for prior_note in item.get('_evidenceLimits', []) if isinstance(item.get('_evidenceLimits'), list) else []:
+                note(_text(prior_note, 160))
+            if len(item) > 2000:
+                note('事实字段数量已截断')
+            for key, nested in list(item.items())[:2000]:
+                if key not in _FACT_KEYS or key == '_evidenceLimits':
+                    continue
+                if remaining[0] < len(key.encode('utf-8')) + 8:
+                    note('总事实预算已用完，内容不完整')
+                    break
+                remaining[0] -= len(json.dumps(key).encode('utf-8')) + 2
+                if key in {'net.http.reqs_cookie', 'reqs_cookie'}:
+                    output[key] = charge(_REDACTED)
+                elif key in _PACKET_ALIASES:
+                    output[key] = packet_value(nested, _PACKET_ALIASES[key])
+                else:
+                    output[key] = keep(nested, depth+1)
+            listed = [v for k, v in item.items() if k in set(list_keys) and isinstance(v, list)]
+            if type(item.get('total')) is int and any(item['total'] > len(v) for v in listed):
+                note('返回数量少于来源总数，仅取得部分记录')
+            return output
+        if isinstance(item, list):
+            if len(item) > 20:
+                note('事实列表已截断')
+            return [keep(v, depth+1) for v in item[:20]]
+        if isinstance(item, str):
+            limited, partial = _clip(item, 2000 if depth <= 2 else MAX_TEXT)
+            if partial:
+                note('事实文本已截断')
+            return charge(limited)
+        if item is None or type(item) in (bool, int):
+            return charge(item)
+        if type(item) is float:
+            try:
+                return charge(item)
+            except ValueError:
+                note('事实中存在非有限数值')
+        return None
+
+    safe = keep(value)
+    if not isinstance(safe, dict):
+        safe = {'items': safe} if isinstance(safe, list) else {}
+    if notes:
+        safe['_evidenceLimits'] = notes
+    # Defensive serialization bound (list punctuation is deliberately not
+    # charged per element). Preserve early facts and mark the omitted tail.
+    if len(json.dumps(safe, ensure_ascii=False).encode('utf-8')) > MAX_FACT_BYTES:
+        note('总事实预算已用完，内容不完整')
+        while len(json.dumps(safe, ensure_ascii=False).encode('utf-8')) > MAX_FACT_BYTES - 500 and safe:
+            candidates = [(len(json.dumps(v, ensure_ascii=False)), k) for k, v in safe.items() if k != '_evidenceLimits']
+            if not candidates:
+                break
+            _, key = max(candidates)
+            nested = safe[key]
+            if isinstance(nested, dict) and nested:
+                nested.pop(next(reversed(nested)))
+            elif isinstance(nested, list) and nested:
+                nested.pop()
+            else:
+                safe.pop(key)
+        safe['_evidenceLimits'] = notes
+    return safe, bool(notes)
+
+
+def _walk(value, alert_id='', alerts_mode=False, allow_generic_alert_ids=True):
+    if isinstance(value, dict):
+        explicit = value.get('alertId') or documented_fields(value).get('threat.id')
+        identifier = value.get('uuId') or value.get('uuid') or value.get('id')
+        if isinstance(explicit, str) and explicit:
+            alert_id = explicit
+        elif allow_generic_alert_ids and isinstance(identifier, str) and not identifier.startswith('incident-') and (
+                identifier.startswith('alert-') or alerts_mode or 'proofType' in value):
+            alert_id = identifier
+        yield value, alert_id
+        for nested in value.values():
+            if isinstance(nested, (dict, list)):
+                yield from _walk(nested, alert_id, alerts_mode, allow_generic_alert_ids)
+    elif isinstance(value, list):
+        for nested in value:
+            yield from _walk(nested, alert_id, alerts_mode, allow_generic_alert_ids)
+
+
+def _when(value):
+    """Return sortable actual event time; never use collection time as a proxy."""
+    if isinstance(value, bool) or value is None:
+        return None
+    try:
+        if isinstance(value, (int, float)) or isinstance(value, str) and re.fullmatch(r'\d{10,13}', value):
+            seconds = float(value)
+            if seconds > 10**11:
+                seconds /= 1000
+            return datetime.fromtimestamp(seconds, timezone.utc).timestamp()
+        parsed = datetime.fromisoformat(str(value).replace('Z', '+00:00'))
+        # Source timestamps without an offset remain literal source time. We
+        # use UTC only for ordering, and never attach an invented display zone.
+        return parsed.replace(tzinfo=parsed.tzinfo or timezone.utc).timestamp()
+    except (ValueError, OverflowError, OSError):
+        return None
+
+
+def _text(value, limit=800):
+    if isinstance(value, list):
+        value = '、'.join(str(v) for v in value)
+    return _clip(value, limit)[0]
+
+
+def brief_values(value, noun='项', limit=2):
+    values = value if isinstance(value, list) else [value]
+    values = [str(item) for item in values if type(item) in (str, int, float) and str(item)]
+    selected = list(dict.fromkeys(values))
+    text = '、'.join(_readable_text(item, 70) for item in selected[:limit])
+    return text + (f'等{len(selected)}个{noun}' if len(selected) > limit else '')
+
+
+def behavior_description(record, fallback=None):
+    """Describe source observations; never assert successful exploitation."""
+    fallback = fallback if isinstance(fallback, dict) else {}
+    name = _readable_text(record.get('name') or record.get('virus_name') or fallback.get('name') or '安全事件', 80)
+    host = brief_values(record.get('host') or fallback.get('host'), '主机')
+    src, dst = brief_values(record.get('src_ip'), '源地址'), brief_values(record.get('dst_ip'), '目标地址')
+    port = brief_values(record.get('dst_port'), '端口')
+    if src and dst:
+        single = not isinstance(record.get('dst_ip'), list) or len(record['dst_ip']) == 1
+        endpoint = dst + (':' + port if port and single else f'（目的端口{port}）' if port else '')
+        dns = port == '53'
+        content = f'{src}向{endpoint}发起' + ('DNS查询' if dns else '访问')
+        domain = brief_values(record.get('domain'), '域名')
+        if domain:
+            content += '，涉及域名' + domain
+        return _readable_text(content + f'，来源检测为「{name}」。', 240)
+    if record.get('file_path') or record.get('file_name'):
+        content = f'主机{host}记录文件' if host else '来源记录文件'
+        content += brief_values(record.get('file_path') or record.get('file_name'), '文件')
+        return _readable_text(content + f'，检测为「{name}」。', 200)
+    if record.get('process_name') or record.get('command_line'):
+        content = f'主机{host}记录进程' if host else '来源记录进程'
+        content += brief_values(record.get('process_name') or record.get('command_line'), '进程')
+        return _readable_text(content + f'，关联「{name}」告警。', 200)
+    if record.get('url'):
+        return _readable_text(f'主机{host}的访问记录涉及{brief_values(record["url"], "地址")}，检测为「{name}」。', 200)
+    if record.get('domain'):
+        return _readable_text(f'来源记录关联域名{brief_values(record["domain"], "域名")}，检测为「{name}」。', 200)
+    return _readable_text((f'主机{host}出现' if host else '来源检测到') + f'「{name}」告警。', 180)
+
+
+def timeline_projection(story, *, other_events=None):
+    """Add one source-time range per verified card without rewriting its audit.
+
+    Cards already carry the event/version and device boundaries. Do not merge
+    them again by name, time or alert ID, and never date them by query time.
+    """
+    from .evidence_presenter import _summary
+
+    story = story if isinstance(story, dict) else {}
+
+    def pick(value, latest=False):
+        values = value if isinstance(value, list) else [value]
+        dated = [(stamp, item) for item in values if (stamp := _when(item)) is not None]
+        return (max if latest else min)(dated, key=lambda item: item[0])[1] if dated else None
+
+    basics = story.get('basics') if isinstance(story.get('basics'), dict) else {}
+    projection = {'event_time_range': {'first_time': pick(basics.get('start_time')),
+                                       'end_time': pick(basics.get('end_time'), True)}}
+    cards = story.get('evidence_cards')
+    if not isinstance(cards, list):
+        return projection  # Older saved stories keep their original timeline.
+    alerts, references = [], set()
+    for index, card in enumerate(cards):
+        if not isinstance(card, dict):
+            continue
+        fields = {field.get('key'): field.get('value') for field in card.get('fields', [])
+                  if isinstance(field, dict)} if isinstance(card.get('fields'), list) else {}
+        first, end = pick(fields.get('start_time')), pick(fields.get('end_time'), True)
+        if first is None and end is None:
+            observed = fields.get('alert_time')
+            if pick(observed) is None:
+                observed = card.get('time')
+            first, end = pick(observed), pick(observed, True)
+        source = _readable_text(card.get('source') or '', 160)
+        card_id = _text(card.get('id') or '', 200) or f'card-{index + 1}'
+        alert_id = _text(card['alert_id'], 1000) if isinstance(card.get('alert_id'), str) else ''
+        name = _readable_text(fields.get('name') or '', 100) if alert_id else '取证记录'
+        kind_labels = {'network': '网络访问记录', 'domain': '域名关联记录', 'file': '文件取证记录',
+                       'process': '进程取证记录', 'request': '请求与响应记录'}
+        packets = card.get('packets') if isinstance(card.get('packets'), list) else []
+        text = _summary(fields, source, packets)
+        if not text:
+            detail = _readable_text(card.get('summary') or kind_labels.get(card.get('kind'), '取证资料'), 200)
+            text = f'来源记录显示：{detail.rstrip("。 ")}。'
+        records = card.get('records') if isinstance(card.get('records'), list) else []
+        refs = list(dict.fromkeys(_text(record.get('evidence_id'), 100) for record in [card, *records]
+                                 if isinstance(record, dict) and record.get('evidence_id')))
+        references.update(refs)
+        alerts.append({'id': f'alert-timeline-{index + 1}-{card_id}', 'card_id': card_id,
+                       'kind': 'alert' if alert_id else 'observation',
+                       **({'alert_id': alert_id} if alert_id else {}),
+                       'first_time': first, 'end_time': end, 'time': first if first is not None else end,
+                       'name': name,
+                       'text': _readable_text(text, 240), 'source': source, 'evidence_ids': refs,
+                       'partial': bool(card.get('partial')), 'boundary': _text(card.get('boundary') or '', 600)})
+    alerts.sort(key=lambda row: (_when(row['time']) if _when(row['time']) is not None else float('inf'), row['id']))
+    if other_events is None:
+        other_events = story.get('other_timeline')
+        if not isinstance(other_events, list):
+            legacy = story.get('timeline') if isinstance(story.get('timeline'), list) else []
+            other_events = [entry for entry in legacy if isinstance(entry, dict)
+                            and entry.get('evidence_id') in references
+                            and (entry.get('kind') == 'file_created' or '来源记录文件创建' in str(entry.get('text', '')))]
+    other, seen = [], set()
+    for entry in other_events:
+        if not isinstance(entry, dict) or _when(entry.get('time')) is None:
+            continue
+        text = _readable_text(entry.get('text') or '', 600)
+        marker = (_when(entry['time']), text)
+        if not text or marker in seen:
+            continue
+        seen.add(marker)
+        other.append({'id': f'other-timeline-{len(other) + 1}', 'kind': 'file_created',
+                      'time': entry['time'], 'text': text, 'evidence_id': _text(entry.get('evidence_id') or '', 100)})
+    other.sort(key=lambda row: _when(row['time']))
+    truncated = bool(story.get('timeline_truncated')) or len(other) > 40
+    if len(other) > 40:
+        other = [*other[:20], *other[-20:]]
+    projection.update(alert_timeline=alerts, other_timeline=other, timeline_truncated=truncated)
+    return projection
+
+
+def build_story(event, evidence, result=None, *, canonical=None):
+    """Build an evidence-linked story, keeping collection and event times apart."""
+    event = event if isinstance(event, dict) else {}
+    evidence = evidence if isinstance(evidence, list) else []
+    result = result if isinstance(result, dict) else event.get('investigation', {})
+    result = result if isinstance(result, dict) else {}
+    basics = normalize_basics(event.get('basics', {}))
+    for key, val in normalize_basics(event).items():
+        basics.setdefault(key, val)
+    story = {'basics': basics, 'device': _text(event.get('device_name') or event.get('device') or '来源未提供'),
+             'timeline': [], 'key_evidence': [], 'packets': [], 'other_queries': [], 'gaps': [],
+             'alert_details': [],
+             'conclusion': _text(result.get('reason') or '尚未形成有证据支持的调查结论', 1800),
+             'verdict': result.get('verdict', 'unknown'), 'boundaries': []}
+    seen, timeline_seen, alerts_seen = set(), set(), set()
+    other_events = []
+    is_web_event = any(term in str(event.get('name', '')).lower() for term in ('sql', 'web', 'http', '注入', '跨站', '目录遍历'))
+    packet_groups = {}
+
+    def gap(text):
+        text = _text(text, 600)
+        if text and text not in story['gaps'] and len(story['gaps']) < 24:
+            story['gaps'].append(text)
+
+    def key_fact(ref, text, priority=False):
+        marker = (ref, text)
+        if marker not in seen and (priority or len(story['key_evidence']) < 30):
+            seen.add(marker)
+            item = {'evidence_id': ref, 'text': _text(text, 1600)}
+            if priority:
+                story['key_evidence'].insert(0, item)
+                del story['key_evidence'][30:]
+            else:
+                story['key_evidence'].append(item)
+
+    def timeline(time_value, text, ref, phase='', detailed=False):
+        stamp = _when(time_value)
+        marker = (stamp, text, phase)
+        if stamp is None or marker in timeline_seen:
+            return
+        if detailed and phase:
+            story['timeline'][:] = [entry for entry in story['timeline'] if not (
+                _when(entry['time']) == stamp and entry.get('phase') == phase and entry['evidence_id'] == '事件基础信息')]
+        if len(story['timeline']) < 40:
+            timeline_seen.add(marker)
+            story['timeline'].append({'time': time_value, 'text': _text(text), 'evidence_id': ref, 'phase': phase})
+
+    base_description = behavior_description(basics)
+    if basics.get('start_time') is not None:
+        timeline(basics['start_time'], '首次检出：' + base_description, '事件基础信息', 'first')
+    if basics.get('end_time') is not None and basics.get('end_time') != basics.get('start_time'):
+        timeline(basics['end_time'], '最近检出：' + base_description, '事件基础信息', 'latest')
+    for proof in evidence[:24]:
+        if not isinstance(proof, dict):
+            continue
+        ref = _text(proof.get('id') or '未编号证据', 100)
+        source = _text(proof.get('source_name') or proof.get('device_name') or proof.get('device') or proof.get('tool') or '来源未提供', 160)
+        kind = _text(proof.get('kind') or '关联', 50)
+        if not proof.get('success'):
+            gap(f'{ref} · {source}：查询未完成；{proof.get("error") or "未取得可用结果"}，不能按无风险处理')
+            continue
+        facts, clipped = safe_facts(proof.get('facts', {}))
+        if proof.get('partial') or clipped:
+            gap(f'{ref} · {source}：仅取得部分事实，不能据此排除风险')
+        prior_notes = proof.get('facts', {}).get('_evidenceLimits', []) if isinstance(proof.get('facts'), dict) else []
+        for note in [*prior_notes, *facts.get('_evidenceLimits', [])]:
+            gap(f'{ref}：{note}')
+        before = len(story['key_evidence'])
+        is_tdp = proof.get('product') == 'tdp' or str(proof.get('tool', '')).startswith('tdp_')
+        for row, alert_id in _walk(facts, alerts_mode=kind in {'alerts', 'alert', 'alert_proof', 'alert-proof'},
+                                   allow_generic_alert_ids=not is_tdp):
+            row = documented_fields(row)
+            record = normalize_basics(row)
+            if is_tdp:
+                record.pop('event_id', None)
+                if not any(key in row for key in ('alertId', 'alertIds', 'alert_ids', 'threat.id')):
+                    record.pop('alert_ids', None)
+            if alert_id:
+                record.pop('event_id', None)
+                record.setdefault('alert_ids', [alert_id])
+            group_key = (ref, alert_id or '告警编号未提供')
+            has_packet_fields = any(alias in row for aliases in PACKET_FIELDS.values() for alias in aliases)
+            if alert_id and any(key in row for key in ('alertId', 'uuId', 'uuid')) or has_packet_fields:
+                packet_groups.setdefault(group_key, {'fields': set(), 'name': record.get('name', ''),
+                    'web': is_web_event or has_packet_fields or 'http' in str(row.get('proofType', '')).lower()})
+            # Source identity is only descriptive here. Correlation eligibility
+            # remains the investigator's responsibility, never inferred by IP.
+            alert_marker = (ref, alert_id, str(record.get('alert_time')), str(record.get('name')))
+            if (any(key in row for key in ('alertId', 'alertTime', 'firstTime', 'lastTime')) or alert_id and 'name' in row) and alert_marker not in alerts_seen and len(story['alert_details']) < 20:
+                alerts_seen.add(alert_marker)
+                story['alert_details'].append({'evidence_id': ref, **record})
+            details = [f'{FIELD_LABELS[key]}：{_display_field(key, record[key], record)}' for key in
+                       ('alert_ids', 'host', 'data_source', 'source_device', 'virus_name', 'file_id', 'file_md5', 'file_hash', 'file_name', 'file_path', 'file_size',
+                        'file_created_at', 'process_name', 'command_line', 'url', 'domain', 'src_ip', 'src_port',
+                        'dst_ip', 'dst_port', 'attack_state', 'attack_result', 'threat_subtype', 'stage') if key in record]
+            if details:
+                key_fact(ref, source + '；' + '；'.join(details))
+            if record.get('file_created_at') is not None:
+                text = f'{source}：来源记录文件创建，文件 {_text(record.get("file_path") or record.get("file_name") or "标识未提供", 300)}（不等于告警发生时间）'
+                timeline(record['file_created_at'], text, ref)
+                other_events.append((proof, {'kind': 'file_created', 'time': record['file_created_at'], 'text': text, 'evidence_id': ref}))
+            description = behavior_description(record, basics)
+            prefix = source + '关联记录：' if proof.get('device') != event.get('device') else ''
+            for time_key, phase, title in (('start_time', 'first', '首次检出：'), ('end_time', 'latest', '最近检出：')):
+                if record.get(time_key) is not None:
+                    if time_key == 'end_time' and record.get('end_time') == record.get('start_time'):
+                        continue
+                    timeline(record[time_key], prefix + title + description, ref, phase, detailed=True)
+            if record.get('alert_time') is not None and record['alert_time'] not in (record.get('start_time'), record.get('end_time')):
+                timeline(record['alert_time'], prefix + '检测记录：' + description, ref, detailed=True)
+            for canonical, aliases in PACKET_FIELDS.items():
+                supplied = next((key for key in aliases if key in row), None)
+                if not supplied:
+                    continue
+                content = row[supplied]
+                if not isinstance(content, str) or not content and canonical.endswith('Head'):
+                    gap(f'{ref}：{PACKET_LABELS[canonical]}未取得，不能据此判定误报或攻击成功')
+                    continue
+                if group_key in packet_groups:
+                    packet_groups[group_key]['fields'].add(canonical)
+                if len(story['packets']) < 24:
+                    story['packets'].append({'evidence_id': ref, 'source': source, 'field': canonical,
+                                             'label': PACKET_LABELS[canonical], 'text': content or '（正文为空，来源明确返回）', 'alert_id': alert_id,
+                                             'truncated': _TRUNCATED in content})
+                if canonical.startswith('request'):
+                    decoded = unquote(content)
+                    matches = list(_SQL.finditer(decoded))[:3]
+                    for match in matches:
+                        snippet = decoded[max(0, match.start()-80):min(len(decoded), match.end()+150)]
+                        key_fact(ref, '请求中存在需核对的 SQL 可疑片段：' + snippet, priority=True)
+                    if matches and 'SQL 可疑片段只证明请求含相关语句，不能单独证明利用成功或误报。' not in story['boundaries']:
+                        story['boundaries'].append('SQL 可疑片段只证明请求含相关语句，不能单独证明利用成功或误报。')
+                if canonical == 'responseHead':
+                    status = re.search(r'HTTP/\d(?:\.\d)?\s+(\d{3})\b', content)
+                    if status:
+                        key_fact(ref, f'响应 HTTP {status[1]}；状态码本身不证明攻击成功或安全。')
+            # Keep source threat/status facts without turning raw values into a
+            # new decision, and omit repetitive empty entity counts from mail.
+            statuses = [f'{key}={_text(row[key], 240)}' for key in
+                        ('gptResult', 'threatLevel', 'edrDealStatusInfo', 'ndrDealStatusInfo')
+                        if row.get(key) is not None and row[key] != '']
+            if statuses:
+                key_fact(ref, source + '；' + '；'.join(statuses))
+        if len(story['key_evidence']) == before:
+            story['other_queries'].append(f'{ref} · {source}（{kind}）：已查，未取得值得展开的新增事实；不据此排除风险。')
+    for (ref, alert_id), group in packet_groups.items():
+        if not group['web']:
+            continue
+        if not group['fields'].intersection({'requestHead', 'requestBody'}):
+            gap(f'{ref} · 告警 {alert_id}：未取得请求包，不能确认请求是否实际包含攻击语句')
+        if not group['fields'].intersection({'responseHead', 'responseBody'}):
+            gap(f'{ref} · 告警 {alert_id}：未取得响应包，不能核对服务端响应及利用效果')
+    story['timeline'].sort(key=lambda entry: _when(entry['time']))
+    if not story['timeline']:
+        gap('来源未提供可用的事件发生时间；查询取得时间未代替事件时间，暂无法还原完整时间线')
+    is_web = bool(story['packets']) or any(term in str(event.get('name', '')).lower() for term in ('sql', 'web', 'http', '注入', '跨站', '目录遍历'))
+    if is_web:
+        fields = {packet['field'] for packet in story['packets']}
+        if not fields.intersection({'requestHead', 'requestBody'}):
+            gap('未取得请求包，不能确认请求是否实际包含攻击语句')
+        if not fields.intersection({'responseHead', 'responseBody'}):
+            gap('未取得响应包，不能核对服务端响应及利用效果')
+        request_packets = [packet for packet in story['packets'] if packet['field'].startswith('request')]
+        if request_packets and not any(_SQL.search(unquote(packet['text'])) for packet in request_packets):
+            story['boundaries'].append('已检查现有请求片段，未命中本地 SQL 可疑模式；该模式检查不覆盖所有攻击，也不能单独据此认定误报。')
+        story['boundaries'].append('没有发现匹配片段不等于误报；HTTP 200、XDR attackState 与 attackResult 各自含义不同，利用结果须结合原始证据判断。')
+    for item in result.get('gaps', [])[:12] if isinstance(result.get('gaps'), list) else []:
+        gap(item)
+    refs = {str(p.get('id')) for p in evidence if isinstance(p, dict) and p.get('success')}
+    requested = result.get('evidence_ids', [])
+    if isinstance(requested, list) and any(str(ref) not in refs for ref in requested):
+        gap('调查结论引用了未取得成功结果的证据；该结论需继续核对')
+    story['evidence_ids'] = [str(ref) for ref in requested if str(ref) in refs] if isinstance(requested, list) else []
+    from .evidence_presenter import bound_evidence, evidence_cards
+    from .correlation import correlation_results
+    story['evidence_cards'] = evidence_cards(event, evidence, canonical=canonical)
+    story['correlation_results'] = correlation_results(event, evidence, canonical=canonical,
+        plan=result.get('correlation_plan'), cards=story['evidence_cards'])
+    bound = {id(proof) for proof in bound_evidence(event, evidence, canonical=canonical)}
+    story.update(timeline_projection(story, other_events=[entry for proof, entry in other_events if id(proof) in bound]))
