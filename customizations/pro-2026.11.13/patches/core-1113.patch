+
+@router.get("/{category}/history")
+async def history(request: Request, category: str):
+    user = await _active_user(request)
+    try:
+        return await asyncio.to_thread(engine.list_history, user, category)
+    except (ValueError, OSError) as error:
+        raise _read_failure(error) from error
+
+
+@router.get("/{category}")
+async def experience(request: Request, category: str, version: str | None = None):
+    user = await _active_user(request)
+    try:
+        scope = await asyncio.to_thread(engine.scope_key, user)
+        result = await asyncio.to_thread(engine.read_experience, user, category, version=version)
+    except (ValueError, OSError) as error:
+        raise _read_failure(error) from error
+    if not version and _daily_locked(result):
+        return result
+    run = _runs.get(user.id)
+    if not version and run and _scopes.get(user.id) == scope and (run[1] is None or run[1] == category):
+        if not run[0].done():
+            result = {**result, "status": "running"}
+        elif run[1] == category and user.id in _errors and result.get("status") != "running":
+            message, publication = _errors[user.id]
+            if publication == _publication(result):
+                result = {**result, "status": "failed", "error": message}
+            else:
+                _errors.pop(user.id, None)
+    return result
