+# Used to represent DATE_TRUNC in Doris, Postgres and Starrocks dialects
+def build_timestamp_trunc(args: t.List) -> exp.TimestampTrunc:
+    return exp.TimestampTrunc(this=seq_get(args, 1), unit=seq_get(args, 0))
