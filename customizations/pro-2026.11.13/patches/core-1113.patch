+    async def test_reused_worker_does_not_retain_another_callers_identity(self):
+        from concurrent.futures import ThreadPoolExecutor
+        from flocks.auth.context import get_current_auth_user, reset_current_auth_user, set_current_auth_user
+        from flocks.workflow.models import Workflow
+        from flocks.workflow.repl_runtime import PythonExecRuntime
+
+        engine_module = self.native_engine()
+        code = "from flocks.auth.context import get_current_auth_user\nuser = get_current_auth_user()\noutputs = {'caller': user.id if user else None}"
+        definition = {"start": "a", "nodes": [{"id": "a", "type": "python", "code": code}], "edges": []}
+
+        class BorrowedPool:
+            def __init__(self, pool):
+                self.pool = pool
+            def submit(self, *args, **kwargs):
+                return self.pool.submit(*args, **kwargs)
+            def shutdown(self, *args, **kwargs):
+                pass  # Reuse the same native worker for two authenticated callers.
+
+        def current_id():
+            user = get_current_auth_user()
+            return user.id if user else None
+
+        with ThreadPoolExecutor(max_workers=1) as pool:
+            with patch.object(engine_module, "ThreadPoolExecutor", return_value=BorrowedPool(pool)):
+                for user_id in ("first-member", "second-member"):
+                    token = set_current_auth_user(self.owner.model_copy(update={"id": user_id, "role": "member"}))
+                    try:
+                        engine = engine_module.WorkflowEngine(
+                            Workflow.from_dict(definition),
+                            runtime=PythonExecRuntime(tool_registry=SimpleNamespace(cancel_checker=None)),
+                            node_timeout_s=5,
+                        )
+                        result = engine.run(retain_history=True)
+                        self.assertEqual(result.history[0].outputs["caller"], user_id)
+                        self.assertIsNone(pool.submit(current_id).result())
+                    finally:
+                        reset_current_auth_user(token)
+
