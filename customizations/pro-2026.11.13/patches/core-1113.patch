+
+def _markdown(report):
+    label = {"action_required": "待处置", "pending_verification": "待核验", "completed": "输入证据满足闭环检查", "no_rule_hits": "未见本轮规则命中"}
+    quote = lambda text: re.sub(r"([\\`*_{}\[\]()#+!|<>])", r"\\\1", _safe(text, 800))
+    lines = ["# " + report["title"], "", "- 评估时点：" + report["evaluation_time"], "- 数据来源：" + report["metadata"]["data_origin"], "- 分析完成 ≠ 业务处置完成；本轮结论：" + label[report["business_status"]], "- 有效记录：" + str(report["quality"]["valid_count"]) + "；无效记录：" + str(report["quality"]["invalid_count"]), "- 通知展示收件人：" + quote(report["notification"]["recipient_display"]) + "（未发送）", "", "## 运营概况", "- 待核验发现：" + str(report["overview"]["active_finding_count"]) + "；输入证据已验证恢复：" + str(report["overview"]["verified_recovery_count"]), "- 有良性依据的抑制记录：" + str(report["suppressed_count"])]
+    if "task_status_counts" in report["overview"]:
+        lines += ["- 任务状态分布：" + quote(json.dumps(report["overview"]["task_status_counts"], ensure_ascii=False)), "- 超期任务：" + str(report["overview"]["overdue_count"]) + "；满足闭环证据检查：" + str(report["overview"]["verified_closed_count"])]
+    lines += ["", "## 发现与证据"]
+    for finding in report["findings"]:
+        lines += ["", "### " + quote(finding["title"]), "- 状态：" + finding["status"] + "；级别：" + finding["severity"], "- 证据行号：" + ", ".join(finding["evidence_ids"]), "- 指标：" + quote(json.dumps(finding["metrics"], ensure_ascii=False))]
+    if not report["findings"]:
+        lines.append("资料不足，不能作成功闭环结论。" if report["branch"] == "insufficient" else "有效输入中未命中本轮升级规则；不代表不存在其它风险。")
+    lines += ["", "## 后续动作"] + ["- " + quote(item) for item in report["actions"]]
+    lines += ["", "## 使用边界"] + ["- " + quote(item) for item in report["limitations"]]
+    return "\n".join(lines) + "\n"
+
+
+@contextmanager
+def _report_directory(workflow_id):
+    if os.open not in os.supports_dir_fd or not hasattr(os, "O_NOFOLLOW"):
+        raise SuiteError("当前平台不支持安全的目录描述符写入；报告未写入。")
+    # The explicitly configured ~/.flocks deployment alias may be a symlink.
+    # Resolve it once; every output descendant is opened with no-follow dirfds.
+    home = Path.home().resolve(strict=True)
+    alias = home / ".flocks"
+    alias.mkdir(mode=0o700, exist_ok=True)
+    root = alias.resolve(strict=True)
+    fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        parts = ["workspace", "outputs", _now().astimezone().date().isoformat(), "security-operations", workflow_id]
+        for part in parts:
+            try:
+                os.mkdir(part, mode=0o700, dir_fd=fd)
+            except FileExistsError:
+                pass
+            following = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
+            os.close(fd)
+            fd = following
+        yield fd, root.joinpath(*parts)
+    finally:
+        os.close(fd)
+
+
+def _publish(state):
+    # Compile again from structured state; never accept arbitrary supplied paths
+    # or a Markdown body masquerading as an output destination.
+    state = _compile(state)
+    report = state["report"]
+    _json_size(report, MAX_REPORT_BYTES)
+    identifier = _now().strftime("%H%M%S%f") + "-" + uuid.uuid4().hex[:10]
+    contents = {identifier + ".md": state["markdown"].encode(), identifier + ".json": json.dumps(report, ensure_ascii=False, indent=2, allow_nan=False).encode()}
+    written = []
+    try:
+        with _report_directory(state["workflow_id"]) as (directory, path):
+            try:
+                for name, content in contents.items():
+                    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
+                    written.append(name)
+                    with os.fdopen(fd, "wb") as stream:
+                        stream.write(content)
+                        stream.flush()
+                        os.fsync(stream.fileno())
+            except BaseException:
+                for name in written:
+                    os.unlink(name, dir_fd=directory)
+                raise
+            paths = [str(path / name) for name in contents]
+    except OSError as error:
+        raise SuiteError("报告目录不可安全写入，请检查目录权限或符号链接配置。") from error
+    return {"report": report, "markdown": state["markdown"], "output_files": paths}
+
+
+def run_stage(workflow_id, stage, inputs):
+    if workflow_id not in WORKFLOWS:
+        raise SuiteError("工作流ID不受此套件管理。")
+    if stage == "prepare":
+        return {"state": _prepare(workflow_id, inputs)}
+    if not isinstance(inputs, dict) or set(inputs) != {"state"} or not isinstance(inputs.get("state"), dict):
+        raise SuiteError("节点输入状态无效。")
+    state = inputs["state"]
+    _json_size(state, MAX_REPORT_BYTES)
+    if state.get("workflow_id") != workflow_id or state.get("kind") != WORKFLOWS[workflow_id][2]:
+        raise SuiteError("节点状态与工作流不匹配。")
+    try:
+        if stage == "normalize":
+            result = _normalize(state)
+        elif stage == "analyze":
+            result = _analyze(state)
+        elif stage in {"risk", "normal", "insufficient"}:
+            result = _decide(state, stage)
+        elif stage == "compile":
+            result = _compile(state)
+        elif stage == "publish":
+            return _publish(state)
+        else:
+            raise SuiteError("未知工作流阶段。")
+        return {"state": result}
+    except (KeyError, TypeError, IndexError, AttributeError) as error:
+        raise SuiteError("节点状态不完整或字段类型无效。") from error
