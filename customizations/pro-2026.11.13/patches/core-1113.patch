+    assert all(card['raw'] == facts and '上层汇总' in card['boundary'] for card in cards)
+    incomplete = {**facts, 'alerts': facts['alerts'][:1]}
+    partial_cards = evidence_cards(EVENT, [proof(incomplete)])
