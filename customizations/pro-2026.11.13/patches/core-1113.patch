+def _safe(value, maximum=180):
+    text = str(value)
+    text = re.sub(r"(?i)\bBearer\s+\S+", "Bearer [已隐藏]", text)
+    text = re.sub(r"(?i)(?:api[_-]?key|access[_-]?token|refresh[_-]?token|password|passwd|secret|authorization|token|密码|口令|密钥)\s*[:=：]\s*\S+", "[敏感字段已隐藏]", text)
