+async def activate(setup):
+    scheduler = await TaskStore.get_scheduler(setup.scheduler.id)
+    scheduler.status = SchedulerStatus.ACTIVE
+    await TaskStore.update_scheduler(scheduler)
+    return await saved_policy()
