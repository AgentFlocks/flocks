 ) -> Dict[str, Any]:
+    # Forwarders commonly use an ISO timestamp with a BSD TAG rather than a
+    # versioned RFC5424 header. Recognize it even when the listener explicitly
+    # selects rfc3164, or whitespace follows PRI. Never search for arbitrary
+    # JSON: only remove a complete, recognized syslog envelope.
+    iso = _ISO3164_REST_RE.match(rest.strip())
+    if iso:
+        return _parse_iso3164(iso, raw=raw, facility=facility, severity=severity)
     m = _RFC3164_REST_RE.match(rest.strip())
     if m:
         ts = m.group(1)
