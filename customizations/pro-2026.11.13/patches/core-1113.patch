+"""Receive the real suite's JSON input after decoding forwarded ISO syslog."""
+import json
+from pathlib import Path
+
+import pytest
+
+from flocks.ingest.syslog.parser import parse_syslog
+
+
+@pytest.mark.parametrize("hint", ["auto", "rfc3164"])
+@pytest.mark.parametrize("pri", ["<14>", "<14> ", ""])
+def test_installed_receive_definition_gets_one_alert_from_iso_envelope(hint, pri):
+    workflow = Path(__file__).resolve().parents[2] / ".flocks/flockshub/plugins/workflows/stream_alert_denoise/workflow.json"
+    definition = json.loads(workflow.read_text())
+    receive = next(node for node in definition["nodes"] if node["id"] == "receive_alert")
+    alert = {"id": "syslog-iso-fixture", "evidence": "x" * 11600}
+    raw = f"{pri}2026-11-12T19:52:58+08:00 appliance-host /opt/vendor/bin/logsender[1]: " + json.dumps(alert)
+    outputs = {}
+
+    exec(compile(receive["code"], "receive_alert", "exec"),
+         {"inputs": {"syslog_message": parse_syslog(raw, hint)}, "outputs": outputs})
+
+    assert outputs["stats"]["raw_count"] == 1
+    assert outputs["input_mode"] == "syslog"
+    assert outputs["raw_alerts"][0]["id"] == alert["id"]
+    assert outputs["raw_alerts"][0]["evidence"] == alert["evidence"]
+    assert outputs["raw_alerts"][0]["_syslog_meta"]["hostname"] == "appliance-host"
