+    render(<TaskIncidentPreview onClose={() => {}} />);
+    const notification = screen.getByRole('button', { name: /个人邮箱/ });
+    expect(notification).toHaveTextContent(config.emailDisplay);
+    expect(notification).not.toHaveTextContent('li***@example.com');
+    fireEvent.click(notification);
+    expect(notification).toHaveTextContent(config.emailDisplay);
+  });
+
+  it('generates recovery between 40 and 120 minutes after failure with chronological nodes', () => {
+    const failedAt = Date.parse('2026-08-26T10:32:35Z');
+    expect(createDemoRecoveryTiming(failedAt, () => 0).minutes).toBe(40);
+    expect(createDemoRecoveryTiming(failedAt, () => 0.999999).minutes).toBe(120);
+    for (let sample = 0; sample < 1000; sample += 1) {
+      const result = createDemoRecoveryTiming(failedAt, () => sample / 1000);
+      expect(result.recoveredAt - failedAt).toBeGreaterThanOrEqual(40 * 60_000);
+      expect(result.recoveredAt - failedAt).toBeLessThanOrEqual(120 * 60_000);
+      expect(result.startedAt).toBeGreaterThan(failedAt);
+      expect(result.startedAt).toBeLessThan(result.recoveredAt);
+    }
+  });
