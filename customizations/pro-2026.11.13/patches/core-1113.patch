+                    Workflow.from_dict(definition),
+                    runtime=PythonExecRuntime(tool_registry=SimpleNamespace(cancel_checker=None)),
+                    node_timeout_s=5,
+                    max_parallel_workers=2,
+                )
+                token = set_current_auth_user(member)
+                identities.clear()
+                try:
+                    with patch.dict(sys.modules, {
+                        core.__name__: core,
+                        "flocks.server.routes.knowledge_experience_runtime": self.runtime,
+                    }), patch.object(self.runtime, "_active_owner", AsyncMock(return_value=member)), patch(
+                        "flocks.workflow.repl_runtime.get_lazy_llm", return_value=model,
+                    ):
+                        result = engine.run(retain_history=True)
