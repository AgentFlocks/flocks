+function errorMessage(error: unknown): string {
+  const response = error as { response?: { status?: number; data?: { message?: unknown; detail?: unknown } }; message?: string };
+  // Flocks wraps HTTPException as { error, message }; also support the standard
+  // FastAPI { detail } envelope used by some deployments.
+  const message = [response?.response?.data?.message, response?.response?.data?.detail]
+    .find((value): value is string => typeof value === 'string' && Boolean(value.trim()));
+  if (response?.response?.status === 404 && (!message || message.toLowerCase() === 'not found')) {
+    return '请求的内容或接口不存在，请确认后端已应用补丁并重启，或重新选择内容。';
+  }
+  return message ?? response?.message ?? '';
+}
+
+function accessRejected(error: unknown): boolean {
+  const status = (error as { response?: { status?: number } })?.response?.status;
+  return status === 401 || status === 403;
+}
+
+function dateLabel(value: string | null): string {
+  if (!value) return '—';
+  const date = new Date(value);
+  return Number.isNaN(date.getTime()) ? value : date.toLocaleString();
