+    fireEvent.click(screen.getByRole('button', { name: '查看成功执行（演示）' }));
+    expect(screen.getByText('texec_demo_recovered · completed')).toBeInTheDocument();
+    expect(screen.getByText('11:52:35')).toBeInTheDocument();
+    expect(screen.getByText('演示数据')).toBeInTheDocument();
+  });
+});
