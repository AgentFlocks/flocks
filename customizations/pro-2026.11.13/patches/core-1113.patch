+++ b/tests/monitoring/test_storage_reads.py
@@ -0,0 +1,35 @@
+"""Ready SQLite monitoring reads must coexist with an unrelated writer."""
+import asyncio
+import sqlite3
+import pytest
+from flocks.monitoring import store
+from flocks.task.store import TaskStore
+
+
+@pytest.mark.parametrize('report', [False, True])
+async def test_ready_read_does_not_wait_for_writer_lock(monkeypatch, report):
+    await store.rows('SELECT COUNT(*) AS n FROM monitor_attempts')
+    from flocks.task import diagnostics
+    original = diagnostics.observed_connect
+    monkeypatch.setattr(diagnostics, 'observed_connect', lambda path, **kwargs: original(path, timeout=.1))
+    blocker = sqlite3.connect(TaskStore.get_db_path(), timeout=.1)
+    try:
+        blocker.execute('BEGIN IMMEDIATE')
+        if report:
+            from flocks.monitoring.reports import snapshot
+            result = await asyncio.wait_for(snapshot('owner','host-security-monitor','2026-11-12'), .8)
+            assert result['businessDate'] == '2026-11-12'
+        else:
+            assert await asyncio.wait_for(store.rows('SELECT COUNT(*) AS n FROM monitor_attempts'), .8) == [{'n':0}]
+    finally:
+        blocker.rollback();blocker.close()
+
+
+async def test_schema_change_invalidates_the_read_cache():
+    await store.rows('SELECT COUNT(*) AS n FROM monitor_reports')
+    db=sqlite3.connect(TaskStore.get_db_path())
+    try:
+        db.execute('DROP TABLE monitor_reports');db.commit()
+    finally:
