+"""Knowledge route authentication and filesystem isolation."""
+from __future__ import annotations
+
+import importlib.util
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+ROOT = str(Path(__file__).resolve().parents[2])
+AVAILABLE = bool(ROOT and importlib.util.find_spec("fastapi") and (Path(ROOT) / "flocks/server/routes/knowledge_catalog.py").exists())
+
+
+@unittest.skipUnless(AVAILABLE, "Requires FastAPI")
+class KnowledgeRouteTests(unittest.TestCase):
+    def setUp(self):
+        from fastapi import FastAPI, HTTPException
+        from fastapi.testclient import TestClient
+        from flocks.server.routes import knowledge
+        self.routes = knowledge
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        base = Path(self.temporary.name)
+        self.roots = {}
+        for name in ("alice", "bob"):
+            root = base / name
+            root.mkdir()
+            (root / f"{name}_巡检报告.md").write_text(f"{name} report")
+            (root / ".hidden.md").write_text("hidden")
+            self.roots[name] = root
+        (self.roots["alice"] / "outside.md").symlink_to(self.roots["bob"] / "bob_巡检报告.md")
+        def require_user(request):
+            username = request.headers.get("x-test-user")
+            if username not in self.roots:
+                raise HTTPException(401, "authentication required")
+            return SimpleNamespace(username=username, role="user")
+        self.addCleanup(patch.stopall)
+        patch.object(knowledge, "require_user", side_effect=require_user).start()
+        patch.object(knowledge.WorkspaceManager, "get_instance", return_value=object()).start()
+        patch.object(knowledge, "_output_roots", side_effect=lambda user, _: [knowledge._OutputRoot("personal", "personal", self.roots[user.username])]).start()
+        knowledge.knowledge_catalog._CACHE.clear()
+        app = FastAPI()
+        app.include_router(knowledge.router, prefix="/api/knowledge")
+        self.client = TestClient(app)
+        self.addCleanup(self.client.close)
+
+    def test_catalog_authentication_and_user_isolation(self):
+        for endpoint in ("/catalog", "/catalog/files", "/catalog/context?root=personal&path=x.md", "/output-entry?root=personal&path=x.md"):
+            self.assertEqual(self.client.get("/api/knowledge" + endpoint).status_code, 401)
+        for user in ("alice", "bob", "alice"):
+            response = self.client.get("/api/knowledge/catalog/files", headers={"x-test-user": user})
+            self.assertEqual(response.status_code, 200)
+            self.assertEqual([n["name"] for n in response.json()["items"]], [f"{user}_巡检报告.md"])
+            self.assertEqual(self.client.get("/api/knowledge/catalog", headers={"x-test-user": user}).json()["count"], 1)
+
+    def test_context_and_preview_reject_hidden_escape_symlink_and_other_roots(self):
+        for endpoint in ("catalog/context", "file", "output-entry"):
+            url = "/api/knowledge/" + endpoint
+            for root, path, expected in (("shared", "bob_巡检报告.md", 403), ("personal", "../bob/bob_巡检报告.md", 400),
+                                         ("personal", ".hidden.md", 400), ("personal", "outside.md", 400),
+                                         ("personal", "missing.md", 404)):
+                response = self.client.get(url, params={"source": "outputs", "root": root, "path": path}, headers={"x-test-user": "alice"})
+                self.assertEqual(response.status_code, expected, response.text)
+
+    def test_request_validation_and_existing_text_preview(self):
+        for params in ({"offset": -1}, {"limit": 101}, {"after": "not-a-date"}):
+            response = self.client.get("/api/knowledge/catalog/files", params=params, headers={"x-test-user": "alice"})
+            self.assertEqual(response.status_code, 422)
+        response = self.client.get("/api/knowledge/file", params={"source": "outputs", "root": "personal", "path": "alice_巡检报告.md"}, headers={"x-test-user": "alice"})
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.json()["content"], "alice report")
+
+
+if __name__ == "__main__":
+    unittest.main()
