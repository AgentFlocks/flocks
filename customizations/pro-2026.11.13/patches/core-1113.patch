+import { act, fireEvent, render, screen } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { WorkflowTrigger } from '@/api/workflow';
+import ManagedManualRun from './ManagedManualRun';
+
+const api = vi.hoisted(() => ({ testTrigger: vi.fn() }));
+vi.mock('@/api/workflow', () => ({ workflowAPI: api }));
+
+const ids = ['custom-soc-ndr-egress', 'custom-soc-ndr-dns', 'custom-soc-ndr-lateral', 'custom-soc-ndr-exfil',
+  'custom-soc-device-health', 'custom-soc-alert-fusion', 'custom-soc-closure-report'];
+const trigger: WorkflowTrigger = { id: 'manual-review', type: 'manual', enabled: true };
+const response = (status = 'success', overrides: Record<string, unknown> = {}) => ({ data: {
+  ok: true, matched: true, executed: true, result: { id: 'exec-123', status, duration: 1.234, errorMessage: null }, ...overrides,
+} });
+function deferred() {
+  let resolve!: (value: unknown) => void;
+  let reject!: (error: unknown) => void;
+  const promise = new Promise((yes, no) => { resolve = yes; reject = no; });
+  return { promise, resolve, reject };
+}
+async function open() {
+  await userEvent.click(screen.getByRole('button', { name: '手动运行' }));
+}
+async function run() {
+  await userEvent.click(screen.getByRole('button', { name: '运行一次' }));
+}
+
+describe('ManagedManualRun', () => {
+  beforeEach(() => { api.testTrigger.mockReset(); });
+
+  it.each(ids)('只为受管工作流 %s 显示默认折叠入口', (workflowId) => {
+    render(<ManagedManualRun workflowId={workflowId} trigger={trigger} />);
+    expect(screen.getByRole('button', { name: '手动运行' })).toHaveAttribute('aria-expanded', 'false');
+    expect(screen.queryByRole('textbox')).not.toBeInTheDocument();
+    expect(api.testTrigger).not.toHaveBeenCalled();
+  });
+
+  it.each([
+    { workflowId: 'unrelated', trigger },
+    { workflowId: 'custom-soc-ndr-egress-copy', trigger },
+    { workflowId: ids[0], trigger: { ...trigger, id: 'manual-other' } },
+    { workflowId: ids[0], trigger: { ...trigger, type: 'schedule' as const } },
+  ])('不显示其它工作流或触发器 $workflowId', (props) => {
+    const { container } = render(<ManagedManualRun {...props} />);
+    expect(container).toBeEmptyDOMElement();
+  });
+
+  it('默认参数为对象且折叠不触发运行', async () => {
+    render(<ManagedManualRun workflowId={ids[0]} trigger={trigger} />);
+    await open();
+    expect(screen.getByRole('textbox', { name: '运行参数（JSON）' })).toHaveValue('{}');
+    await open();
+    expect(screen.queryByRole('textbox')).not.toBeInTheDocument();
+    expect(api.testTrigger).not.toHaveBeenCalled();
+  });
+
+  it.each([false, undefined])('停用或未确认启用时禁止运行（%s）', async (enabled) => {
+    render(<ManagedManualRun workflowId={ids[0]} trigger={{ ...trigger, enabled }} />);
+    await open();
+    expect(screen.getByRole('textbox')).toBeDisabled();
+    expect(screen.getByRole('button', { name: '运行一次' })).toBeDisabled();
+    await run();
+    expect(api.testTrigger).not.toHaveBeenCalled();
+  });
+
+  it.each(['bad private text', '[]', 'null', 'true', '1', '{"count":1e999}'])('非法 JSON 对象不发送且不回显解析错误原文：%s', async (input) => {
+    render(<ManagedManualRun workflowId={ids[0]} trigger={trigger} />);
+    await open();
+    fireEvent.change(screen.getByRole('textbox'), { target: { value: input } });
+    await run();
+    expect(screen.getByRole('alert')).toHaveTextContent('请输入有效的 JSON 对象');
+    expect(screen.getByRole('alert')).not.toHaveTextContent('private text');
+    expect(api.testTrigger).not.toHaveBeenCalled();
+  });
+
+  it('UTF-8 超过一百万字节的输入在发送前拒绝', async () => {
+    render(<ManagedManualRun workflowId={ids[0]} trigger={trigger} />);
+    await open();
+    fireEvent.change(screen.getByRole('textbox'), { target: { value: JSON.stringify({ text: '字'.repeat(340_000) }) } });
+    await run();
+    expect(screen.getByRole('alert')).toHaveTextContent('超过 1 MB');
+    expect(api.testTrigger).not.toHaveBeenCalled();
+  });
+
+  it('只将原始解析对象作为 body 发送并依据真实执行状态显示成功', async () => {
+    api.testTrigger.mockResolvedValue(response());
+    render(<ManagedManualRun workflowId={ids[0]} trigger={trigger} />);
+    await open();
+    fireEvent.change(screen.getByRole('textbox'), { target: { value: '{"scenario":"normal","sessions":[]}' } });
+    await run();
+    expect(api.testTrigger).toHaveBeenCalledExactlyOnceWith(ids[0], 'manual-review', { body: { scenario: 'normal', sessions: [] } });
+    expect(screen.getByRole('status')).toHaveTextContent('本次分析执行成功');
+    expect(screen.getByRole('status')).toHaveTextContent('exec-123');
+    expect(screen.getByRole('status')).toHaveTextContent('1.23 秒');
+  });
+
+  it('进行中的请求禁止重复点击且不会编辑参数', async () => {
+    const pending = deferred();
+    api.testTrigger.mockReturnValue(pending.promise);
+    render(<ManagedManualRun workflowId={ids[0]} trigger={trigger} />);
