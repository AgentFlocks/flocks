diff --git a/webui/src/utils/customSocWorkflow.test.tsx b/webui/src/utils/customSocWorkflow.test.tsx
new file mode 100644
index 00000000..24349131
--- /dev/null
+++ b/webui/src/utils/customSocWorkflow.test.tsx
@@ -0,0 +1,85 @@
+import type { ReactNode } from 'react';
+import { fireEvent, render, screen, within } from '@testing-library/react';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { WorkflowSummary } from '@/api/workflow';
+import WorkflowPage from '@/pages/Workflow';
+import { isManagedCustomWorkflowId } from './customSocWorkflow';
+
+const mocks = vi.hoisted(() => ({ useWorkflows: vi.fn(), navigate: vi.fn() }));
+vi.mock('react-router-dom', () => ({ useNavigate: () => mocks.navigate }));
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({ t: (key: string) => key, i18n: { language: 'zh-CN' } }),
+}));
+vi.mock('@/hooks/useWorkflow', () => ({ useWorkflows: () => mocks.useWorkflows() }));
+vi.mock('@/components/common/Toast', () => ({
+  useToast: () => ({ warning: vi.fn() }),
+  useOptionalToast: () => ({ success: vi.fn(), error: vi.fn(), warning: vi.fn(), info: vi.fn() }),
+}));
+vi.mock('@/components/common/PageHeader', () => ({ default: ({ title, action }: { title: string; action?: ReactNode }) => <header>{title}{action}</header> }));
+vi.mock('@/components/common/LoadingSpinner', () => ({ default: () => <div>loading</div> }));
+vi.mock('@/components/common/EmptyState', () => ({ default: ({ title }: { title: string }) => <div>{title}</div> }));
+
+const ids = [
+  'custom-soc-ndr-egress', 'custom-soc-ndr-dns', 'custom-soc-ndr-lateral',
+  'custom-soc-ndr-exfil', 'custom-soc-device-health', 'custom-soc-alert-fusion',
+  'custom-soc-closure-report',
+];
+
+function workflow(id: string, source: 'project' | 'global' = 'project'): WorkflowSummary {
+  return {
+    id, name: id, source, category: 'security-operations', status: 'draft',
+    createdAt: 0, updatedAt: 0, nodeCount: 9,
+    stats: { callCount: 0, successCount: 0, errorCount: 0, avgRuntime: 0, totalRuntime: 0, thumbsUp: 0, thumbsDown: 0 },
+    integrationStatus: {
+      api: { configured: false, state: 'unconfigured' },
+      trigger: { configured: true, state: 'running', count: 1, items: [
+        { id: 'manual-run', type: 'manual', state: 'running' },
+      ] },
+    },
+  };
+}
+
+describe('managed custom workflow grouping', () => {
+  beforeEach(() => vi.clearAllMocks());
+
+  it('recognizes exactly the seven suite IDs, not arbitrary prefixes or coerced values', () => {
+    for (const id of ids) expect(isManagedCustomWorkflowId(id)).toBe(true);
+    for (const value of [null, undefined, 1, {}, 'custom-soc-other', 'custom-soc-ndr-egress-copy', ' custom-soc-ndr-egress']) {
+      expect(isManagedCustomWorkflowId(value)).toBe(false);
+    }
+  });
+
+  it('puts all seven project-installed workflows in the custom source section and supports native group filters without changing storage source', () => {
+    const managed = [...ids.map(id => workflow(id)), workflow('existing-global', 'global')]
+      .map(item => ({ ...item, group: 'SOC managed' }));
+    const builtinWorkflows = [workflow('existing-builtin'), workflow('custom-soc-other')]
+      .map(item => ({ ...item, group: 'SOC builtin' }));
+    const workflows = [...managed, ...builtinWorkflows];
+    const original = JSON.stringify(workflows);
+    mocks.useWorkflows.mockReturnValue({ workflows, loading: false, error: null, refetch: vi.fn() });
+    render(<WorkflowPage />);
+    const custom = within(screen.getByRole('region', { name: 'section.custom' }));
+    const builtin = within(screen.getByRole('region', { name: 'section.builtin' }));
+    for (const id of ids) {
+      expect(custom.getByText(id)).toBeInTheDocument();
+      expect(builtin.queryByText(id)).not.toBeInTheDocument();
+    }
+    expect(custom.getByText('existing-global')).toBeInTheDocument();
+    expect(custom.getAllByText('badge.custom')).toHaveLength(8);
+    expect(custom.getAllByLabelText('integration.triggerType.manual：integration.state.enabled')).toHaveLength(8);
