+from __future__ import annotations
+
+import importlib.util
+import os
+import sqlite3
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+ROOT = str(Path(__file__).resolve().parents[2])
+AVAILABLE = bool(ROOT and importlib.util.find_spec("fastapi"))
+
+
+@unittest.skipUnless(AVAILABLE, "Requires FastAPI")
+class HomeUsageTests(unittest.TestCase):
+    def setUp(self):
+        from fastapi import FastAPI
+        from fastapi.testclient import TestClient
+        path = Path(__file__).resolve().parents[2] / "flocks/server/routes/home_usage.py"
+        spec = importlib.util.spec_from_file_location("home_usage_test", path)
+        self.module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(self.module)
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.db = Path(self.temporary.name) / "usage.db"
+        with sqlite3.connect(self.db) as conn:
+            conn.execute("CREATE TABLE usage_records(created_at TEXT, total_tokens INTEGER)")
+            conn.execute("CREATE INDEX idx_usage_time ON usage_records(created_at)")
+            conn.executemany("INSERT INTO usage_records VALUES (?, ?)", [
+                ("2026-09-10T15:59:59+00:00", 1000),
+                ("2026-09-10T16:00:00+00:00", 10),
+                ("2026-09-11T15:59:59.123456+00:00", 20),
+                ("2026-09-11T16:00:00+00:00", 5000),
+            ])
+        app = FastAPI()
+        app.include_router(self.module.router)
+        self.client = TestClient(app)
+        self.addCleanup(self.client.close)
+        self.addCleanup(patch.stopall)
+        patch.object(self.module.Storage, "get_db_path", return_value=self.db).start()
+        self.start = "2026-09-10T16:00:00+00:00"
+        self.end = "2026-09-11T16:00:00+00:00"
+
+    def test_one_day_boundaries_cache_and_read_only_database(self):
+        before = self.db.read_bytes()
+        value = self.module.read_total(self.db, self.start, self.end)
+        self.assertEqual(value["total_tokens"], 30)
+        with patch.object(self.module.sqlite3, "connect", side_effect=AssertionError("cache miss")):
+            self.assertEqual(self.module.read_total(self.db, self.start, self.end), value)
+        self.assertEqual(self.db.read_bytes(), before)
+        self.assertEqual(self.module.read_total(self.db, self.end, "2026-09-12T16:00:00+00:00")["total_tokens"], 5000)
+
+    def test_wal_writes_invalidate_cached_totals(self):
+        with sqlite3.connect(self.db) as writer:
+            writer.execute("PRAGMA journal_mode=WAL")
+            self.assertEqual(self.module.read_total(self.db, self.start, self.end)["total_tokens"], 30)
+            writer.execute("INSERT INTO usage_records VALUES (?, ?)", (self.start, 7))
+            writer.commit()
+            self.assertEqual(self.module.read_total(self.db, self.start, self.end)["total_tokens"], 37)
+
+    def test_authentication_validation_and_database_errors(self):
+        from fastapi import HTTPException
+        params = {"start_date": self.start, "end_date": self.end}
+        with patch.object(self.module, "require_user", side_effect=HTTPException(401, "login required")):
+            self.assertEqual(self.client.get('/today-token', params=params).status_code, 401)
+        with patch.object(self.module, "require_user", return_value=object()):
+            response = self.client.get('/today-token', params=params)
+            self.assertEqual(response.json()["total_tokens"], 30)
+            self.assertEqual(self.client.get('/today-token', params={**params, "end_date": "2027-01-01T00:00:00Z"}).status_code, 422)
+            with patch.object(self.module, "read_total", side_effect=sqlite3.OperationalError("database is locked")):
+                response = self.client.get('/today-token', params=params)
+                self.assertEqual(response.status_code, 503)
+                self.assertNotIn("total_tokens", response.json())
+
+    def test_timezone_offsets_and_dst_length_are_accepted(self):
+        self.assertEqual(self.module.utc_range("2026-09-11T00:00:00+08:00", "2026-09-12T00:00:00+08:00"), (self.start, self.end))
+        first, last = self.module.utc_range("2026-11-01T00:00:00-04:00", "2026-11-02T00:00:00-05:00")
+        self.assertEqual(first, "2026-11-01T04:00:00+00:00")
+        self.assertEqual(last, "2026-11-02T05:00:00+00:00")
+
+    def test_missing_database_reports_no_records_without_creating_a_database(self):
+        absent = self.db.with_name("not-created.db")
+        self.assertEqual(self.module.read_total(absent, self.start, self.end)["total_tokens"], 0)
+        self.assertFalse(absent.exists())
+
+
+if __name__ == '__main__':
+    unittest.main()
