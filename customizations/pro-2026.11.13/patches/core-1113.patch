+async def test_real_taskstore_contention_reports_admission_and_application_health(tmp_path, captured):
+    from flocks.task.models import TaskScheduler
+    scheduler = TaskScheduler(title='SECRET_SCHEDULER')
+    await TaskStore.create_scheduler(scheduler)
+    native = await TaskStore.raw_db()
+    await native.execute('PRAGMA busy_timeout=10')
+    with closing(sqlite3.connect(TaskStore.get_db_path())) as writer:
+        writer.execute('BEGIN IMMEDIATE')
+        writer.execute('UPDATE task_schedulers SET title=? WHERE id=?', ('SECRET_NEW', scheduler.id))
+        with pytest.raises(sqlite3.OperationalError):
+            await TaskStore.update_scheduler(scheduler)
+        failure = next(row for row in captured if row['event'] == 'db.operation' and row.get('sql_verb') == 'BEGIN' and row.get('db_error') == 'busy')
+        assert 'store.py:_run_write_transaction:' in failure['code_location']
+        assert TaskStore.health_snapshot()['operation'] == 'update_scheduler'
+        assert TaskStore.health_snapshot()['sqlite_error_code'] == sqlite3.SQLITE_BUSY
+        assert failure['connection'] == native._info['connection']
+        assert failure.get('transaction_origin') is None and not failure['transaction_open']
+        assert 'SECRET' not in json.dumps(captured)
+        writer.rollback()
+    await native.rollback()
