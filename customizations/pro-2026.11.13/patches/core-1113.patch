+@pytest.mark.parametrize('basis,wording', [('source_status', '已被 XDR 关闭'), ('not_returned', '本轮查询未再返回')])
+def test_source_closed_summary_reports_prior_findings_and_unresolved_impact(basis, wording):
+    event, case = example()
+    valid = bound_evidence(event, case['evidence'], canonical=case['event'])
+    story = build_story(event, valid, case['result'], canonical=case['event'])
+    assessment = {'verdict': 'unknown', 'ended': True, 'source_closed': True, 'source_closure_basis': basis}
+    result = operator_overview(event, case, assessment, story, valid)
+    assert wording in result['summary']
+    assert '命令注入攻击' in result['summary'] and '尚未确认实际影响' in result['summary']
+    assert '保留此前证据与研判记录' not in result['summary']
