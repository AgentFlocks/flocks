+import { describe, expect, it } from 'vitest';
+import type { TaskExecution } from '@/api/task';
+import { monitorFailureMessage } from './monitorTaskFailure';
+
+const task = { executionInputSnapshot: { context: { monitoring: {} } } } as TaskExecution;
+const event = '设备「10.26.21.101【四季青XDR】」· 主机存在Apache HTTP Server安全漏洞攻击';
+const timeout = '调查模型请求超时（单次最多等待 90 秒）';
+const reason = `${timeout}，已有证据保留；本轮不再请求同一模型，后续轮次按退避计划重试`;
+export const roundError = `本轮失败：本轮查询返回 1 条，确认风险 0 条，无风险 0 条，待判定 1 条。
+待跟进事项：${event}：智能体调查未完成：${reason}。已有证据和待办保留，不据此判定无风险。
+智能体调查：${event}（ID：incident-example） · 系统故障，调查尚未恢复。调查模型请求：${reason}已保存恢复计划；不早于 2026-11-12T03:13:14.242558+00:00 再次尝试。
+历史与当前未完成调查：待续查 0 条，系统故障 1 条。
+状态跟进：本轮核验前轮意图 0 条。
+邮件跟进未启用，本轮不发送责任人邮件。`;
+
+describe('monitorFailureMessage', () => {
+  it('从真实格式中提取设备、事件和模型超时，排除重复原因、统计和恢复长文', () => {
+    expect(monitorFailureMessage(task, roundError)).toBe(`${event}：${timeout}`);
+  });
+
+  it('不把历史 system_wait 或待人工核对当作本轮阻断', () => {
+    const error = `本轮失败：查询失败\n待跟进事项：XDR 查询认证失败（HTTP 401）。已有证据和待办保留，不据此判定无风险。\n智能体调查：旧事件 · 系统故障，调查尚未恢复。旧模型超时\n历史与当前未完成调查：业务待人工核对 1 条。`;
+    expect(monitorFailureMessage(task, error)).toBe('XDR 查询认证失败（HTTP 401）');
+  });
+
+  it('保留超过五个事件的所有阻断及其他接口错误', () => {
+    const errors = Array.from({ length: 7 }, (_, i) => `设备「XDR-${i}」· 事件-${i}：智能体调查未完成：模型访问被拒绝（HTTP 403），已有证据保留`);
+    const error = `本轮失败：7 条\n待跟进事项：${errors.join('；')}；查询 TDP 失败：连接拒绝；异常类型：ConnectionError。已有证据和待办保留，不据此判定无风险。`;
+    const message = monitorFailureMessage(task, error);
+    for (let i = 0; i < 7; i++) expect(message).toContain(`设备「XDR-${i}」· 事件-${i}`);
+    expect(message).toContain('HTTP 403');
+    expect(message).toContain('查询 TDP 失败：连接拒绝');
+    expect(message).toContain('异常类型：ConnectionError');
+    expect(message).not.toContain('已有证据保留');
+  });
+
+  it('保留未知错误格式和普通任务原文，不凭任务标题猜测监测任务', () => {
