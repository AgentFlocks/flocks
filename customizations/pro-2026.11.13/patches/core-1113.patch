new file mode 100644
index 00000000..a432f296
--- /dev/null
+++ b/webui/src/pages/Model/useProviderUsage.ts
@@ -0,0 +1,77 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { usageAPI } from '@/api/provider';
+import type { UsageStats } from '@/types';
+
+const snapshots = new Map<string, UsageStats>();
+const inFlight = new Map<string, Promise<UsageStats>>();
+const PREFIX = 'flocks-provider-usage-v1:';
+function read(key: string): UsageStats | null {
+  if (snapshots.has(key)) return snapshots.get(key)!;
+  try {
+    const value = JSON.parse(sessionStorage.getItem(PREFIX + key) ?? 'null');
+    if (value && Number.isFinite(value.summary?.total_tokens)
+      && Array.isArray(value.by_provider) && Array.isArray(value.by_model) && Array.isArray(value.daily)) {
+      snapshots.set(key, value); return value;
+    }
+  } catch { /* A restricted or full browser store must not block usage. */ }
+  return null;
+}
+function request(key: string, providerId: string): Promise<UsageStats> {
+  const existing = inFlight.get(key);
+  if (existing) return existing;
+  const pending = (async () => {
+    try {
+      const { data } = await usageAPI.getSummary({ provider_id: providerId });
+      if (data) {
+        snapshots.set(key, data);
+        try { sessionStorage.setItem(PREFIX + key, JSON.stringify(data)); } catch { /* Keep memory cache. */ }
+      }
+      return data;
+    } finally { inFlight.delete(key); }
+  })();
+  inFlight.set(key, pending);
+  return pending;
+}
+
+// Keep only one outstanding request per account/provider. In particular a slow
+// response must not be invalidated by a timer firing before that response.
+export function useProviderUsage(providerId: string | undefined, account: string) {
+  const key = JSON.stringify([account, providerId]);
+  const cached = useMemo(() => read(key), [key]);
+  const [state, setState] = useState<{ key: string; data: UsageStats | null; loading: boolean; error: boolean }>(
+    { key, data: cached, loading: Boolean(providerId), error: false },
+  );
+  const refreshRef = useRef<() => Promise<void>>(async () => {});
+  useEffect(() => {
+    let active = true;
+    let busy = false;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const refresh = async () => {
+      if (!active || !providerId || busy) return;
+      busy = true;
+      clearTimeout(timer);
+      setState({ key, data: read(key), loading: true, error: false });
+      try {
+        const data = await request(key, providerId);
+        if (active) setState({ key, data, loading: false, error: false });
+      } catch {
+        if (active) setState({ key, data: read(key), loading: false, error: true });
+      } finally {
+        busy = false;
+        if (active) timer = setTimeout(() => void refresh(), 5000);
+      }
+    };
+    refreshRef.current = refresh;
+    void refresh();
+    return () => { active = false; clearTimeout(timer); };
+  }, [key, providerId]);
+  const refresh = useCallback(() => refreshRef.current(), []);
+  return {
+    data: state.key === key ? state.data : cached,
+    loading: state.key === key ? state.loading : Boolean(providerId),
+    error: state.key === key ? state.error : false,
+    refresh,
+  };
+}
+
+export function __resetProviderUsageForTesting() { snapshots.clear(); inFlight.clear(); }
