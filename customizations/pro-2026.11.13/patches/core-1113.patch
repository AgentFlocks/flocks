+{
+  "name": "多源告警关联降噪与分级研判",
+  "description": "按资产、特征和15分钟窗口关联；有明确良性依据的低中危告警才抑制，多源印证或高危进入升级队列。",
+  "start": "接收多源告警批次",
+  "nodes": [
+    {
+      "id": "接收多源告警批次",
+      "type": "python",
+      "description": "验证初始参数，区分内置合成样本与用户显式数据；读取通知展示配置，不发送邮件。",
+      "code": "from flocks.workflow.custom_soc_suite import run_stage\noutputs = run_stage('custom-soc-alert-fusion', 'prepare', inputs)"
+    },
+    {
+      "id": "校验规则严重度与时间",
+      "type": "python",
+      "description": "校验字段与时间，隔离无效记录和无关敏感字段。",
+      "code": "from flocks.workflow.custom_soc_suite import run_stage\noutputs = run_stage('custom-soc-alert-fusion', 'normalize', inputs)"
+    },
+    {
+      "id": "关联同资产同特征告警",
+      "type": "python",
+      "description": "高危/严重告警或≥2个不同来源同特征印证触发升级；单源未知告警仍保留人工研判，不作无依据降噪。",
+      "code": "from flocks.workflow.custom_soc_suite import run_stage\noutputs = run_stage('custom-soc-alert-fusion', 'analyze', inputs)"
+    },
+    {
+      "id": "分级处置决策",
+      "type": "branch",
+      "select_key": "state.decision",
+      "description": "按risk、normal、insufficient选择唯一路径；数据不足不得判断成功闭环。"
+    },
+    {
+      "id": "风险研判与待办",
+      "type": "python",
+      "description": "记录风险、证据行号和人工核验待办，不实施自动处置。",
+      "code": "from flocks.workflow.custom_soc_suite import run_stage\noutputs = run_stage('custom-soc-alert-fusion', 'risk', inputs)"
+    },
+    {
+      "id": "正常结果与观察",
+      "type": "python",
+      "description": "保留规则分析结果与已验证的输入证据，不泛化为安全保证。",
+      "code": "from flocks.workflow.custom_soc_suite import run_stage\noutputs = run_stage('custom-soc-alert-fusion', 'normal', inputs)"
+    },
+    {
+      "id": "资料缺口与核验",
+      "type": "python",
+      "description": "明确缺失资料或无效字段，输出待核验，不编造成功。",
+      "code": "from flocks.workflow.custom_soc_suite import run_stage\noutputs = run_stage('custom-soc-alert-fusion', 'insufficient', inputs)"
+    },
+    {
+      "id": "编制分析报告",
+      "type": "python",
+      "description": "编制中文Markdown和结构化JSON，标注数据来源、限制和通知未发送状态。",
+      "code": "from flocks.workflow.custom_soc_suite import run_stage\noutputs = run_stage('custom-soc-alert-fusion', 'compile', inputs)"
+    },
+    {
+      "id": "保存日报与证据索引",
+      "type": "python",
+      "description": "执行时动态取日期，只写固定用户输出目录；原始凭证、域名和完整数据不落盘。",
+      "code": "from flocks.workflow.custom_soc_suite import run_stage\noutputs = run_stage('custom-soc-alert-fusion', 'publish', inputs)"
+    }
+  ],
+  "edges": [
+    {
+      "from": "接收多源告警批次",
+      "to": "校验规则严重度与时间",
+      "mapping": {
+        "state": "state"
+      }
+    },
+    {
+      "from": "校验规则严重度与时间",
+      "to": "关联同资产同特征告警",
+      "mapping": {
+        "state": "state"
+      }
+    },
+    {
+      "from": "关联同资产同特征告警",
+      "to": "分级处置决策",
+      "mapping": {
+        "state": "state"
+      }
+    },
+    {
+      "from": "分级处置决策",
+      "to": "风险研判与待办",
+      "mapping": {
+        "state": "state"
+      },
+      "label": "risk",
+      "order": 0
+    },
+    {
+      "from": "分级处置决策",
+      "to": "正常结果与观察",
+      "mapping": {
+        "state": "state"
+      },
+      "label": "normal",
+      "order": 1
+    },
+    {
+      "from": "分级处置决策",
+      "to": "资料缺口与核验",
+      "mapping": {
+        "state": "state"
+      },
+      "label": "insufficient",
+      "order": 2
+    },
+    {
+      "from": "风险研判与待办",
+      "to": "编制分析报告",
+      "mapping": {
+        "state": "state"
+      }
+    },
+    {
+      "from": "正常结果与观察",
+      "to": "编制分析报告",
+      "mapping": {
+        "state": "state"
+      }
+    },
+    {
+      "from": "资料缺口与核验",
+      "to": "编制分析报告",
+      "mapping": {
+        "state": "state"
+      }
+    },
+    {
+      "from": "编制分析报告",
+      "to": "保存日报与证据索引",
+      "mapping": {
+        "state": "state"
+      }
+    }
+  ],
+  "triggers": [
+    {
+      "id": "manual-review",
+      "name": "手动研判",
+      "type": "manual",
+      "enabled": true,
+      "description": "手动提交输入进行研判；不创建定时任务、不开放Webhook。",
+      "source": {},
+      "mapping": {
+        "suite_inputs": "body"
+      },
+      "inputs": {},
+      "concurrency": {
+        "policy": "no_overlap",
+        "maxParallel": 1,
+        "queueSize": 1
+      },
+      "testSamples": [
+        {
+          "name": "风险分支",
+          "payload": {}
+        },
+        {
+          "name": "正常分支",
+          "payload": {
+            "scenario": "normal"
+          }
+        },
+        {
+          "name": "资料不足分支",
+          "payload": {
+            "scenario": "insufficient"
+          }
+        }
+      ]
+    }
+  ],
+  "metadata": {
+    "customization": "custom-soc-suite",
+    "workflowId": "custom-soc-alert-fusion",
+    "schemaVersion": 1,
+    "dataMode": "sample-or-user-provided",
+    "sideEffects": "local-reports-only",
+    "category": "security-operations",
+    "defaultScenario": "risk"
+  }
+}
