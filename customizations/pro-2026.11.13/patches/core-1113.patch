+class _ModelFailure(ExperienceError):
+    """Only fixed public messages leave the model adapter boundary."""
+
+    def __init__(self, code: str):
+        self.code = code if code in _MODEL_FAILURES else "model_unknown"
+        message, self.retryable = _MODEL_FAILURES[self.code]
+        super().__init__(message)
+
+
+def _classify_model_failure(error: Exception) -> _ModelFailure:
+    """Inspect structured SDK fields first; never echo provider text or prompts.
+
+    Older Flocks LLMClient flattens SDK exceptions into a known ValueError
+    message without preserving their cause. Recognize only its exact wrapper
+    prefix and explicit exception-class markers, not arbitrary response text.
+    """
+    class_codes = {
+        "AuthenticationError": "model_auth", "PermissionDeniedError": "model_auth",
+        "RateLimitError": "model_rate_limit", "InternalServerError": "model_unavailable",
+        "APITimeoutError": "model_timeout", "TimeoutError": "model_timeout",
+        "ReadTimeout": "model_timeout", "ConnectTimeout": "model_timeout", "PoolTimeout": "model_timeout",
+        "APIConnectionError": "model_connection", "ConnectionError": "model_connection",
+        "ConnectError": "model_connection", "ReadError": "model_connection", "WriteError": "model_connection",
+        "BadRequestError": "model_request_invalid", "NotFoundError": "model_request_invalid",
+        "UnprocessableEntityError": "model_request_invalid",
+        "LLMResponseSafetyError": "model_safety", "LLMResponseTooLargeError": "model_safety",
+        "LLMResponseUnsupportedEncodingError": "model_safety", "RunCancelledError": "model_cancelled",
+    }
+    seen = set()
+    current: BaseException | None = error
+    for _ in range(5):
+        if current is None or id(current) in seen:
+            break
+        seen.add(id(current))
+        try:
+            status = getattr(current, "status_code", None)
+            if status is None:
+                status = getattr(getattr(current, "response", None), "status_code", None)
+        except Exception:
+            status = None
+        if type(status) is int:
+            if status in {401, 403}:
+                return _ModelFailure("model_auth")
+            if status == 429:
+                return _ModelFailure("model_rate_limit")
+            if status in {500, 502, 503, 504}:
+                return _ModelFailure("model_unavailable")
+            if 400 <= status < 600:
+                return _ModelFailure("model_request_invalid")
+        for cls in type(current).__mro__:
+            if cls.__name__ in class_codes:
+                return _ModelFailure(class_codes[cls.__name__])
+        if type(current) is ValueError:
+            text = str(current)[:4096]
+            if text.startswith(("Workflow 默认模型不可用。", "Workflow 显式指定模型不可用，且回退到全局默认模型也失败。")):
+                # A type marker must follow the native target separator.
+                match = re.search(r": (" + "|".join(class_codes) + r"): ", text)
+                if match:
+                    return _ModelFailure(class_codes[match.group(1)])
+            elif text.startswith("Workflow LLM 未配置可用模型。"):
+                return _ModelFailure("model_not_configured")
+        current = current.__cause__ or current.__context__
+    return _ModelFailure("model_unknown")
+
