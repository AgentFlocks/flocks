+            if _is_binary(string_arg) or _is_binary(fill_arg):
+                length_arg = expression.expression
+                is_left = expression.args.get("is_left")
+
+                input_len = exp.ByteLength(this=string_arg)
+                chars_needed = length_arg - input_len
