+            if configured.get("schemaVersion") != 1:
+                raise ValueError("schema")
+            for key, minimum, maximum in (("maxFileBytes", 1024, 2 * 1024 * 1024),
+                                          ("maxInputChars", 16000, 128000),
+                                          ("maxOutputChars", 1000, 32000),
+                                          ("maxModelCalls", 1, 10000),
+                                          ("modelTimeoutSeconds", 1, 600),
+                                          ("initialSampleSize", 5, 10), ("dailySampleSize", 5, 10),
+                                          ("excerptChars", 300, 3000), ("previousSummaryChars", 500, 6000),
+                                          ("fastModelTimeoutSeconds", 5, 60)):
+                if key in configured:
+                    if type(configured[key]) is not int or not minimum <= configured[key] <= maximum:
+                        raise ValueError(key)
+                    values[key] = configured[key]
+            mode = configured.get("generationMode", values["generationMode"])
+            if not isinstance(mode, str) or mode not in {"full", "daily-sampled"}:
+                raise ValueError("generationMode")
+            zone = configured.get("dailyTimezone", values["dailyTimezone"])
+            if not isinstance(zone, str) or len(zone) > 80:
+                raise ValueError("dailyTimezone")
+            try:
+                ZoneInfo(zone)
+            except (ZoneInfoNotFoundError, ValueError) as error:
+                raise ValueError("dailyTimezone") from error
+            values.update(generationMode=mode, dailyTimezone=zone)
+            templates = configured.get("domainTemplates", {})
+            if not isinstance(templates, dict) or any(not isinstance(k, str) or not isinstance(v, str) or
+                                                       len(v) > 3000 for k, v in templates.items()):
+                raise ValueError("domainTemplates")
+            values["domainTemplates"] = templates
+        except (OSError, ValueError) as error:
+            raise ExperienceError("领域经验配置无效，请检查配置文件。") from error
