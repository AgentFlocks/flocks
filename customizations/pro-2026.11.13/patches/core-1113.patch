+"""Error diagnostics must work without depending on the selected store."""
+import sqlite3
+from types import SimpleNamespace
+
+from flocks.workflow.error_fields import sqlite_error_fields
+
+
+def test_sqlite_error_codes_are_kept_without_query_or_payload():
+    with sqlite3.connect(":memory:") as connection:
+        try:
+            connection.execute("SELECT private_payload FROM missing_table")
+        except sqlite3.OperationalError as exc:
+            assert sqlite_error_fields(exc) == {
+                "error_type": "OperationalError",
+                "sqlite_errorcode": sqlite3.SQLITE_ERROR,
+                "sqlite_errorname": "SQLITE_ERROR",
+            }
+
+
+def test_postgres_sqlstate_is_kept_without_exception_message():
+    class DatabaseError(Exception):
+        sqlstate = "40001"
+
+    assert sqlite_error_fields(DatabaseError("private query and credentials")) == {
+        "error_type": "DatabaseError", "sqlstate": "40001",
+    }
+
+
+def test_unstructured_exception_records_only_its_type():
+    assert sqlite_error_fields(RuntimeError("private payload")) == {"error_type": "RuntimeError"}
+
+
+def test_invalid_database_fields_are_not_exported():
+    error = SimpleNamespace(sqlite_errorcode="private", sqlite_errorname="private", sqlstate="private")
+    assert sqlite_error_fields(error) == {"error_type": "SimpleNamespace"}
