+    assert 'DNS 查询' in card['summary']
+    assert not any(word in card['summary'] for word in ('C2', '感染', '依据', '不能据此'))
+    assert 'random-14.biz' not in card['summary'] and 'random-14.biz' in json.dumps(card['fields'])
