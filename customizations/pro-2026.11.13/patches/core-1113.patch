+def _attempt_message(message: str, has_previous: bool) -> str:
+    # Normalize exact known old templates only, never rewrite arbitrary provider
+    # text into a guessed cause. Published state decides the status suffix.
+    if message.startswith(_FIRST_RUN_PREFIX):
+        message = message[len(_FIRST_RUN_PREFIX):]
+    message = _LEGACY_FAILURE_MESSAGES.get(message, message)
+    if has_previous:
+        return message if "上一版" in message or "旧版" in message else message + "已保留上一版。"
+    if "上一版" in message or "旧版" in message:
+        message = "上一轮更新未完成，请检查配置、模型服务与资料权限后继续。"
+    return _FIRST_RUN_PREFIX + message
