+    async def test_cancelled_publication_consumes_worker_failure_before_releasing_lock(self):
+        self.source()
+        entered = asyncio.Event()
+        release = threading.Event()
+        completed = threading.Event()
+        loop = asyncio.get_running_loop()
+        unhandled = []
+        old_handler = loop.get_exception_handler()
+        loop.set_exception_handler(lambda _loop, context: unhandled.append(context))
+        def failed_publish(*_args):
+            loop.call_soon_threadsafe(entered.set)
+            try:
+                if not release.wait(timeout=5):
+                    raise RuntimeError("test publication wait expired")
+                raise OSError("test publication failed")
+            finally:
+                completed.set()
+        first = None
+        try:
+            with patch.object(self.module, "_publish", side_effect=failed_publish):
+                first = asyncio.create_task(self.update())
+                await asyncio.wait_for(entered.wait(), timeout=2)
+                first.cancel()
+                await asyncio.sleep(0)
+                self.assertFalse(first.done())
+                self.assertEqual((await self.update())["status"], "running")
+                release.set()
+                with self.assertRaises(asyncio.CancelledError):
+                    await first
+                self.assertTrue(completed.is_set())
+                self.assertFalse(self.current_path().exists())
+            self.assertEqual((await self.update())["status"], "ready")
+            await asyncio.sleep(0)
+            self.assertEqual(unhandled, [])
+        finally:
+            release.set()
+            if first is not None and not first.done():
+                try:
+                    await first
+                except asyncio.CancelledError:
+                    pass
+            loop.set_exception_handler(old_handler)
