diff --git a/webui/src/hooks/useTodayTokenUsage.test.ts b/webui/src/hooks/useTodayTokenUsage.test.ts
new file mode 100644
index 00000000..1cecb73c
--- /dev/null
+++ b/webui/src/hooks/useTodayTokenUsage.test.ts
@@ -0,0 +1,122 @@
+import { act, cleanup, renderHook } from '@testing-library/react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { clearTodayTokenUsageCache, formatTokenCount, getLocalTodayRange, toUtcIsoSeconds, useTodayTokenUsage } from './useTodayTokenUsage';
+
+const mocks = vi.hoisted(() => ({ get: vi.fn(), user: { id: 'user-a' } as { id: string } | null }));
+vi.mock('@/api/client', () => ({ default: { get: mocks.get } }));
+vi.mock('@/contexts/AuthContext', () => ({ useAuth: () => ({ user: mocks.user }) }));
+
+beforeEach(() => {
+  clearTodayTokenUsageCache();
+  mocks.user = { id: 'user-a' };
+  mocks.get.mockReset().mockResolvedValue({ data: { total_tokens: 1234567 } });
+  vi.useFakeTimers();
+  vi.setSystemTime(new Date(2026, 8, 11, 12));
+});
+afterEach(() => { cleanup(); vi.useRealTimers(); vi.restoreAllMocks(); });
+
+describe('useTodayTokenUsage helpers', () => {
+  it('formats UTC instants like backend usage timestamps', () => {
+    expect(toUtcIsoSeconds(new Date('2026-09-03T00:09:10.123Z'))).toBe('2026-09-03T00:09:10+00:00');
+  });
+
+  it('converts the browser local day to UTC query boundaries', () => {
+    const now = new Date(2026, 8, 3, 8, 9, 10);
+    const start = new Date(now);
+    start.setHours(0, 0, 0, 0);
+    const end = new Date(start);
+    end.setDate(end.getDate() + 1);
+
+    expect(getLocalTodayRange(now)).toEqual({
+      startDate: toUtcIsoSeconds(start),
+      endDate: toUtcIsoSeconds(end),
+    });
+  });
+
+  it('formats the token total in millions with three decimal places', () => {
+    expect(formatTokenCount(1234567, 'en-US')).toBe('1.235M');
+    expect(formatTokenCount(1000000, 'zh-CN')).toBe('1.000M');
+    expect(formatTokenCount(999)).toBe('0.001M');
+  });
+});
+
+describe('useTodayTokenUsage requests', () => {
+  it('deduplicates concurrent mounts and reuses a fresh same-day result', async () => {
+    const a = renderHook(() => useTodayTokenUsage());
+    const b = renderHook(() => useTodayTokenUsage());
+    await act(async () => {});
+    expect(mocks.get).toHaveBeenCalledTimes(1);
+    expect(mocks.get).toHaveBeenCalledWith('/api/home-usage/today-token', expect.objectContaining({ timeout: 8000 }));
+    expect(a.result.current.totalTokens).toBe(1234567);
+    expect(b.result.current.hasValue).toBe(true);
+    a.unmount(); b.unmount();
+    const reopened = renderHook(() => useTodayTokenUsage());
+    expect(reopened.result.current.loading).toBe(false);
+    expect(reopened.result.current.totalTokens).toBe(1234567);
+    await act(async () => {});
+    expect(mocks.get).toHaveBeenCalledTimes(1);
+  });
+
+  it('keeps recent totals during a refresh failure instead of resetting to zero', async () => {
+    const hook = renderHook(() => useTodayTokenUsage());
+    await act(async () => {});
+    mocks.get.mockRejectedValue(new Error('timeout'));
+    await act(async () => { await hook.result.current.refresh(); });
+    expect(hook.result.current.totalTokens).toBe(1234567);
+    expect(hook.result.current.hasValue).toBe(true);
+    expect(hook.result.current.error).toBe('timeout');
+    expect(hook.result.current.loading).toBe(false);
+    await act(async () => { await vi.advanceTimersByTimeAsync(300_001); });
+    expect(hook.result.current.hasValue).toBe(false);
+  });
+
+  it('does not overlap slow polls and pauses requests while hidden', async () => {
+    let finish!: (value: unknown) => void;
+    mocks.get.mockReturnValue(new Promise((resolve) => { finish = resolve; }));
+    const hook = renderHook(() => useTodayTokenUsage());
+    await act(async () => { await vi.advanceTimersByTimeAsync(90_000); });
+    expect(mocks.get).toHaveBeenCalledTimes(1);
+    await act(async () => { finish({ data: { total_tokens: 10 } }); });
+    const hidden = vi.spyOn(document, 'hidden', 'get').mockReturnValue(true);
+    await act(async () => { await vi.advanceTimersByTimeAsync(60_000); });
+    expect(mocks.get).toHaveBeenCalledTimes(1);
+    hidden.mockReturnValue(false);
+    mocks.get.mockResolvedValue({ data: { total_tokens: 20 } });
+    await act(async () => { document.dispatchEvent(new Event('visibilitychange')); });
+    expect(hook.result.current.totalTokens).toBe(20);
+  });
+
+  it('does not reuse another user or yesterday totals', async () => {
+    const hook = renderHook(() => useTodayTokenUsage());
+    await act(async () => {});
+    mocks.user = { id: 'user-b' };
+    mocks.get.mockResolvedValue({ data: { total_tokens: 42 } });
+    hook.rerender();
+    expect(hook.result.current.hasValue).toBe(false);
+    await act(async () => {});
+    expect(hook.result.current.totalTokens).toBe(42);
+    vi.setSystemTime(new Date(2026, 8, 12, 0, 0, 1));
+    mocks.get.mockResolvedValue({ data: { total_tokens: 0 } });
+    hook.rerender();
+    expect(hook.result.current.hasValue).toBe(false);
+    await act(async () => { await hook.result.current.refresh(); });
+    expect(hook.result.current.totalTokens).toBe(0);
+    expect(hook.result.current.hasValue).toBe(true);
+    expect(mocks.get).toHaveBeenLastCalledWith('/api/home-usage/today-token', expect.objectContaining({ params: {
+      start_date: getLocalTodayRange().startDate, end_date: getLocalTodayRange().endDate,
+    } }));
+  });
+
+  it('does not turn an initial failure into a zero reading or fetch without a user', async () => {
+    mocks.get.mockRejectedValue(new Error('unavailable'));
+    const hook = renderHook(() => useTodayTokenUsage());
+    await act(async () => {});
+    expect(hook.result.current.hasValue).toBe(false);
+    expect(hook.result.current.loading).toBe(false);
+    expect(hook.result.current.error).toBe('unavailable');
+    mocks.user = null;
+    hook.rerender();
+    await act(async () => { await vi.advanceTimersByTimeAsync(60_000); });
+    expect(mocks.get).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/webui/src/hooks/useTodayTokenUsage.ts b/webui/src/hooks/useTodayTokenUsage.ts
new file mode 100644
index 00000000..cb2deba4
--- /dev/null
+++ b/webui/src/hooks/useTodayTokenUsage.ts
@@ -0,0 +1,123 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import client from '@/api/client';
+import { useAuth } from '@/contexts/AuthContext';
+
+const TOKEN_USAGE_POLL_INTERVAL_MS = 30_000;
+const MAX_STALE_MS = 5 * 60_000;
+type Snapshot = { key: string; totalTokens: number; fetchedAt: number };
+const cache = new Map<string, Snapshot>();
+const pending = new Map<string, Promise<Snapshot>>();
+let cacheEpoch = 0;
+
+/** Clear authenticated in-memory data when the session expires. */
+export function clearTodayTokenUsageCache(): void { cache.clear(); pending.clear(); cacheEpoch += 1; }
+
+export interface TodayTokenUsageState {
+  totalTokens: number;
+  loading: boolean;
+  error: string | null;
+  hasValue: boolean;
+  refresh: () => Promise<void>;
+}
+
+/** Format a date like Python's UTC datetime.isoformat(), without milliseconds. */
+export function toUtcIsoSeconds(value: Date): string {
+  return value.toISOString().replace(/\.\d{3}Z$/, '+00:00');
+}
+
+/** Return the local-calendar-day range expressed as UTC instants. */
+export function getLocalTodayRange(now: Date = new Date()): { startDate: string; endDate: string } {
+  const start = new Date(now);
+  start.setHours(0, 0, 0, 0);
+  const end = new Date(start);
+  end.setDate(end.getDate() + 1);
+  return {
+    startDate: toUtcIsoSeconds(start),
+    endDate: toUtcIsoSeconds(end),
+  };
+}
+
+/** Format the token total in millions with exactly three decimal places. */
+export function formatTokenCount(value: number, _locale?: string): string {
+  return `${(value / 1_000_000).toFixed(3)}M`;
+}
+
+export function useTodayTokenUsage(): TodayTokenUsageState {
+  const { user } = useAuth();
+  const scope = user?.id ?? '';
+  const mounted = useRef(false);
+  const currentScope = useRef(scope);
+  currentScope.current = scope;
+  const [state, setState] = useState<{ snapshot?: Snapshot; key?: string; error: string | null }>({ error: null });
+  const range = getLocalTodayRange();
+  const key = `${scope}:${range.startDate}:${range.endDate}`;
+  const candidate = state.snapshot?.key === key ? state.snapshot : cache.get(key);
+  const snapshot = scope && candidate && Date.now() - candidate.fetchedAt < MAX_STALE_MS ? candidate : undefined;
+  const error = state.key === key ? state.error : null;
+
+  const refresh = useCallback(async (force = true) => {
+    if (!scope) return;
+    const { startDate, endDate } = getLocalTodayRange();
+    const requestKey = `${scope}:${startDate}:${endDate}`;
+    const requestEpoch = cacheEpoch;
+    const isCurrent = () => mounted.current && requestEpoch === cacheEpoch && currentScope.current === scope
+      && getLocalTodayRange().startDate === startDate;
+    try {
+      let result = cache.get(requestKey);
+      if (force || !result || Date.now() - result.fetchedAt >= TOKEN_USAGE_POLL_INTERVAL_MS) {
+        let request = pending.get(requestKey);
+        if (!request) {
+          const epoch = cacheEpoch;
+          request = client.get<{ total_tokens: number }>('/api/home-usage/today-token', {
+            params: { start_date: startDate, end_date: endDate }, timeout: 8000,
+          }).then((response) => {
+            const total = response.data.total_tokens;
+            if (typeof total !== 'number' || !Number.isFinite(total) || total < 0) throw new Error('usageUnavailable');
+            const value = { key: requestKey, totalTokens: total, fetchedAt: Date.now() };
+            if (epoch === cacheEpoch) cache.set(requestKey, value);
+            while (cache.size > 8) cache.delete(cache.keys().next().value!);
+            return value;
+          }).finally(() => { if (pending.get(requestKey) === request) pending.delete(requestKey); });
+          pending.set(requestKey, request);
+        }
+        result = await request;
+      }
+      if (isCurrent()) setState({ snapshot: result, key: requestKey, error: null });
+    } catch (reason: unknown) {
+      if (isCurrent()) setState({ snapshot: cache.get(requestKey), key: requestKey,
+        error: reason instanceof Error && reason.message ? reason.message : 'usageUnavailable' });
+    }
+  }, [scope]);
+
+  useEffect(() => {
+    mounted.current = true;
+    let stopped = false;
+    let timer = 0;
+    const tick = async () => {
+      window.clearTimeout(timer);
+      if (!document.hidden) await refresh(false);
+      if (!stopped) {
+        window.clearTimeout(timer);
+        timer = window.setTimeout(() => void tick(), TOKEN_USAGE_POLL_INTERVAL_MS);
+      }
+    };
+    const onVisible = () => { if (!document.hidden) void tick(); };
+    const onExpired = () => {
+      clearTodayTokenUsageCache();
+      setState({ key, error: 'usageUnavailable' });
+    };
+    void tick();
+    document.addEventListener('visibilitychange', onVisible);
+    window.addEventListener('flocks:auth-expired', onExpired);
+    return () => {
+      stopped = true;
+      mounted.current = false;
+      window.clearTimeout(timer);
+      document.removeEventListener('visibilitychange', onVisible);
+      window.removeEventListener('flocks:auth-expired', onExpired);
+    };
+  }, [refresh]);
+
+  return { totalTokens: snapshot?.totalTokens ?? 0, hasValue: !!snapshot,
+    loading: !!scope && !snapshot && !error, error, refresh };
+}
