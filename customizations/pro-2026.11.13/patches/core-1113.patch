+  'custom-soc-ndr-egress',
+  'custom-soc-ndr-dns',
+  'custom-soc-ndr-lateral',
+  'custom-soc-ndr-exfil',
+  'custom-soc-device-health',
+  'custom-soc-alert-fusion',
+  'custom-soc-closure-report',
+]);
+
+export function isManagedCustomWorkflowId(value: unknown): boolean {
+  return typeof value === 'string' && MANAGED_CUSTOM_WORKFLOW_IDS.has(value);
+}
