+                        next_seen.update({_key(node): _signature(engine, node) for node in nodes if _key(node) not in candidate_keys})
+                for source, _ in selected:
+                    next_seen[_key(source)] = source["metadata_signature"]
+                remaining = sum(_key(node) not in next_seen or next_seen[_key(node)] != _signature(engine, node) for node in candidates)
+                coverage["processed"] = len(selected)
+                sources = [source for source, _ in selected]
+                daily_state = {"seen": next_seen, "baseline_at": baseline_at, "sealed_date": _today(settings),
+                               "baseline_complete": bool(state.get("baseline_complete", False) or not index["truncated"]),
+                               "mode": "initial" if initial else "incremental", "sample_count": len(selected),
+                               "sample_limit": limit, "available_count": len(nodes), "pending_count": remaining,
+                               "base_version": base_version, "generation_method": method,
+                               "scan_incomplete": bool(index["truncated"])}
+                if method == "extractive":
+                    daily_state.update(generation_note="模型未完成本轮归纳，已使用真实资料摘录进行本地自动整理。", diagnostics=diagnostics)
+                changes = {"added": sum(_key(source) not in seen for source in sources),
+                           "modified": sum(_key(source) in seen for source in sources), "removed": 0}
+                model.stage = "publish"
+                await engine._commit_publication(context, definition, content, sources, coverage, changes,
+                                                 engine._hash(["daily-sampled", daily_state["sealed_date"], next_seen]), daily_state)
+                counts["updated"] += 1
+                counts["extractive"] += int(method == "extractive")
+                results.append(read(engine, context, definition, config))
+            except (engine.ExperienceError, OSError) as error:
+                counts["failed"] += 1
+                message = engine._attempt_message(str(error) if isinstance(error, engine.ExperienceError) else "知识存储暂时不可用。", _published(saved))
+                diagnostics = model.diagnostics(error)
+                if model.authorized:
+                    try:
+                        await engine._commit_locked_write(engine._write_json, context, f"{definition['id']}/attempt.json",
+                            engine._record(context, updated_at=engine._now(), error=message, coverage=coverage, diagnostics=diagnostics))
+                    except (OSError, engine.ExperienceError):
+                        pass
+                results.append({**engine._empty(definition), "status": "failed", "error": message,
+                                "daily": _daily(saved, settings), "diagnostics": diagnostics})
+                if not model.authorized:
+                    break
+        engine._check_read_scope(user, context)
+    status = "partial" if counts["failed"] and counts["updated"] else "failed" if counts["failed"] else "ready" if counts["updated"] else "unchanged"
+    return {"status": status, "results": results, "calls": model.calls, **counts}
