+            candidates = nodes if initial else [node for node in nodes if
+                (_key(node) in seen and seen[_key(node)] != _signature(engine, node)) or
+                (_key(node) not in seen and (state.get("baseline_complete", False) or float(node.get("modified_at") or 0) > baseline_at))]
+            limit = settings["initialSampleSize"] if initial else settings["dailySampleSize"]
+            base_version = saved.get("version") if _published(saved) else None
+            coverage = {"total": len(candidates), "processed": 0, "skipped": 0, "failed": 0,
+                        "unsupported": 0, "too_large": 0, "incomplete": bool(index["truncated"])}
+            selected = []
+            failed_keys = set()
+            try:
+                await model.reauthorize()
+                if not candidates and _published(saved):
