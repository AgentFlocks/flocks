+"""Offline suite tests; all writes stay in a disposable, monkeypatched home."""
+from __future__ import annotations
+
+import contextlib
+import importlib.util
+import json
+import os
+import sys
+import tempfile
+import unittest
+from collections import Counter
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from unittest.mock import patch
+
+BASE = Path(__file__).resolve().parents[2]
+REPO = str(Path(__file__).resolve().parents[2])
+
+
+class WorkflowSuiteRuntimeTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="flocks-suite-test-")
+        self.addCleanup(self.temporary.cleanup)
+        self.home = Path(self.temporary.name).resolve()
+        spec = importlib.util.spec_from_file_location("flocks.workflow.custom_soc_suite", BASE / "flocks/workflow/custom_soc_suite.py")
+        self.module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(self.module)
+        self.settings = self.home / "settings.json"
+        self.settings.write_text(json.dumps({"schemaVersion": 1, "ownerName": "测试值班组", "emailDisplay": "ops-test@example.invalid"}), encoding="utf-8")
+        self.clock = datetime(2026, 9, 14, 1, 2, tzinfo=timezone.utc)
+        self.addCleanup(patch.stopall)
+        patch.object(self.module, "SETTINGS_PATH", self.settings).start()
+        patch.object(self.module.Path, "home", return_value=self.home).start()
+        patch.object(self.module, "_now", side_effect=lambda: self.clock).start()
+        patch.dict(sys.modules, {"flocks.workflow.custom_soc_suite": self.module}).start()
+
+    def stage(self, identifier, stage, state):
+        return self.module.run_stage(identifier, stage, {"state": state})["state"]
+
+    def report(self, identifier, inputs=None, publish=False):
+        state = self.module.run_stage(identifier, "prepare", inputs or {})["state"]
+        state = self.stage(identifier, "normalize", state)
+        state = self.stage(identifier, "analyze", state)
+        state = self.stage(identifier, state["decision"], state)
+        state = self.stage(identifier, "compile", state)
+        return self.module.run_stage(identifier, "publish", {"state": state}) if publish else state["report"]
+
+    def sample(self, identifier, scenario="risk"):
+        kind = self.module.WORKFLOWS[identifier][2]
+        return self.module._samples(kind, scenario, self.clock)
+
+    def test_all_seven_sample_scenarios_take_distinct_true_rule_branches(self):
+        self.assertEqual(len(self.module.WORKFLOWS), 7)
+        for identifier in self.module.WORKFLOWS:
+            for scenario, expected in (("risk", "risk"), ("normal", "normal"), ("insufficient", "insufficient")):
+                with self.subTest(identifier=identifier, scenario=scenario):
+                    report = self.report(identifier, {"scenario": scenario})
+                    self.assertEqual(report["branch"], expected)
+                    self.assertEqual(report["metadata"]["data_origin"], "builtin_synthetic")
+                    self.assertEqual(report["notification"]["recipient_display"], "ops-test@example.invalid")
+                    self.assertEqual(report["notification"]["status"], "not_sent")
+                    if scenario == "insufficient":
+                        self.assertEqual(report["business_status"], "pending_verification")
+        self.assertFalse((self.home / ".flocks").exists(), "non-final stages must not write outputs")
+
+    def test_explicit_empty_arrays_and_provided_records_never_fall_back_to_samples(self):
+        for identifier, (_, dataset, _) in self.module.WORKFLOWS.items():
+            with self.subTest(identifier=identifier):
+                empty = self.report(identifier, {dataset: []})
+                self.assertEqual(empty["metadata"]["data_origin"], "user_provided_unverified")
+                self.assertEqual(empty["quality"]["valid_count"], 0)
+                self.assertEqual(empty["branch"], "insufficient")
+                provided = self.report(identifier, {dataset: self.sample(identifier, "normal")})
+                self.assertEqual(provided["branch"], "normal")
+                self.assertEqual(provided["metadata"]["data_origin"], "user_provided_unverified")
+
+    def test_bad_rows_are_quality_gaps_not_success(self):
+        for identifier, (_, dataset, _) in self.module.WORKFLOWS.items():
+            report = self.report(identifier, {dataset: [{"unrelated": "not valid domain evidence"}]})
+            self.assertEqual(report["quality"]["invalid_count"], 1)
+            self.assertEqual(report["branch"], "insufficient")
+
+    def test_limits_bad_types_and_unknown_parameters_fail_with_static_errors(self):
+        identifier = "custom-soc-ndr-egress"
+        invalid = [[], {"scenario": []}, {"scenario": {}}, {"scenario": "bad"}, {"sessions": None},
+                   {"sessions": [None]}, {"sessions": [{}] * 1001}, {"sessions": [{"src": "x" * 1025}]},
+                   {"sessions": [{"src": {"nested": "private"}}]}, {"sessions": [{"bytes_out": float("inf")}]},
+                   {"evaluation_time": "2026-09-14T00:00:00"}, {"output_path": "/private/credentials"},
+                   {"command": "never-execute-private"}, {"smtp_password": "never-print-private"}]
+        for value in invalid:
+            with self.subTest(value_type=type(value).__name__):
+                with self.assertRaises(self.module.SuiteError) as caught:
+                    self.module.run_stage(identifier, "prepare", value)
+                self.assertNotIn("never-", str(caught.exception))
+        with self.assertRaises(self.module.SuiteError):
+            self.module.run_stage("../../outside", "prepare", {})
+
+    def test_oversized_total_payload_rejected(self):
+        records = [{"field" + str(i): "x" * 1024 for i in range(2)} for _ in range(1000)]
+        with self.assertRaises(self.module.SuiteError):
+            self.module.run_stage("custom-soc-ndr-egress", "prepare", {"sessions": records})
+
+    def test_numeric_and_timestamp_anomalies_do_not_turn_normal(self):
+        identifier = "custom-soc-ndr-exfil"
+        for field, value in (("bytes_out", True), ("bytes_out", -1), ("timestamp", "invalid"), ("destination_scope", "maybe")):
+            row = self.sample(identifier)[0]
+            row[field] = value
+            report = self.report(identifier, {"sessions": [row]})
+            self.assertEqual(report["branch"], "insufficient")
+
+    def test_periodic_egress_is_detected_without_host_or_reputation_data(self):
+        rows = self.sample("custom-soc-ndr-egress")
+        for row in rows:
+            row.pop("reputation")
+        report = self.report("custom-soc-ndr-egress", {"sessions": rows})
+        self.assertEqual(report["branch"], "risk")
+        self.assertTrue(report["findings"][0]["metrics"]["periodic"])
+        self.assertFalse(report["findings"][0]["metrics"]["known_malicious"])
+
+    def test_dns_report_does_not_include_encoded_query_payloads(self):
+        rows = self.sample("custom-soc-ndr-dns")
+        report = self.report("custom-soc-ndr-dns", {"dns_records": rows})
+        self.assertEqual(report["branch"], "risk")
+        text = json.dumps(report, ensure_ascii=False)
+        self.assertNotIn(rows[0]["query"], text)
+        self.assertGreater(report["findings"][0]["metrics"]["long_encoded_queries"], 0)
+
+    def test_dns_invalid_address_unknown_enums_and_bad_names_are_not_normal(self):
+        identifier = "custom-soc-ndr-dns"
+        invalid = (("client", "INVALID-IP"), ("rcode", "UNKNOWN"), ("query_type", "UNKNOWN"),
+                   ("query", "a..example.test"), ("query", "a" * 64 + ".example.test"),
+                   ("query", ".".join(["a" * 63] * 5)), ("query", "example.test.."),
+                   ("query", "https://example.test/path"))
+        for field, value in invalid:
+            with self.subTest(field=field):
+                rows = [{**row, field: value} for row in self.sample(identifier, "normal")]
+                report = self.report(identifier, {"dns_records": rows})
+                self.assertEqual(report["branch"], "insufficient")
+                self.assertEqual(report["quality"]["valid_count"], 0)
+                self.assertEqual(report["quality"]["invalid_count"], 12)
+
+    def test_dns_accepts_case_srv_dkim_idn_trailing_dot_ipv6_and_root_query(self):
+        identifier = "custom-soc-ndr-dns"
+        for query, query_type in (("_LDAP._TCP.Example.Test.", "srv"), ("selector._domainkey.example.test", "txt"),
+                                  ("例子.测试", "a"), (".", "NS"), ("*.example.test", "A")):
+            with self.subTest(query=query):
+                rows = [{**self.sample(identifier, "normal")[0], "client": "2001:db8::1", "query": query, "query_type": query_type, "rcode": "noerror"}]
+                report = self.report(identifier, {"dns_records": rows})
+                self.assertEqual(report["quality"]["valid_count"], 1)
+                self.assertEqual(report["quality"]["invalid_count"], 0)
+                self.assertEqual(report["branch"], "normal")
+
+    def test_tcp_establishment_is_not_reported_as_account_login(self):
+        report = self.report("custom-soc-ndr-lateral")
+        self.assertIn("TCP建连不等于登录成功", report["findings"][0]["title"])
+        self.assertEqual(report["findings"][0]["status"], "pending_verification")
+
+    def test_invalid_lateral_source_or_destination_is_a_data_gap_not_normal(self):
+        identifier = "custom-soc-ndr-lateral"
+        for field in ("src", "dst"):
+            rows = [{**row, field: "INVALID-IP"} for row in self.sample(identifier)]
+            report = self.report(identifier, {"sessions": rows})
+            self.assertEqual(report["branch"], "insufficient")
+            self.assertEqual(report["quality"]["invalid_count"], 7)
+            self.assertEqual(report["quality"]["valid_count"], 0)
+
+    def test_upload_without_baseline_stays_unverified_medium_risk(self):
+        rows = self.sample("custom-soc-ndr-exfil")
+        rows[0].pop("baseline_out_bytes")
