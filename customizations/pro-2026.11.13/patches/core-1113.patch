+            "websiteman-use-SKILL.md": ("operations-reference", "skills"),
+            "unknown_report.md": ("unclassified", "other"),
+        }
+        for path, expected in cases.items():
+            with self.subTest(path=path):
+                node = catalog.classify("2026-09-10/" + path, "personal", self.config)
+                self.assertEqual((node["category"], node["subcategory"]), expected)
+
+    def test_hidden_sensitive_and_process(self):
+        for path in (".secret.md", "2026-09-10/.private/report.md", "../report.md", "/report.md", "auth_state.json", "cookies.json", "secrets_files_a_before.txt"):
+            self.assertIsNone(catalog.classify(path, "personal", self.config), path)
+        node = catalog.classify("2026-09-10/tool-output/tool_123", "personal", self.config)
+        self.assertEqual(node["kind"], "process")
+        index = {"files": [node], "config": self.config, "indexed_at": 1, "truncated": False}
+        self.assertEqual(catalog.query_files(index)["total"], 0)
+        self.assertEqual(catalog.query_files(index, include_process=True)["total"], 1)
+
+    def test_security_workflow_reports_have_business_categories(self):
+        expected = {
+            "custom-soc-ndr-egress": ("network-analysis", "egress"),
+            "custom-soc-ndr-dns": ("network-analysis", "dns"),
+            "custom-soc-ndr-lateral": ("network-analysis", "lateral"),
+            "custom-soc-ndr-exfil": ("network-analysis", "exfil"),
+            "custom-soc-device-health": ("device-inspection", "other"),
+            "custom-soc-alert-fusion": ("alert-denoise", "other"),
+            "custom-soc-closure-report": ("platform-operations", "other"),
+        }
+        for workflow_id, category in expected.items():
+            with self.subTest(workflow_id=workflow_id):
+                node = catalog.classify(f"2026-09-14/security-operations/{workflow_id}/report.md", "personal", self.config)
+                self.assertIsNotNone(node)
+                self.assertEqual((node["category"], node["subcategory"]), category)
+
+    def test_topics_keep_targets_roots_and_evidence_separate(self):
+        first = catalog.classify("2026-09-09/四季青_巡检报告_2026-09-09.md", "personal", self.config)
+        second = catalog.classify("2026-09-10/四季青_巡检报告_2026-09-10.md", "personal", self.config)
+        self.assertEqual(first["topic"], second["topic"])
+        for path, root in ((second["path"], "shared"), ("2026-09-10/青岛_巡检报告.md", "personal"), (second["path"].replace(".md", ".json"), "personal")):
+            self.assertNotEqual(first["topic"], catalog.classify(path, root, self.config)["topic"])
+        ip_a = catalog.classify("2026-09-10/host_10.1.2.3.md", "personal", self.config)
+        ip_b = catalog.classify("2026-09-10/host_10.1.2.4.md", "personal", self.config)
+        self.assertNotEqual(ip_a["topic"], ip_b["topic"])
+
+    def test_scan_versions_pagination_search_and_evidence(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            for path in ("2026-09-09/四季青_巡检报告_2026-09-09.md", "2026-09-10/四季青_巡检报告_2026-09-10.md",
+                         "2026-09-10/js-audit/audit-report.md", "2026-09-10/js-audit/findings.json",
+                         "2026-09-10/.private/hidden.md", "2026-09-10/tool-output/tool_1"):
+                target = root / path
+                target.parent.mkdir(parents=True, exist_ok=True)
+                target.write_text("fixture", encoding="utf-8")
+            (root / "linked.md").symlink_to(root / "2026-09-10/四季青_巡检报告_2026-09-10.md")
+            (root / "linked-directory").symlink_to(root / "2026-09-10", target_is_directory=True)
+            index = catalog.scan([("personal", root)], self.config)
+            self.assertFalse(index["truncated"])
+            self.assertFalse(any("hidden" in n["path"] or "linked" in n["path"] for n in index["files"]))
+            page = catalog.query_files(index, category="device-inspection")
+            self.assertEqual(page["total"], 1)
+            self.assertEqual(page["items"][0]["date"], "2026-09-10")
+            self.assertEqual(page["items"][0]["version_count"], 2)
+            self.assertEqual(catalog.query_files(index, topic=page["items"][0]["topic"])["total"], 2)
+            self.assertEqual(catalog.query_files(index, query="四季青 巡检", before="2026-09-09")["total"], 1)
+            self.assertEqual(catalog.query_files(index, tag="青岛")["total"], 0)
+            self.assertEqual(catalog.query_files(index, offset=1, limit=1)["items"].__len__(), 1)
+            self.assertEqual(catalog.query_files(index, latest=False)["total"], 4)
+            self.assertEqual(catalog.query_files(index, with_evidence=True)["total"], 1)
+            context = catalog.file_context(index, "personal", "2026-09-10/js-audit/audit-report.md")
+            self.assertEqual([n["name"] for n in context["related"]], ["findings.json"])
+            self.assertEqual(catalog.file_context(index, "shared", context["node"]["path"])["node"], None)
+            summary = catalog.summary(index)
+            self.assertEqual(summary["count"], 4)
+            self.assertEqual(len(summary["categories"]), 2)
+
+    def test_history_sorts_mixed_timestamp_formats_chronologically(self):
+        names = ["2026-09-10/manual-review/report_20260910_0900.md",
+                 "2026-09-10/manual-review/report_2026-09-10_1800.md"]
+        nodes = [catalog.classify(name, "personal", self.config) for name in names]
+        nodes.sort(key=catalog._sort_key, reverse=True)
+        self.assertEqual(nodes[0]["path"], names[1])
+
+    def test_cache_is_scoped_and_refreshable(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            alice, bob = root / "alice", root / "bob"
+            alice.mkdir(); bob.mkdir()
+            (alice / "alice.md").write_text("alice")
+            (bob / "bob.md").write_text("bob")
