+        finding = report["findings"][0]
+        self.assertEqual(finding["severity"], "medium")
+        self.assertFalse(finding["metrics"]["baseline_available"])
+        self.assertEqual(report["business_status"], "action_required")
+
+    def test_device_recovery_requires_two_distinct_fresh_normal_observations(self):
+        identifier = "custom-soc-device-health"
+        abnormal = self.sample(identifier)[-1]
