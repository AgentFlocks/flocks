+"""Fast, daily-frozen knowledge snapshots from bounded, authorized excerpts.
+
+No source file is changed. Metadata cursors and day seals live in the same
+atomic current record as the summary, never in a separately advanced cursor.
+"""
+from __future__ import annotations
+
+import asyncio
+import codecs
+import html
+import os
+import re
+import stat
+from datetime import datetime, timezone
+from html.parser import HTMLParser
+from zoneinfo import ZoneInfo
+
+MAX_CANDIDATE_READS = 100
+
+
+def _now() -> datetime:
+    return datetime.now(timezone.utc)
+
+
+def _today(settings: dict) -> str:
+    return _now().astimezone(ZoneInfo(settings["dailyTimezone"])).date().isoformat()
+
+
+def publication_date(settings: dict) -> str:
+    """Called inside the actual commit worker, not before it is queued."""
+    return _today(settings)
+
+
+def _published(record: dict | None) -> bool:
+    return bool(record and record.get("version") and isinstance(record.get("content"), str) and record["content"].strip())
+
+
+def _sealed_date(record: dict | None, settings: dict) -> str | None:
+    if not _published(record):
+        return None
+    state = record.get("daily_state") or {}
+    if state.get("sealed_date"):
+        return state["sealed_date"]
+    try:
+        return datetime.fromisoformat(record["updated_at"].replace("Z", "+00:00")).astimezone(
+            ZoneInfo(settings["dailyTimezone"])).date().isoformat()
+    except (ValueError, TypeError, KeyError):
+        return None
+
+
+def _daily(record: dict | None, settings: dict, *, historical: bool = False) -> dict:
+    state = (record or {}).get("daily_state") or {}
+    available = len((record or {}).get("sources", []))
+    result = {
+        "enabled": True, "locked": not historical and _sealed_date(record, settings) == _today(settings),
+        "date": (_sealed_date(record, settings) or _today(settings)) if historical else _today(settings), "timezone": settings["dailyTimezone"],
+        "mode": state.get("mode", "reused" if _published(record) else "initial"),
+        "sample_count": state.get("sample_count", 0),
+        "sample_limit": state.get("sample_limit", settings["initialSampleSize"]),
+        "available_count": state.get("available_count", available),
+        "pending_count": state.get("pending_count", 0),
+        "base_version": state.get("base_version"),
+        "generation_method": state.get("generation_method", "model" if _published(record) else "reused"),
+        "scan_incomplete": bool(state.get("scan_incomplete", False)),
+    }
+    if state.get("generation_note"):
+        result["generation_note"] = state["generation_note"]
+    return result
+
+
+def read(engine, context: dict, category: dict, config: dict, version: str | None = None) -> dict:
+    if version is not None and not engine._VERSION.fullmatch(version):
+        raise engine.ExperienceNotFound("知识版本不存在。")
+    relative = f"{category['id']}/history/{version}.json" if version else f"{category['id']}/current.json"
+    record = engine._read_json(context, relative)
+    if version and record is None:
+        raise engine.ExperienceNotFound("知识版本不存在。")
+    value = engine._empty(category)
+    value["daily"] = _daily(record, context["settings"], historical=version is not None)
+    if _published(record):
+        value.update({key: record[key] for key in ("content", "updated_at", "version", "coverage", "changes")})
+        value["content"] = readable_extractive(value["content"])
+        value.update(status="ready", sources=[engine._public_source(source) for source in record.get("sources", [])])
+        diagnostics = (record.get("daily_state") or {}).get("diagnostics")
+        if diagnostics:
+            value["diagnostics"] = engine._safe_diagnostics(diagnostics)
+    # Day freezes take precedence over old failures and other domains' running
+    # jobs. No catalogue scan or source content/hash read occurs on this path.
+    if version is not None or value["daily"]["locked"]:
+        return value
+    attempt = engine._read_json(context, f"{category['id']}/attempt.json")
+    if attempt and attempt.get("read_notice"):
+        value.update(status="stale" if _published(record) else "empty", error=attempt["read_notice"],
+                     last_attempt_at=attempt.get("updated_at"), pending_coverage=attempt.get("coverage"))
+    if attempt and attempt.get("error"):
+        value.update(status="stale" if _published(record) else "failed",
+                     error=engine._attempt_message(attempt["error"], _published(record)),
+                     diagnostics=engine._safe_diagnostics(attempt.get("diagnostics")),
+                     last_attempt_at=attempt.get("updated_at"), pending_coverage=attempt.get("coverage"))
+    if engine._is_running(context):
+        value["status"] = "running"
+    return value
+
+
+class _PlainText(HTMLParser):
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.parts = []
+        self.blocked = 0
+
+    def handle_starttag(self, tag, attrs):
+        if tag.lower() in {"script", "style", "iframe", "object"}:
+            self.blocked += 1
+        elif not self.blocked:
+            self.parts.append(" ")
+
+    def handle_endtag(self, tag):
+        if tag.lower() in {"script", "style", "iframe", "object"} and self.blocked:
+            self.blocked -= 1
+
+    def handle_data(self, data):
+        if not self.blocked:
+            self.parts.append(data)
+
+
+def _clean(text: str) -> str:
+    parser = _PlainText()
+    parser.feed(text)
+    parser.close()
+    text = "".join(parser.parts)
+    text = re.sub(r"!?\[([^\]\n]*)\]\([^\n)]*\)", r"\1（链接已隐藏）", text)
+    text = re.sub(r"(?:https?://|javascript:)[^\s<>\]\)]+", "（外链已隐藏）", text, flags=re.I)
+    text = re.sub(r"\[S-[^\]\n]+\]", "", text)
+    text = re.sub(r"(?i)\bBearer\s+[A-Za-z0-9._~+/=-]+", "Bearer（已隐藏）", text)
+    text = re.sub(r"(?i)([\"']?(?:api[_-]?key|access[_-]?token|refresh[_-]?token|password|passwd|secret|client_secret|authorization|token)[\"']?\s*[:=]\s*)(?:\"[^\"]*\"|'[^']*'|[^\s,;}]+)",
+                  r"\1（已隐藏）", text)
+    text = re.sub(r"((?:密码|口令|密钥|令牌)\s*[:：=]\s*)[^\s,，;；]+", r"\1（已隐藏）", text)
+    text = re.sub(r"\bsk-[A-Za-z0-9_-]{16,}\b", "（密钥已隐藏）", text)
+    return "".join(character for character in text if character in "\n\t" or ord(character) >= 32).strip()
+
+
+def _quote(text: str) -> str:
+    # Deterministic fallback renders source text literally, not as executable
+    # HTML/links/images or model-generated source-reference syntax.
+    text = html.escape(_clean(text), quote=False)
+    return re.sub(r"([\\`*_{}\[\]()#+\-!|>])", r"\\\1", text)
+
+
+def _bounded(text: str, maximum: int) -> str:
+    if len(text) <= maximum:
+        return text
+    marker = "\n（中间内容未纳入本轮摘录）\n"
+    budget = max(0, maximum - len(marker))
+    head = budget * 2 // 3
+    return text[:head] + marker[:maximum] + (text[-(budget - head):] if budget > head else "")
+
+
+def _key(node: dict) -> str:
+    return node["root"] + ":" + node["path"]
+
+
+def _signature(engine, node: dict) -> str:
+    return engine._hash([node.get("size", 0), node.get("modified_at", 0)])
+
+
+def _excerpt(engine, context: dict, node: dict) -> tuple[dict, str]:
+    parts = engine.knowledge._path_parts(node["path"])
+    limit = context["settings"]["excerptChars"]
+    root = context["roots"][node["root"]]
+    with engine._directory(root, "/".join(parts[:-1])) as directory:
+        fd = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0), dir_fd=directory)
+        with os.fdopen(fd, "rb") as stream:
+            before = os.fstat(stream.fileno())
+            if not stat.S_ISREG(before.st_mode):
+                raise ValueError("not a regular source")
+            byte_limit = limit * 4 + 4
+            if before.st_size <= byte_limit:
+                raw = stream.read(byte_limit + 1)
+                text = raw.decode("utf-8-sig", errors="strict")
+                truncated = len(text) > limit
+                text = _bounded(text, limit)
+            else:
+                head_raw = stream.read(byte_limit)
+                stream.seek(max(0, before.st_size - byte_limit))
+                tail_raw = stream.read(byte_limit)
+                head = codecs.getincrementaldecoder("utf-8-sig")("strict").decode(head_raw, final=False)
+                tail = None
+                for offset in range(4):
+                    try:
+                        tail = tail_raw[offset:].decode("utf-8", errors="strict")
+                        break
+                    except UnicodeError:
+                        continue
+                if tail is None:
+                    raise UnicodeError("source is not UTF-8")
+                text = _bounded(head + tail, limit)
+                truncated = True
+            after = os.fstat(stream.fileno())
+            fields = lambda item: (item.st_dev, item.st_ino, item.st_size, item.st_mtime_ns, item.st_ctime_ns)
+            if fields(before) != fields(after) or "\x00" in text:
+                raise ValueError("source changed or is binary")
+    cleaned = _clean(text)
+    if not cleaned:
+        raise ValueError("no usable source text")
+    metadata = {**node, "size": before.st_size, "modified_at": before.st_mtime}
+    source = {key: node[key] for key in ("root", "path", "name", "date")}
+    source.update(id=engine._source_id(node["root"], node["path"]), metadata_signature=_signature(engine, metadata), excerpt=truncated)
+    return source, cleaned
+
+
+def _readable_sections(body: str) -> str:
+    sections = re.split(r"(?m)^#{3,4} ", body)
+    groups = {}
+    for section in sections:
+        if "\n\n> " not in section or "\n\n来源： " not in section:
+            continue
+        heading, rest = section.split("\n\n> ", 1)
+        quote, references = rest.rsplit("\n\n来源： ", 1)
+        # Metadata and raw structured evidence remain available via Sources;
+        # they are not prose highlights. Apply only to our generated envelope.
+        if re.search(r"\.(?:json|csv|xml)(?:（|\s|$)", heading, re.I):
+            continue
+        key = quote.strip()
+        if key not in groups:
+            groups[key] = [heading.strip(), []]
+        for reference in re.findall(r"\[S-[a-zA-Z0-9_-]+\]", references):
+            if reference not in groups[key][1]:
+                groups[key][1].append(reference)
+    if not groups:
+        return "本版暂无可独立阅读的文档摘录，请从下方来源资料查看原文。"
+    return "## 本次资料摘要\n\n" + "\n\n".join(
+        "### " + heading + "\n\n> " + quote + "\n\n来源： " + " ".join(refs)
+        for quote, (heading, refs) in groups.items())
+
+
+def readable_extractive(text: str) -> str:
+    """Adapt only known fallback envelopes; never rewrite stored history."""
+    if text.startswith("## 本次资料摘要\n\n"):
+        return _readable_sections(text.split("\n\n", 1)[1])
+    if not text.startswith("## 资料要点摘编（自动整理）\n"):
+        return text
+    marker = "\n\n### 本轮资料中的要点\n\n"
+    if marker not in text:
+        return "本版未保留可独立阅读的资料摘录，请从下方来源资料查看原文。"
+    # Current sources follow inherited versions and have unescaped headings.
+    body = text.rsplit(marker, 1)[1].split("\n\n### 使用边界\n", 1)[0].strip()
+    return _readable_sections(body)
+
+
+def _extractive(category: dict, selected: list[tuple[dict, str]], previous_text: str) -> str:
+    # A fallback is an excerpt of this batch, never a cumulative summary.
+    # History retains earlier knowledge; recursively quoting it corrupts both
+    # readability and provenance because inherited citations are no longer live.
+    lines = ["## 本次资料摘要"]
+    for source, excerpt in selected:
+        lines += ["### " + _quote(source["name"]) + "（" + _quote(str(source["date"] or "日期未记录")) + "）",
+                  "> " + _quote(_bounded(excerpt, 600)).replace("\n", "\n> "), "来源： [" + source["id"] + "]"]
+    return readable_extractive("\n\n".join(lines))
+
+
+def _seal_reused(engine, context: dict, category_id: str, record: dict) -> None:
+    record = {**record, "daily_state": {**record["daily_state"], "sealed_date": publication_date(context["settings"])}}
+    engine._write_json(context, f"{category_id}/current.json", record)
+
+
+def _legacy_baseline(engine, saved: dict, nodes: list[dict], complete: bool) -> dict:
+    """Adopt prior full summaries without hashing/reprocessing their old files."""
+    try:
+        cutoff = datetime.fromisoformat(saved["updated_at"].replace("Z", "+00:00")).timestamp()
+    except (ValueError, TypeError, KeyError):
+        cutoff = _now().timestamp()
+    old_sources = {_key(source): source for source in saved.get("sources", [])}
+    seen = {}
+    for node in nodes:
+        key = _key(node)
+        old = old_sources.get(key)
+        signature = old.get("signature") if old else None
+        if isinstance(signature, list) and len(signature) >= 4:
+            unchanged = (node.get("size") == signature[2] and
+                         abs(float(node.get("modified_at", 0)) - float(signature[3]) / 1000000000) < 0.001)
+            seen[key] = _signature(engine, node) if unchanged else ""
+        elif float(node.get("modified_at") or 0) <= cutoff:
+            seen[key] = _signature(engine, node)
+    return {"seen": seen, "baseline_at": cutoff, "baseline_complete": complete, "generation_method": "model"}
+
+
+async def update(engine, user, summarize, category=None, *, authorize=None, context=None) -> dict:
+    context = context or engine._context(user)
+    settings = context["settings"]
+    config = engine.knowledge_catalog.load_config()
+    categories = [engine._category(config, category)] if category else config["categories"]
+    counts = {"updated": 0, "failed": 0, "unchanged": 0, "extractive": 0, "frozen": 0, "reused": 0}
+    results = []
+    model = engine._Model(summarize, context, authorize)
