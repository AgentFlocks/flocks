+});
diff --git a/webui/src/utils/nativeMonitorWorkspace.ts b/webui/src/utils/nativeMonitorWorkspace.ts
new file mode 100644
index 00000000..73de68a9
--- /dev/null
+++ b/webui/src/utils/nativeMonitorWorkspace.ts
@@ -0,0 +1,31 @@
+import type { HubSceneSuite } from '@/api/hub';
+import type { WebUIContractWorkspaceListItem } from '@/api/webuiContractPages';
+
+/** Adapt the native monitoring suite to dev's generic workspace switcher. */
+export function withNativeMonitorWorkspace(
+  workspaces: readonly WebUIContractWorkspaceListItem[],
+  suites: readonly HubSceneSuite[],
+): WebUIContractWorkspaceListItem[] {
+  const suite = suites.find((item) => item.id === 'host-security-monitor');
+  if (!suite?.installedVersion || !suite.workspaceEnabled || suite.state !== 'installed'
+    || suite.workspaceKind !== 'native' || workspaces.some((item) => item.id === suite.id)) {
+    return [...workspaces];
+  }
+  const route = '/suites/host-security-monitor';
+  return [...workspaces, {
+    id: suite.id, suiteId: suite.id, version: suite.installedVersion,
+    title: '安全运营监测', titleEn: 'Security Operations Monitoring',
+    route, icon: 'shield-check', order: 50, enabled: true,
+    placement: 'sceneWorkspace', defaultPageId: 'session',
+    pages: [
+      ['session', '监测对话', 'Monitoring', 'messages-square'],
+      ['mail', '邮件跟进', 'Mail follow-up', 'mail'],
+      ['events', '事件列表', 'Incidents', 'list-filter'],
+      ['dashboard', '总结看板', 'Dashboard', 'layout-dashboard'],
+      ['report', '每日报告', 'Daily reports', 'file-text'],
+    ].map(([id, title, titleEn, icon], order) => ({
+      id, title, titleEn, icon, order, enabled: true, placement: 'workspace',
+      route: `${route}/${id}`, workspaceId: suite.id, buildHash: suite.installedVersion!, buildStatus: 'ready' as const,
+    })),
+  }];
+}
