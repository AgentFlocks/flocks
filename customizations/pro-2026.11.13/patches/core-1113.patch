+    @classmethod
+    def from_dict(cls, properties_dict: t.Dict) -> Properties:
+        expressions = []
+        for key, value in properties_dict.items():
+            property_cls = cls.NAME_TO_PROPERTY.get(key.upper())
+            if property_cls:
+                expressions.append(property_cls(this=convert(value)))
+            else:
