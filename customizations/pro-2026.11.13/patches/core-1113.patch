+
+function nodeKey(source: KnowledgeSource, node: KnowledgeNode): string {
+  return `${source}:${node.root}:${node.path}`;
+}
+
+function visibleNode(node: KnowledgeNode): boolean {
+  return !node.path.split('/').some((part) => part.startsWith('.'));
+}
+
+function filterNodes(nodes: KnowledgeNode[], query: string): KnowledgeNode[] {
+  const normalized = query.trim().toLocaleLowerCase();
+  return nodes.flatMap((node) => {
+    if (!visibleNode(node)) return [];
+    const children = filterNodes(node.children ?? [], query);
+    if (!normalized || node.name.toLocaleLowerCase().includes(normalized) || children.length > 0) {
+      return [{ ...node, children }];
+    }
+    return [];
+  });
+}
+
+function findNode(nodes: KnowledgeNode[], root: string | null, path: string | null): KnowledgeNode | null {
+  if (!path) return null;
+  for (const node of nodes) {
+    if (node.path === path && (!root || node.root === root)) return node;
+    const child = findNode(node.children ?? [], root, path);
+    if (child) return child;
+  }
+  return null;
+}
+
+function extension(name: string): string {
+  const index = name.lastIndexOf('.');
+  return index < 0 ? '' : name.slice(index + 1).toLocaleLowerCase();
+}
+
+function prettyJson(content: string): string {
+  try {
+    return JSON.stringify(JSON.parse(content), null, 2);
+  } catch {
+    return content;
+  }
+}
+
+function parseCsv(content: string): string[][] {
+  const rows: string[][] = [];
+  let row: string[] = [];
+  let field = '';
+  let quoted = false;
+  for (let index = 0; index < content.length; index += 1) {
+    const character = content[index];
+    const next = content[index + 1];
+    if (character === '"') {
+      if (quoted && next === '"') {
+        field += '"';
+        index += 1;
+      } else {
+        quoted = !quoted;
+      }
+    } else if (character === ',' && !quoted) {
+      row.push(field);
+      field = '';
+    } else if ((character === '\n' || character === '\r') && !quoted) {
+      if (character === '\r' && next === '\n') index += 1;
+      row.push(field);
+      rows.push(row);
+      row = [];
+      field = '';
+    } else {
+      field += character;
+    }
+  }
+  if (field || row.length > 0) {
+    row.push(field);
+    rows.push(row);
+  }
+  return rows;
+}
+
+function FileTypeIcon({ node }: { node: KnowledgeNode }) {
+  if (node.type === 'directory') return <Folder className="h-4 w-4 text-amber-500" />;
+  if (['png', 'jpg', 'jpeg', 'gif', 'webp'].includes(extension(node.name))) {
+    return <FileImage className="h-4 w-4 text-violet-500" />;
+  }
+  if (node.is_text_file) return <FileText className="h-4 w-4 text-sky-600" />;
+  return <File className="h-4 w-4 text-zinc-400" />;
+}
