+        old?.kind === "sent" && old.record.id === notice.id
+          ? { ...old, record: { ...old.record, ...result.data } }
+          : old,
+      );
+      setRetryMessages((old) => ({
+        ...old,
+        [notice.id]:
+          result.data.state === "sent" ? "邮件已发送。" : "发送结果已更新。",
+      }));
+      if (result.data.error)
