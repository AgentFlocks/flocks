+
+            target = self.sql(expression, "target")
+            target = f" {target}" if target else ""
+            if expression.name in ("COLUMNS", "INDEX"):
+                target = f" FROM{target}"
+            elif expression.name == "GRANTS":
+                target = f" FOR{target}"
+            elif expression.name in ("LINKS", "PARTITIONS"):
