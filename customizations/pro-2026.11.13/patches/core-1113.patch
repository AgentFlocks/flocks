+class Table(Expression):
+    arg_types = {
+        "this": False,
+        "alias": False,
+        "db": False,
+        "catalog": False,
+        "laterals": False,
+        "joins": False,
+        "pivots": False,
+        "hints": False,
+        "system_time": False,
