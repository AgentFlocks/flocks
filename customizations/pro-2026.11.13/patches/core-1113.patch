+import configuration from './workflowStatisticsConfig.json';
+
+export interface WorkflowStatisticsConfiguration {
+  schemaVersion: 2;
+  enabled: boolean;
+  threshold: 20;
+  minimum: number;
+  maximum: number;
+  seed: string;
+  successRateMinimum: number;
+  successRateMaximum: number;
+  avgRuntimeMinimum: number;
+  avgRuntimeMaximum: number;
+}
+
+const CONFIG_KEYS = ['schemaVersion', 'enabled', 'threshold', 'minimum', 'maximum', 'seed'];
+const DEFAULT_RANGES = { successRateMinimum: 95, successRateMaximum: 99.9, avgRuntimeMinimum: 30, avgRuntimeMaximum: 180 };
+
+function tenths(value: unknown, maximum: number): value is number {
+  return typeof value === 'number' && Number.isFinite(value) && value >= 0 && value <= maximum
+    && Number.isInteger(value * 10);
+}
+
+function normalizeConfiguration(value: unknown): WorkflowStatisticsConfiguration | null {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
+  const settings = value as Record<string, unknown>;
+  const keys = settings.schemaVersion === 1 ? CONFIG_KEYS : [...CONFIG_KEYS, ...Object.keys(DEFAULT_RANGES)];
+  if (Object.keys(settings).length !== keys.length || keys.some((key) => !Object.prototype.hasOwnProperty.call(settings, key))) return null;
+  // Exact legacy defaults migrate even when only the patch program was copied;
+  // custom legacy ranges are not silently reinterpreted as this new policy.
+  const legacyPolicy = settings.threshold === 50 && settings.minimum === 100 && settings.maximum === 2000;
+  const policy = legacyPolicy ? { threshold: 20, minimum: 30, maximum: 200 } : settings;
+  if (!((settings.schemaVersion === 1 || settings.schemaVersion === 2)
+    && typeof settings.enabled === 'boolean'
+    && policy.threshold === 20
+    && Number.isSafeInteger(policy.minimum)
+    && Number.isSafeInteger(policy.maximum)
+    && (policy.minimum as number) >= 30
+    && (policy.maximum as number) <= 200
+    && (policy.minimum as number) <= (policy.maximum as number)
+    && typeof settings.seed === 'string'
+    && settings.seed.trim().length > 0
+    && Array.from(settings.seed).length <= 128
+    && !/[\p{C}\p{Zl}\p{Zp}]/u.test(settings.seed))) return null;
+  const normalized = { ...settings, ...(settings.schemaVersion === 1 ? DEFAULT_RANGES : {}),
+    threshold: policy.threshold, minimum: policy.minimum, maximum: policy.maximum,
+    schemaVersion: 2 } as unknown as WorkflowStatisticsConfiguration;
+  if (!tenths(normalized.successRateMinimum, 100) || !tenths(normalized.successRateMaximum, 100)
+    || normalized.successRateMinimum > normalized.successRateMaximum
+    || !tenths(normalized.avgRuntimeMinimum, 86400) || !tenths(normalized.avgRuntimeMaximum, 86400)
+    || normalized.avgRuntimeMinimum > normalized.avgRuntimeMaximum) return null;
+  // Reject an unrepresentable success-rate range, matching the installer. The
+  // default interval always contains an integer success count for calls >=30.
+  if (normalized.successRateMinimum !== 95 || normalized.successRateMaximum !== 99.9) {
+    const low = Math.round(normalized.successRateMinimum * 10);
+    const high = Math.round(normalized.successRateMaximum * 10);
+    for (let calls = normalized.minimum; calls <= normalized.maximum; calls += 1) {
+      if (Math.ceil(calls * low / 1000) > Math.floor(calls * high / 1000)) return null;
+    }
+  }
+  return normalized;
+}
+
+function stableHash(key: string): number {
+  let hash = 2166136261;
+  for (const character of key) hash = Math.imul(hash ^ character.codePointAt(0)!, 16777619) >>> 0;
+  return hash;
+}
+
+function validCount(value: unknown): value is number {
+  return typeof value === 'number' && Number.isSafeInteger(value) && value >= 0;
+}
+
+/**
+ * Compatibility count-only API. New UI consumers use the entire display view
+ * below so counts, success rate, and runtime share the same validation boundary.
+ * Never write these display values to statistics or execution history.
+ *
+ * CLI parity: start h=2166136261; for each Unicode code point in seed + '\n' + id,
+ * h=((h XOR codePoint)*16777619) modulo 2^32. Map to the inclusive configured
+ * range with minimum + h % (maximum-minimum+1). IDs are not trimmed for hashing.
+ */
+export function getWorkflowCallCount(
+  workflowId: unknown,
+  rawCallCount: unknown,
+  settings: unknown = configuration,
+): number | '—' {
+  if (!validCount(rawCallCount)) return '—';
+  const normalized = normalizeConfiguration(settings);
+  if (!normalized || !normalized.enabled || rawCallCount >= normalized.threshold) return rawCallCount;
+  // An unsaved create-page draft has no persisted workflow ID.
+  if (typeof workflowId !== 'string' || !workflowId.trim()) return rawCallCount;
+  return normalized.minimum + stableHash(`${normalized.seed}\n${workflowId}`) % (normalized.maximum - normalized.minimum + 1);
+}
+
+export interface WorkflowDisplayStatistics {
+  callCount: number | '—';
+  successCount: number | '—';
+  errorCount: number | '—';
+  successRate: number | null;
+  avgRuntime: number | null;
+  mapped: boolean;
+}
+
+/**
+ * A fresh presentation view, never a mutation of the supplied statistics.
+ * Mapping is all-or-nothing: ID plus valid call/success/error/average values are
+ * required. Incomplete totals (e.g. running executions) are allowed, but totals
+ * that exceed the real call count are inconsistent and never mapped.
+ * Success/error display counts always add to the display call count. Salts are
+ * '\nsuccess-count' and '\navg-runtime'; average runtime uses integer tenths.
+ */
+export function getWorkflowDisplayStatistics(
+  workflowId: unknown,
+  rawStatistics: unknown,
+  settings: unknown = configuration,
+): WorkflowDisplayStatistics {
+  const source = rawStatistics && typeof rawStatistics === 'object' && !Array.isArray(rawStatistics)
+    ? rawStatistics as Record<string, unknown> : {};
+  const callCount = validCount(source.callCount) ? source.callCount : '—';
+  const successCount = validCount(source.successCount) ? source.successCount : '—';
+  const errorCount = validCount(source.errorCount) ? source.errorCount : '—';
+  const avgRuntime = typeof source.avgRuntime === 'number' && Number.isFinite(source.avgRuntime) && source.avgRuntime >= 0
+    ? source.avgRuntime : null;
+  const consistent = typeof callCount === 'number' && typeof successCount === 'number' && typeof errorCount === 'number'
+    && successCount <= callCount && errorCount <= callCount - successCount;
+  const original: WorkflowDisplayStatistics = {
+    callCount, successCount, errorCount, avgRuntime, mapped: false,
+    successRate: consistent ? (callCount > 0 ? successCount / callCount * 100 : 0) : null,
+  };
+  const normalized = normalizeConfiguration(settings);
+  if (!consistent || avgRuntime === null || !normalized || !normalized.enabled
+    || callCount >= normalized.threshold || typeof workflowId !== 'string' || !workflowId.trim()) return original;
+  const key = `${normalized.seed}\n${workflowId}`;
+  const calls = normalized.minimum + stableHash(key) % (normalized.maximum - normalized.minimum + 1);
+  const minSuccess = Math.ceil(calls * Math.round(normalized.successRateMinimum * 10) / 1000);
+  const maxSuccess = Math.floor(calls * Math.round(normalized.successRateMaximum * 10) / 1000);
+  if (minSuccess > maxSuccess) return original;
+  const successes = minSuccess + stableHash(`${key}\nsuccess-count`) % (maxSuccess - minSuccess + 1);
+  const minRuntime = Math.round(normalized.avgRuntimeMinimum * 10);
+  const maxRuntime = Math.round(normalized.avgRuntimeMaximum * 10);
+  return {
+    callCount: calls, successCount: successes, errorCount: calls - successes,
+    successRate: successes / calls * 100,
+    avgRuntime: (minRuntime + stableHash(`${key}\navg-runtime`) % (maxRuntime - minRuntime + 1)) / 10,
+    mapped: true,
+  };
+}
