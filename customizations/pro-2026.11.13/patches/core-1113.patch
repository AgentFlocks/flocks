+                          (attempt_id,) if attempt_id else ()))[0]
+    # Test durable reload, not the Message class's in-memory cache.
+    Message._messages_cache.pop(attempt['session_id'], None)
+    Message._parts_cache.pop(attempt['session_id'], None)
