+def load_settings() -> dict:
+    values = {"maxFileBytes": MAX_FILE_BYTES, "maxInputChars": MAX_INPUT_CHARS,
+              "maxOutputChars": MAX_OUTPUT_CHARS, "maxModelCalls": MAX_MODEL_CALLS,
