@@ -0,0 +1,27 @@
+"""Update policy for a source distribution maintained on its own Git branch."""
+
+from pathlib import Path
+import tomllib
+
+
+SOURCE_BRANCH_UPGRADE_REFUSAL = (
+    "当前为 zw_dev 定制分支，官方发行包升级会覆盖定制内容。"
+    "请在源码目录使用 git pull --ff-only origin zw_dev 更新，随后同步依赖并重建界面。"
+)
+
+
+def _source_root() -> Path:
+    return Path(__file__).resolve().parents[2]
+
+
+def source_update_refusal(source_root: Path | None = None) -> str | None:
+    """Read the source's policy, independently of its checkout's local branch name."""
+    try:
+        root = source_root if source_root is not None else _source_root()
+        project = tomllib.loads((root / "pyproject.toml").read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    customization = project.get("tool", {}).get("flocks", {}).get("customization", {})
+    if customization.get("update-method") == "git":
+        return SOURCE_BRANCH_UPGRADE_REFUSAL
+    return None
