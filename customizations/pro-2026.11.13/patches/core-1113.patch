+            self.assertEqual(report["business_status"], "action_required")
+            self.assertEqual(report["findings"][0]["status"], "pending_verification")
+
+    def test_high_alert_cannot_be_suppressed_by_benign_flag(self):
+        rows = self.sample("custom-soc-alert-fusion")
+        for row in rows:
