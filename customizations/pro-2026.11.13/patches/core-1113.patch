+    original_get = TaskStore.get_execution
+    dispatched = None
+
+    async def register(*args, **kwargs):
+        nonlocal gate
+        gate = kwargs['start_gate']
+        return await original_register(*args, **kwargs)
+
+    async def held_get(execution_id):
+        if asyncio.current_task() is dispatched and not entered.is_set():
+            entered.set()
+            await asyncio.Event().wait()
+        return await original_get(execution_id)
+
+    monkeypatch.setattr(manager, 'run_existing_session', register)
+    monkeypatch.setattr(TaskStore, 'get_execution', held_get)
+    run = AsyncMock(wraps=runtime.run)
