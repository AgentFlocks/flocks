+    async def test_lock_probe_observes_external_file_lock_without_creating_files(self):
+        import fcntl
+        context = self.module._context(self.alice)
+        self.assertFalse(self.module._is_running(context))
+        self.assertFalse((context["workspace"] / context["storage"]).exists())
+        with self.module._directory(context["workspace"], context["storage"], create=True) as directory:
+            fd = os.open("update.lock", os.O_CREAT | os.O_RDWR, 0o600, dir_fd=directory)
+            try:
+                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+                self.assertTrue(self.module._is_running(context))
+                fcntl.flock(fd, fcntl.LOCK_UN)
+                self.assertFalse(self.module._is_running(context))
+            finally:
