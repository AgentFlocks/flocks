+const native = { id: 'host-security-monitor', state: 'installed', installedVersion: '1.16.0', workspaceKind: 'native', workspaceEnabled: true } as HubSceneSuite;
+it('preserves dev workspaces and adds a native monitoring entry with five working routes', () => {
