+        self.assertEqual(self.report(identifier, {"tasks": [base]})["business_status"], "completed")
+
+    def test_closure_report_counts_verified_and_unverified_separately(self):
+        identifier = "custom-soc-closure-report"
+        good = self.sample(identifier, "normal")[0]
