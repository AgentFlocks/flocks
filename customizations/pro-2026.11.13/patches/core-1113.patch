+    if int(os.environ.get('WEB_CONCURRENCY', '1')) != 1:
+        raise ValueError('安全运营监测阶段一仅支持单后端执行进程')
+    if package is not None:
+        MonitoringDeclaration.model_validate_json((Path(package) / 'monitoring.json').read_text())
+
+
