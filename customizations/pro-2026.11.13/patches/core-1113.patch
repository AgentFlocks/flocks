+                await asyncio.wait_for(entered.wait(), timeout=2)
+                first.cancel()
+                await asyncio.sleep(0)
+                first.cancel()
+                await asyncio.sleep(0)
+                self.assertFalse(first.done())
+                source.write_text("第二版巡检记录", encoding="utf-8")
+                self.assertEqual((await self.update())["status"], "running")
+                self.assertEqual(publication_count, 1)
+                release.set()
+                with self.assertRaises(asyncio.CancelledError):
+                    await first
+                old_version = json.loads(self.current_path().read_text())["version"]
+                self.assertEqual((await self.update())["status"], "ready")
+                current = self.current()
