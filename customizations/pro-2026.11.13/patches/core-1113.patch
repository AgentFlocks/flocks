+"""Real SQLite contention and support export; no real mail/device operations."""
+import asyncio
+from contextlib import closing
+import json
+import sqlite3
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import aiosqlite
+import pytest
