+        report = self.report(identifier, {"devices": [abnormal, healthy[1], healthy[0]]})
+        self.assertEqual(report["findings"][0]["status"], "verified_recovered")
+        self.assertEqual(report["business_status"], "completed")
+        for rows in ([abnormal, healthy[0]], [abnormal, healthy[0], healthy[0]]):
+            report = self.report(identifier, {"devices": rows})
+            self.assertEqual(report["business_status"], "action_required")
+        self.clock += timedelta(hours=1)
+        report = self.report(identifier, {"devices": [abnormal, healthy[1], healthy[0]]})
+        self.assertEqual(report["business_status"], "action_required")
+
+    def test_old_or_future_device_observation_cannot_fill_a_fresh_retest_pair(self):
+        identifier = "custom-soc-device-health"
+        abnormal = {**self.sample(identifier)[0], "observed_at": (self.clock - timedelta(days=3)).isoformat()}
+        good = self.sample(identifier, "normal")[0]
