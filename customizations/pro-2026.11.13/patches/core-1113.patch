+import type { ReactNode } from 'react';
+
+/** A real flex box keeps the chat/workflow viewport bounded in every state. */
+export default function TaskExecutionRecord({ failed, children }: { failed: boolean; children: ReactNode }) {
+  if (failed) {
+    return (
+      <details data-testid="task-execution-record" className="mx-6 mt-4 shrink-0 rounded-xl border border-gray-200">
+        <summary className="cursor-pointer px-4 py-3 text-sm font-medium text-gray-700">执行记录</summary>
+        <div className="flex h-[420px] min-h-0 flex-col">{children}</div>
+      </details>
+    );
+  }
+  return (
+    <div data-testid="task-execution-record" className="flex min-h-[240px] flex-1 flex-col">
+      {children}
+    </div>
+  );
+}
