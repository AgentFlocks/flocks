+class Literal(Condition):
+    arg_types = {"this": True, "is_string": True}
+
+    @classmethod
+    def number(cls, number) -> Literal | Neg:
+        expr: Literal | Neg = cls(this=str(number), is_string=False)
+
+        try:
+            to_py = expr.to_py()
+
+            if not isinstance(to_py, str) and to_py < 0:
+                expr.set("this", str(abs(to_py)))
+                expr = Neg(this=expr)
+        except Exception:
+            pass
+
+        return expr
+
+    @classmethod
+    def string(cls, string) -> Literal:
+        return cls(this=str(string), is_string=True)
+
+    @property
+    def output_name(self) -> str:
+        return self.name
+
+    def to_py(self) -> int | str | Decimal:
+        if self.is_number:
+            try:
+                return int(self.this)
+            except ValueError:
+                return Decimal(self.this)
+        return self.this
+
