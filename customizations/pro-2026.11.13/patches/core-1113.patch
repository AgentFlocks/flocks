+async def test_cancel_during_daily_session_preparation_cannot_revive_execution(context, monkeypatch, runtime_cancel):
+    manager = real_dispatch_manager(monkeypatch)
+    entered = asyncio.Event()
+    release = asyncio.Event()
+    original_ensure = runtime.ensure_daily
+
+    async def held_session(*args):
+        prepared = await original_ensure(*args)
+        entered.set()
+        await release.wait()
+        return prepared
+
+    monkeypatch.setattr(runtime, 'ensure_daily', held_session)
+    query = AsyncMock(side_effect=AssertionError('Cancelled execution must not query a device'))
+    monkeypatch.setattr(context.adapter, 'call', query)
+    dispatched = asyncio.create_task(runtime.dispatch(context.execution, context.scheduler, adapter_factory=context.adapter))
+    await asyncio.wait_for(entered.wait(), 3)
+    if runtime_cancel:
+        await TaskManager.cancel_execution(context.execution.id)
+    else:
+        # A persisted cancellation may originate outside this runtime process.
+        await TaskStore.cancel_active_execution(context.execution.id, completed_at=runtime.now(), duration_ms=None,
+                                                error='Cancelled while preparing the daily session')
+        release.set()
+    outcome = await asyncio.gather(dispatched, return_exceptions=True)
+    if runtime_cancel:
+        assert isinstance(outcome[0], asyncio.CancelledError)
+    else:
+        assert outcome[0].status == TaskStatus.CANCELLED
+    assert (await TaskStore.get_execution(context.execution.id)).status == TaskStatus.CANCELLED
+    assert not await rows('SELECT * FROM monitor_attempts')
+    query.assert_not_awaited()
+    assert all(task.done() for task in manager._task_handles.values())
+    assert context.execution.id not in runtime._running
