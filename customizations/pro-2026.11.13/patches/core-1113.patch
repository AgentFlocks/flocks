+    expect(api.testTrigger).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/webui/src/pages/WorkflowDetail/tabs/ManagedManualRun.tsx b/webui/src/pages/WorkflowDetail/tabs/ManagedManualRun.tsx
new file mode 100644
index 00000000..2ec83583
--- /dev/null
+++ b/webui/src/pages/WorkflowDetail/tabs/ManagedManualRun.tsx
@@ -0,0 +1,165 @@
+import { useEffect, useId, useRef, useState } from 'react';
+import { ChevronDown, ChevronRight, Loader2, Play } from 'lucide-react';
+import { workflowAPI, type WorkflowTrigger } from '@/api/workflow';
+import { isManagedCustomWorkflowId } from '@/utils/customSocWorkflow';
+
+export interface ManagedManualRunProps {
+  workflowId: string;
+  trigger: WorkflowTrigger;
+}
+
+type Notice = {
+  kind: 'success' | 'error' | 'uncertain';
+  message: string;
+  executionId?: string;
+  status?: string;
+  duration?: string;
+};
+
+const UNKNOWN_RESULT = '未确认本次执行结果，请到执行历史核对后再操作。本页不会自动重试。';
+const STATUSES: Record<string, string> = {
+  success: '成功', error: '失败', timeout: '超时', cancelled: '已取消', running: '执行中', pending: '等待执行',
+};
+
+function asObject(value: unknown): Record<string, unknown> | null {
+  return value !== null && typeof value === 'object' && !Array.isArray(value)
+    ? value as Record<string, unknown> : null;
+}
+
+function parseInput(text: string): Record<string, unknown> | null {
+  try {
+    if (new TextEncoder().encode(text).byteLength > 1_000_000) return null;
+    const input = asObject(JSON.parse(text));
+    if (!input) return null;
+    // JSON.parse accepts an overflowing numeric literal as Infinity. Reject it
+    // rather than let JSON.stringify silently turn the user's value into null.
+    const pending: unknown[] = [input];
+    while (pending.length) {
+      const value = pending.pop();
+      if (typeof value === 'number' && !Number.isFinite(value)) return null;
+      if (value && typeof value === 'object') {
+        for (const child of Object.values(value)) pending.push(child);
+      }
+    }
+    return input;
+  } catch {
+    return null;
+  }
+}
+
+function executionNotice(value: unknown): Notice {
+  const data = asObject(value);
+  // Native dispatcher replies {ok, matched, executed, result: executionRecord}.
+  // HTTP 200 / ok alone proves neither acceptance nor execution success.
+  if (data?.ok !== true || data.matched !== true || data.executed !== true) {
+    return { kind: 'uncertain', message: UNKNOWN_RESULT };
+  }
+  const execution = asObject(data.result);
+  const status = execution?.status;
+  const id = execution?.id;
+  if (typeof status !== 'string' || !Object.prototype.hasOwnProperty.call(STATUSES, status)
+    || typeof id !== 'string' || !/^[A-Za-z0-9._:-]{1,128}$/.test(id)) {
+    return { kind: 'uncertain', message: UNKNOWN_RESULT };
+  }
+  const summary = {
+    executionId: id,
+    status: STATUSES[status],
+    duration: typeof execution?.duration === 'number' && Number.isFinite(execution.duration) && execution.duration >= 0
+      ? `${execution.duration.toFixed(2)} 秒` : undefined,
+  };
+  if (status === 'success') {
+    if (execution?.errorMessage) return { kind: 'uncertain', message: UNKNOWN_RESULT, ...summary, status: '结果待核对' };
+    return { kind: 'success', message: '本次分析执行成功，业务处置结果请查看执行历史。', ...summary };
+  }
+  if (status === 'running' || status === 'pending') {
+    return { kind: 'uncertain', message: '本次执行尚未完成，请到执行历史查看进度。本页不会自动重试。', ...summary };
+  }
+  return { kind: 'error', message: '本次执行未成功，请到执行历史查看详情。', ...summary };
+}
+
+function requestError(error: unknown): Notice {
+  const status = asObject(asObject(error)?.response)?.status;
+  if (status === 401) return { kind: 'error', message: '登录状态已失效，请重新登录，并核对执行历史。' };
+  if (status === 403) return { kind: 'error', message: '当前账号没有运行权限。' };
+  if (status === 404) return { kind: 'error', message: '未找到手动运行入口，请确认补丁已应用并重启服务。' };
+  if (status === 400 || status === 422) return { kind: 'error', message: '运行请求未被接受，请检查参数格式。' };
+  // Never render raw backend messages, request inputs, response inputs or stacks.
+  return { kind: 'uncertain', message: UNKNOWN_RESULT };
+}
+
+function ManualRunPanel({ workflowId, trigger }: ManagedManualRunProps) {
+  const panelId = useId();
+  const inputId = useId();
+  const [expanded, setExpanded] = useState(false);
+  const [text, setText] = useState('{}');
+  const [running, setRunning] = useState(false);
+  const [notice, setNotice] = useState<Notice | null>(null);
+  const busy = useRef(false);
+  const generation = useRef(0);
+  useEffect(() => () => { generation.current += 1; }, []);
+
+  const run = async () => {
+    if (busy.current || trigger.enabled !== true) return;
+    const body = parseInput(text);
+    if (!body) {
+      setNotice({ kind: 'error', message: '请输入有效的 JSON 对象；不接受数组、非有限数值或超过 1 MB 的内容。' });
+      return;
+    }
+    busy.current = true;
+    setRunning(true);
+    setNotice(null);
+    const requestGeneration = ++generation.current;
+    try {
+      const response = await workflowAPI.testTrigger(workflowId, 'manual-review', { body });
+      if (requestGeneration === generation.current) setNotice(executionNotice(response.data));
+    } catch (error: unknown) {
+      if (requestGeneration === generation.current) setNotice(requestError(error));
+    } finally {
+      if (requestGeneration === generation.current) {
+        busy.current = false;
+        setRunning(false);
+      }
+    }
+  };
+
+  return (
+    <section className="border-t border-gray-100" data-customization-id="workflow.suite.manual-run">
+      <button type="button" aria-label="手动运行" aria-expanded={expanded} aria-controls={panelId}
+        onClick={() => setExpanded((value) => !value)}
+        className="flex w-full items-center gap-2 px-4 py-3 text-left text-xs font-medium text-gray-700 hover:bg-gray-50">
+        {expanded ? <ChevronDown className="h-3.5 w-3.5" /> : <ChevronRight className="h-3.5 w-3.5" />}
+        手动运行
+        {running ? <span className="text-gray-500">运行中…</span> : null}
+      </button>
+      {expanded ? (
+        <div id={panelId} className="space-y-3 px-4 pb-4">
+          <label htmlFor={inputId} className="block text-xs font-medium text-gray-700">运行参数（JSON）</label>
+          <textarea id={inputId} value={text} onChange={(event) => setText(event.target.value)}
+            disabled={running || trigger.enabled !== true} spellCheck={false} rows={5}
+            className="w-full resize-y rounded-lg border border-gray-200 bg-white p-3 font-mono text-xs text-gray-800 focus:border-gray-400 focus:outline-none disabled:bg-gray-50" />
+          <p className="text-xs text-gray-500">默认 {'{}'} 使用内置样本；可提交符合工作流说明的 JSON 参数。运行不会自动重试。</p>
+          {trigger.enabled !== true ? <p className="text-xs text-amber-700">手动入口已停用，请先启用。</p> : null}
+          <button type="button" disabled={running || trigger.enabled !== true} onClick={() => { void run(); }}
+            className="inline-flex items-center gap-1.5 rounded-lg bg-gray-900 px-3 py-2 text-xs font-medium text-white hover:bg-gray-800 disabled:cursor-not-allowed disabled:opacity-50">
+            {running ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <Play className="h-3.5 w-3.5" />}
+            {running ? '运行中…' : '运行一次'}
+          </button>
+          {notice ? (
+            <div role={notice.kind === 'error' ? 'alert' : 'status'}
+              className={`rounded-lg border px-3 py-2 text-xs ${notice.kind === 'success' ? 'border-green-200 bg-green-50 text-green-800' : notice.kind === 'error' ? 'border-red-200 bg-red-50 text-red-700' : 'border-amber-200 bg-amber-50 text-amber-800'}`}>
+              <p>{notice.message}</p>
+              {notice.executionId ? <p className="mt-1 break-all">执行 ID：{notice.executionId}</p> : null}
+              {notice.status ? <p className="mt-1">状态：{notice.status}{notice.duration ? ` · 耗时：${notice.duration}` : ''}</p> : null}
+            </div>
+          ) : null}
+        </div>
+      ) : null}
+    </section>
+  );
+}
+
+export default function ManagedManualRun(props: ManagedManualRunProps) {
+  if (!isManagedCustomWorkflowId(props.workflowId) || props.trigger.id !== 'manual-review' || props.trigger.type !== 'manual') return null;
+  // A different workflow/trigger gets a fresh input and request generation.
+  return <ManualRunPanel key={`${props.workflowId}:${props.trigger.id}:${props.trigger.type}`} {...props} />;
+}
