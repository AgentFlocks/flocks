+    expect(screen.getByRole('button', { name: '运行中…' })).toBeDisabled();
+    expect(screen.getByRole('textbox')).toBeDisabled();
+    await act(async () => pending.resolve(response()));
+    expect(screen.getByRole('button', { name: '运行一次' })).toBeEnabled();
+  });
+
+  it.each(['error', 'timeout', 'cancelled'])('HTTP200/ok=true不能将%s执行冒充成功', async (status) => {
+    api.testTrigger.mockResolvedValue(response(status, { inputs: { password: 'PRIVATE' }, result: {
+      id: 'exec-failed', status, duration: 0, errorMessage: 'PRIVATE stack traceback', outputResults: { secret: 'PRIVATE' },
+    } }));
+    render(<ManagedManualRun workflowId={ids[0]} trigger={trigger} />);
+    await open();
+    await run();
+    expect(screen.getByRole('alert')).toHaveTextContent('本次执行未成功');
+    expect(screen.getByRole('alert')).not.toHaveTextContent('PRIVATE');
+    expect(screen.queryByText(/本次分析执行成功/)).not.toBeInTheDocument();
+  });
+
+  it.each([
+    { ok: true }, { ok: false, matched: true, executed: true }, { matched: false }, { executed: false },
+    { result: null }, { result: { status: 'success' } }, { result: { id: 'exec-1', status: 'unknown-private-value' } },
+    { result: { id: '<script>', status: 'success' } }, { result: { id: 'exec-1', status: 'success', errorMessage: 'PRIVATE' } },
+  ])('未接收或不完整响应不显示成功：%j', async (overrides) => {
+    api.testTrigger.mockResolvedValue(Object.keys(overrides).length === 1 && 'ok' in overrides ? { data: overrides } : response('success', overrides));
+    render(<ManagedManualRun workflowId={ids[0]} trigger={trigger} />);
+    await open();
+    await run();
+    expect(screen.getByRole('status')).toHaveTextContent('未确认本次执行结果');
+    expect(screen.getByRole('status')).not.toHaveTextContent('PRIVATE');
+    expect(screen.queryByText(/本次分析执行成功/)).not.toBeInTheDocument();
+    expect(api.testTrigger).toHaveBeenCalledTimes(1);
+  });
+
+  it.each(['running', 'pending'])('非终态%s仅提示查看执行历史', async (status) => {
+    api.testTrigger.mockResolvedValue(response(status));
+    render(<ManagedManualRun workflowId={ids[0]} trigger={trigger} />);
+    await open();
+    await run();
+    expect(screen.getByRole('status')).toHaveTextContent('尚未完成');
+    expect(screen.queryByText(/本次分析执行成功/)).not.toBeInTheDocument();
+  });
+
+  it.each([401, 403, 404, 422, 500, undefined])('请求错误%s使用安全概括且不自动重试', async (status) => {
+    api.testTrigger.mockRejectedValue({ message: 'PRIVATE stack', response: { status, data: { message: 'PRIVATE data' } } });
+    render(<ManagedManualRun workflowId={ids[0]} trigger={trigger} />);
+    await open();
+    await run();
+    expect(screen.queryByText(/PRIVATE/)).not.toBeInTheDocument();
+    expect(api.testTrigger).toHaveBeenCalledTimes(1);
+    expect(screen.getByRole('button', { name: '运行一次' })).toBeEnabled();
+    expect(screen.queryByText(/本次分析执行成功/)).not.toBeInTheDocument();
+  });
+
+  it('切换工作流清空参数并忽略旧请求，不能覆盖新页面结果', async () => {
+    const oldRequest = deferred();
