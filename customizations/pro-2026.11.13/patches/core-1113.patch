+        result = await self.update()
+        self.assertEqual(result["status"], "ready")
+        self.assertEqual(result["calls"], 1)
+        current = self.current()
+        self.assertEqual(current["daily"]["sample_count"], 5)
+        self.assertEqual(current["daily"]["available_count"], 10)
+        self.assertEqual(current["daily"]["pending_count"], 0)
+        self.assertTrue(current["daily"]["locked"])
+        self.assertEqual([source["date"] for source in current["sources"]], [f"2026-09-{index:02d}" for index in range(10, 5, -1)])
+        files[-1].unlink()
+        files[-2].write_text("修改后的内容", encoding="utf-8")
+        self.source("2026-09-11/巡检新增.md")
+        with patch.object(self.module, "_scan", side_effect=AssertionError("must not rescan frozen day")), \
+             patch.object(self.daily, "_excerpt", side_effect=AssertionError("must not reread sources")), \
+             patch.object(self.module, "_source_state", side_effect=AssertionError("must not rehash sources")):
