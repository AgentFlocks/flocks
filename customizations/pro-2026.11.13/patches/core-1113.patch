+  expect(items[0].pages.map((page) => page.route)).toContain('/suites/host-security-monitor/events');
+  expect(resolveNavRoute('/suites/host-security-monitor/session', items)).toEqual({ kind: 'workspace', workspace: 'scene:host-security-monitor' });
