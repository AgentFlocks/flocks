+def qualify_tables(
+    expression: E,
+    db: t.Optional[str | exp.Identifier] = None,
+    catalog: t.Optional[str | exp.Identifier] = None,
+    on_qualify: t.Optional[t.Callable[[exp.Table], None]] = None,
