+        target_precision = min(current_precision, max_precision)
+    else:
+        target_precision = max_precision
+
+    return exp.DataType(
+        this=expression.this,
+        expressions=[exp.DataTypeParam(this=exp.Literal.number(target_precision))],
+    )
