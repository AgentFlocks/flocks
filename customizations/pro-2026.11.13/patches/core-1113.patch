+    original_update = TaskStore.update_active_execution
+
+    async def cancel_before_update(execution):
+        assert execution.status == TaskStatus.COMPLETED
+        await TaskStore.cancel_active_execution(execution.id, completed_at=runtime.now(), duration_ms=None,
+                                                error='Cancelled before final result persistence')
+        return await original_update(execution)
+
+    monkeypatch.setattr(TaskStore, 'update_active_execution', cancel_before_update)
+    outcome = await runtime.dispatch(context.execution, context.scheduler, adapter_factory=context.adapter)
+    assert outcome.status == TaskStatus.CANCELLED
+    saved = await TaskStore.get_execution(context.execution.id)
+    assert saved.status == TaskStatus.CANCELLED and saved.error == 'Cancelled before final result persistence'
+    assert all(task.done() for task in manager._task_handles.values())
+    assert context.execution.id not in runtime._running
