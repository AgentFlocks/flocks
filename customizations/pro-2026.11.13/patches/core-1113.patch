+"""Native HTTP/manual dispatch integration; store/hooks/config isolated, real DAG runs.
+
+These tests mount the unchanged workflow router without production middleware;
+they verify trigger plumbing, not changes to the application's login policy.
+All reports and settings are confined to a disposable monkeypatched home.
+"""
+from __future__ import annotations
+
+import importlib.util
+import json
+import logging
+import os
+import sys
+import tempfile
+import unittest
+from datetime import datetime, timezone
+from pathlib import Path
+from unittest.mock import AsyncMock, patch
+
+BASE = Path(__file__).resolve().parents[2]
+REPO = str(Path(__file__).resolve().parents[2])
+
+
+@unittest.skipUnless(REPO, "Requires Flocks runtime")
+class WorkflowSuiteNativeTriggerTests(unittest.TestCase):
+    def setUp(self):
+        from fastapi import FastAPI
+        from fastapi.testclient import TestClient
+        from flocks.server.routes import workflow as routes
+        from flocks.workflow import fs_store, runner
+        from flocks.workflow.triggers import runtime
+        from flocks.hooks.execution import _noop_stage
+
+        temporary = tempfile.TemporaryDirectory(prefix="flocks-suite-trigger-test-")
+        self.addCleanup(temporary.cleanup)
+        self.home = Path(temporary.name).resolve()
+        self.routes = routes
+        self.runtime = runtime
+        spec = importlib.util.spec_from_file_location("flocks.workflow.custom_soc_suite", BASE / "flocks/workflow/custom_soc_suite.py")
+        self.module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(self.module)
+        settings = self.home / "settings.json"
+        settings.write_text('{"schemaVersion":1,"ownerName":"测试值班组","emailDisplay":"ops@example.invalid"}', encoding="utf-8")
+
+        def patched(*args, **kwargs):
+            handle = patch(*args, **kwargs)
+            result = handle.start()
+            self.addCleanup(handle.stop)
+            return result
+
+        handle = patch.dict(sys.modules, {"flocks.workflow.custom_soc_suite": self.module})
+        handle.start()
+        self.addCleanup(handle.stop)
+        patched("flocks.workflow.custom_soc_suite.SETTINGS_PATH", settings)
+        patched("flocks.workflow.custom_soc_suite.Path.home", return_value=self.home)
+        patched("flocks.workflow.custom_soc_suite._now", return_value=datetime(2026, 9, 14, 1, 2, tzinfo=timezone.utc))
+        roots = [(BASE / ".flocks/plugins/workflows", "project")]
+        patched("flocks.workflow.fs_store.workflow_scan_dirs", return_value=roots)
+        patched("flocks.server.routes.workflow._all_scan_dirs", return_value=roots)
+        patched("flocks.server.routes.workflow._migrate_storage_to_filesystem", new=AsyncMock())
+        patched("flocks.workflow.store.WorkflowStore.get_stats", new=AsyncMock(return_value=None))
+        patched("flocks.workflow.runner.get_tool_registry", return_value=object())
+        patched("flocks.workflow.runner._load_config_data", return_value={"sandbox": {"mode": "off"}})
+        patched("flocks.workflow.runner._ensure_logging_configured", return_value=None)
+        for name in ("flocks.workflow.engine", "flocks.workflow.runner"):
+            logger = logging.getLogger(name)
+            previous_level = logger.level
+            logger.setLevel(logging.CRITICAL)
+            self.addCleanup(lambda current=logger, previous=previous_level: current.setLevel(previous))
+        patched("flocks.workflow.triggers.runtime.build_workflow_tool_context", new=AsyncMock(return_value=None))
+        patched("flocks.workflow.triggers.runtime.cleanup_workflow_tool_context", new=AsyncMock())
+        patched("flocks.hooks.pipeline.HookPipeline.run_ingress_before", new=_noop_stage)
+        patched("flocks.hooks.pipeline.HookPipeline.run_ingress_after", new=_noop_stage)
+        self.records = []
+
+        async def create(workflow_id, *, input_params):
+            return {"id": f"isolated-{len(self.records)}", "workflowId": workflow_id, "inputParams": input_params}
+
+        async def record(workflow_id, execution_id, data, *, steps=None):
+            # Older native releases keep steps in executionLog; newer releases
+            # pass the separate compact step collection by keyword.
+            self.records.append({"workflow_id": workflow_id, "execution_id": execution_id, "data": data,
+                                 "steps": steps if steps is not None else data.get("executionLog", [])})
+
+        self.create_record = patched("flocks.workflow.triggers.runtime.create_execution_record", new=AsyncMock(side_effect=create))
+        patched("flocks.workflow.triggers.runtime.record_execution_result", new=AsyncMock(side_effect=record))
+        for target in ("socket.create_connection", "urllib.request.urlopen", "smtplib.SMTP", "smtplib.SMTP_SSL", "subprocess.run", "subprocess.Popen"):
+            patched(target, side_effect=AssertionError("external side effect forbidden"))
+        self.native_runtime = runtime.TriggerRuntime()
+        patched("flocks.server.routes.workflow.default_trigger_runtime", self.native_runtime)
+        self.runner_results = []
+
+        def observe_runner(**kwargs):
+            result = runner.run_workflow(**kwargs)
+            self.runner_results.append(result)
+            return result
+
+        self.runner_spy = patched("flocks.workflow.triggers.runtime.run_workflow", side_effect=observe_runner)
+        app = FastAPI()
+        app.include_router(routes.router, prefix="/api")
+        self.client = TestClient(app)
+        self.addCleanup(self.client.close)
+
+    def execute(self, identifier, body):
+        before = set(self.home.rglob("*"))
+        response = self.client.post(f"/api/workflow/{identifier}/triggers/manual-review/test", json={"body": body})
+        self.generated_paths = sorted(str(path) for path in set(self.home.rglob("*")) - before if path.is_file())
+        self.assertEqual(response.status_code, 200, response.text)
+        data = response.json()
+        self.assertTrue(data["executed"])
+        self.assertTrue(data["matched"])
+        return data["result"]
+
+    def published_report(self, result):
+        # Native execution-store responses intentionally compact nested values.
+        # Validate full provenance from the actual final-node JSON artifact.
+        path = next(Path(value) for value in self.output_paths(result) if value.endswith(".json"))
+        self.assertTrue(path.is_relative_to(self.home / ".flocks/workspace/outputs"))
+        return json.loads(path.read_text(encoding="utf-8"))
+
+    def output_paths(self, result):
+        summarized = result["outputResults"]["output_files"]
+        if isinstance(summarized, dict):
+            self.assertEqual(summarized["count"], 2)
+        # Both native high-frequency engine output and API output are summarized.
+        # Observe newly created artifacts in this disposable home, never infer a
+        # full filesystem path from a potentially truncated response preview.
+        self.assertEqual(self.records[-1]["execution_id"], result["id"])
+        # Only newer native dispatchers bind the engine run ID to the API's
+        # execution ID. Older dispatchers legitimately generate a separate ID.
+        if "run_id" in self.runner_spy.call_args.kwargs:
+            self.assertEqual(self.runner_results[-1].run_id, result["id"])
+        else:
+            self.assertTrue(self.runner_results[-1].run_id)
+        paths = self.generated_paths
+        self.assertEqual(len(paths), 2)
+        return paths
+
+    def test_native_scan_keeps_project_storage_and_seven_active_ready_manual_triggers(self):
+        response = self.client.get("/api/workflow")
+        self.assertEqual(response.status_code, 200, response.text)
+        rows = response.json()
+        rows = [row for row in rows if row["id"].startswith("custom-soc-")]
+        self.assertEqual({row["id"] for row in rows}, set(self.module.WORKFLOWS))
+        for row in rows:
+            self.assertEqual(row["source"], "project", "UI grouping must not change physical storage source")
+            self.assertEqual(row["status"], "active")
+            response = self.client.get(f'/api/workflow/{row["id"]}/triggers')
+            self.assertEqual(response.status_code, 200, response.text)
+            triggers = response.json()
+            self.assertEqual(len(triggers), 1)
+            self.assertEqual(triggers[0]["trigger"]["type"], "manual")
+            self.assertTrue(triggers[0]["trigger"]["enabled"])
+            self.assertEqual(triggers[0]["status"]["state"], "ready")
+        self.create_record.assert_not_awaited()
+        self.assertEqual(self.native_runtime._custom_adapter_tasks, {})
+        self.assertFalse((self.home / ".flocks").exists(), "installation/listing must not execute")
+
+    def test_all_seven_native_trigger_routes_execute_real_runner_and_three_branches(self):
+        for identifier in self.module.WORKFLOWS:
+            for scenario in ("risk", "normal", "insufficient"):
+                with self.subTest(identifier=identifier, scenario=scenario):
+                    result = self.execute(identifier, {} if scenario == "risk" else {"scenario": scenario})
+                    self.assertEqual(result["status"], "success", result.get("errorMessage"))
+                    self.assertEqual(result.get("stepCount", result.get("currentStepIndex")), 7)
+                    self.assertEqual(self.runner_results[-1].steps, 7)
+                    self.assertEqual(result["triggerId"], "manual-review")
+                    self.assertEqual(result["triggerType"], "manual")
+                    self.assertEqual(result["outputResults"]["report"]["branch"], scenario)
+                    report = self.published_report(result)
+                    self.assertEqual(report["branch"], scenario)
+                    self.assertEqual(report["metadata"]["data_origin"], "builtin_synthetic")
+                    self.assertEqual(report["notification"]["status"], "not_sent")
+                    self.assertNotIn("_flocks", json.dumps(report))
+                    for path in self.output_paths(result):
+                        output = Path(path)
+                        self.assertTrue(output.is_relative_to(self.home / ".flocks/workspace/outputs"))
+                        self.assertTrue(output.is_file())
+        self.assertEqual(self.runner_spy.call_count, 21)
+        self.assertEqual(len(self.records), 21)
+
+    def test_native_mapping_preserves_explicit_empty_and_real_supplied_data(self):
+        for identifier, (_, dataset, kind) in self.module.WORKFLOWS.items():
+            with self.subTest(identifier=identifier):
+                empty = self.execute(identifier, {dataset: []})
+                self.assertEqual(empty["status"], "success", empty.get("errorMessage"))
+                report = self.published_report(empty)
+                self.assertEqual(report["branch"], "insufficient")
+                self.assertEqual(report["metadata"]["data_origin"], "user_provided_unverified")
+                self.assertEqual(report["quality"]["valid_count"], 0)
+        identifier = "custom-soc-ndr-egress"
+        rows = self.module._samples("egress", "normal", self.module._now())
+        result = self.execute(identifier, {"sessions": rows})
+        self.assertEqual(result["outputResults"]["report"]["branch"], "normal")
+        self.assertEqual(self.published_report(result)["metadata"]["data_origin"], "user_provided_unverified")
+
+    def test_native_invalid_event_body_does_not_fall_back_or_write_reports(self):
+        for body in (None, [], "normal", {"scenario": None}, {"output_path": "/private/no-write"}, {"_flocks": {"owner_id": "admin"}}):
+            with self.subTest(body_type=type(body).__name__):
+                result = self.execute("custom-soc-ndr-egress", body)
+                self.assertEqual(result["status"], "error")
+                self.assertTrue(result["errorMessage"])
+                self.assertNotIn("output_files", result.get("outputResults", {}))
+        self.assertFalse((self.home / ".flocks").exists())
+
+    def test_native_preview_is_read_only_and_keeps_whole_body(self):
+        body = {"sessions": []}
+        response = self.client.post("/api/workflow/custom-soc-ndr-egress/triggers/manual-review/preview-mapping", json={"body": body})
+        self.assertEqual(response.status_code, 200, response.text)
+        mapped = response.json()["inputs"]
+        self.assertEqual(mapped["suite_inputs"], body)
+        self.assertEqual(mapped["_trigger"], "manual")
+        self.assertEqual(mapped["_flocks"]["trigger"]["type"], "manual")
+        self.create_record.assert_not_awaited()
+        self.assertFalse((self.home / ".flocks").exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
