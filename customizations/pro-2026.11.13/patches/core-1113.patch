+def _safe_diagnostics(value: Any) -> dict:
+    if not isinstance(value, dict):
+        return {}
+    code, stage = value.get("error_code"), value.get("stage")
+    result = {"error_code": code if isinstance(code, str) and code in _ERROR_CODES else "knowledge_operation_failed"}
+    if isinstance(stage, str) and stage in _STAGES:
+        result["stage"] = value["stage"]
+    source_id = value.get("source_id")
+    if isinstance(source_id, str) and _SOURCE_ID.fullmatch(source_id):
+        result["source_id"] = source_id
+    for key in ("prompt_chars", "calls"):
+        if type(value.get(key)) is int and 0 <= value[key] <= 10000000:
+            result[key] = value[key]
+    validation_code = value.get("last_validation_error_code")
+    if isinstance(validation_code, str) and validation_code in {"model_output_invalid", "model_output_incomplete", "model_citation_invalid", "model_output_unsafe"}:
+        result["last_validation_error_code"] = value["last_validation_error_code"]
+    return result
