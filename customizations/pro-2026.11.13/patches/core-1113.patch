+CONFIG = PROJECT / "flocks/server/routes/knowledge_categories.json"
+
+
+class CatalogTests(unittest.TestCase):
+    def setUp(self):
+        self.config = catalog.load_config(CONFIG)
+        catalog._CACHE.clear()
+
+    def test_business_rules_and_priority(self):
+        cases = {
+            "manual-review/manual_review_alerts_20260910_1800.md": ("alert-denoise", "review"),
+            "artifacts/stream_alert_triage_summary.md": ("alert-denoise", "summary"),
+            "四季青_防火墙巡检报告.md": ("device-inspection", "firewall"),
+            "cnki_device_inspection_report.md": ("device-inspection", "other"),
+            "ti_analysis_batch_ip_report.md": ("threat-intel", "batch"),
+            "ndr_analysis_ssrf_report.md": ("network-analysis", "web"),
+            "Win_Forensic_10.1.2.3_研判报告.md": ("host-forensics", "windows"),
+            "batch_host_triage_index.md": ("host-security", "batch"),
+            "port_scanner/open_ports.json": ("asset-mapping", "ports"),
+            "js-audit/audit-report.md": ("web-security", "javascript"),
+            "SQL注入复测报告.md": ("verification", "sqli"),
