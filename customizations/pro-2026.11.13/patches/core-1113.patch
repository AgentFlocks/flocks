+"""Keep a request workspace's old Hub from hiding the active source's suites."""
+import json
+from pathlib import Path
+import shutil
+
+import pytest
+
+from flocks.hub import catalog, paths
+from flocks.project.instance import Instance
+from flocks.server.routes.hub import _load_scene_suites
+
+
+SOURCE_HUB = Path(__file__).resolve().parents[2] / '.flocks/flockshub'
+
+
+def _bundle(root, *, old=False):
+    root.mkdir(parents=True)
+    index = json.loads((SOURCE_HUB / 'index.json').read_text())
+    index['plugins'] = [entry for entry in index['plugins']
+                        if entry['type'] == 'component' or entry['id'] in {'soc_ui', 'security-monitor'}]
+    if old:
+        index['plugins'] = [entry for entry in index['plugins'] if entry['id'] not in {'host-security-monitor', 'security-monitor'}]
+    for entry in index['plugins']:
+        manifest = json.loads((SOURCE_HUB / entry['manifestPath']).read_text())
+        if old and entry['id'] in {'soc-workspace', 'soc_ui'}:
+            entry['version'] = manifest['version'] = '1.0.1'
+        destination = root / entry['manifestPath']
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        destination.write_text(json.dumps(manifest))
+    (root / 'index.json').write_text(json.dumps(index))
+    shutil.copy2(SOURCE_HUB / 'taxonomy.json', root / 'taxonomy.json')
+    return root
+
+
+@pytest.fixture()
+def competing_hubs(isolated_hub_env, tmp_path, monkeypatch):
+    source = tmp_path / 'active-source'
+    active = _bundle(source / '.flocks/flockshub')
+    project = isolated_hub_env['project_dir']
+    old = _bundle(project / '.flocks/flockshub', old=True)
+    monkeypatch.delenv('FLOCKS_HUB_ROOT', raising=False)
+    monkeypatch.setenv('FLOCKS_REPO_ROOT', str(source))
+    monkeypatch.setattr(Instance, 'get_directory', classmethod(lambda cls: str(project)))
+    catalog.clear_catalog_caches()
+    yield source, active, project, old
+    catalog.clear_catalog_caches()
+
+
+def test_scene_api_uses_active_source_suites_over_old_request_workspace(competing_hubs):
+    _, active, _, old = competing_hubs
+    assert paths.get_bundled_hub_root() == active
+    suites = {entry.id: entry for entry in _load_scene_suites()}
+    assert set(suites) == {'host-security-monitor', 'soc-workspace'}
+    assert suites['host-security-monitor'].version == '1.17.0'
+    assert suites['host-security-monitor'].edition == 'oss'
+    assert suites['host-security-monitor'].workspaceKind == 'native'
+    assert suites['soc-workspace'].version == '1.0.7'
