--- /dev/null
+++ b/webui/src/components/common/MonitoringViewport.test.tsx
@@ -0,0 +1,84 @@
+import { act, fireEvent, render, screen } from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { createRef } from 'react';
+import { MonitoringDeferredDetails, MonitoringMessageViewport, MonitoringViewportContext } from './MonitoringViewport';
+
+const callbacks = new Map<Element, IntersectionObserverCallback>();
+function installObservers() {
+  vi.stubGlobal('IntersectionObserver', class {
+    target?: Element;
+    constructor(private callback: IntersectionObserverCallback) {}
+    observe(target: Element) { this.target = target; callbacks.set(target, this.callback); }
+    disconnect() { if (this.target) callbacks.delete(this.target); }
+  });
+}
+function visibility(target: Element, visible: boolean) {
+  act(() => callbacks.get(target)?.([{ target, isIntersecting: visible } as IntersectionObserverEntry], {} as IntersectionObserver));
+}
+const root = createRef<HTMLDivElement>();
+afterEach(() => { vi.unstubAllGlobals(); callbacks.clear(); });
+
+describe('monitoring viewport', () => {
+  it('keeps only near-screen bodies while retaining lightweight anchors for 500 messages', () => {
+    installObservers();
+    const body = vi.fn((id: number) => <span>record {id}</span>);
+    function Body({ id }: { id: number }) { return body(id); }
+    const { container } = render(<MonitoringViewportContext.Provider value={{ root, active: true }}>
+      {Array.from({ length: 500 }, (_, id) => <MonitoringMessageViewport key={id} id={String(id)} active={id === 499}><Body id={id} /></MonitoringMessageViewport>)}
+    </MonitoringViewportContext.Provider>);
+    expect(body).toHaveBeenCalledTimes(1);
+    expect(container.querySelectorAll('[data-message-id]')).toHaveLength(500);
+    const message = container.querySelector('[data-message-id="250"]')!;
+    visibility(message, true);
+    expect(screen.getByText('record 250')).toBeInTheDocument();
+    visibility(message, false);
+    expect(screen.queryByText('record 250')).not.toBeInTheDocument();
+    expect(screen.getByText('record 499')).toBeInTheDocument();
+    expect(container.querySelectorAll('[data-monitor-placeholder]')).toHaveLength(499);
+  });
+
+  it('does not build closed details and keeps their expansion through viewport eviction', () => {
+    installObservers();
+    const body = vi.fn(() => <pre>large packet</pre>);
+    const { container } = render(<MonitoringViewportContext.Provider value={{ root, active: true }}>
+      <MonitoringMessageViewport id="packet" active={false}><MonitoringDeferredDetails cacheKey="evidence" summary="packet details" renderBody={body} /></MonitoringMessageViewport>
+    </MonitoringViewportContext.Provider>);
+    const message = container.querySelector('[data-message-id]')!;
+    visibility(message, true);
+    expect(body).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByText('packet details'));
+    expect(screen.getByText('large packet')).toBeInTheDocument();
+    visibility(message, false);
+    expect(screen.queryByText('large packet')).not.toBeInTheDocument();
+    visibility(message, true);
+    expect(screen.getByText('large packet')).toBeInTheDocument();
+    expect(container.querySelector('details')).toHaveAttribute('open');
+  });
+
+  it('retains measured placeholder height, ignores hidden-tab resize and disconnects observers', () => {
+    installObservers();
+    let resize: (() => void) | undefined;
+    vi.stubGlobal('ResizeObserver', class { constructor(callback: () => void) { resize = callback; } observe() {} disconnect() {} });
+    const children = <MonitoringMessageViewport id="a" active={false}><p>message</p></MonitoringMessageViewport>;
+    const { container, rerender } = render(<MonitoringViewportContext.Provider value={{ root, active: true }}>{children}</MonitoringViewportContext.Provider>);
+    const node = container.querySelector('[data-message-id]') as HTMLElement;
+    vi.spyOn(node, 'getBoundingClientRect').mockReturnValue({ height: 800 } as DOMRect);
+    visibility(node, true);
+    act(() => resize?.());
+    visibility(node, false);
+    expect(node.style.height).toBe('800px');
+    rerender(<MonitoringViewportContext.Provider value={{ root, active: false }}>{children}</MonitoringViewportContext.Provider>);
+    expect(callbacks.size).toBe(0);
+    expect(node.style.height).toBe('800px');
+  });
+
+  it('renders a focused source-message anchor immediately and leaves workbench rendering alone', () => {
+    installObservers();
+    const { rerender } = render(<MonitoringViewportContext.Provider value={{ root, active: true, focusMessageId: 'source' }}>
+      <MonitoringMessageViewport id="merged" sourceIds={['source']} active={false}><p>focused evidence</p></MonitoringMessageViewport>
+    </MonitoringViewportContext.Provider>);
+    expect(screen.getByText('focused evidence')).toBeInTheDocument();
+    rerender(<MonitoringMessageViewport id="normal" active={false}><p>ordinary chat</p></MonitoringMessageViewport>);
+    expect(screen.getByText('ordinary chat')).toBeInTheDocument();
+  });
+});
diff --git a/webui/src/components/common/MonitoringViewport.tsx b/webui/src/components/common/MonitoringViewport.tsx
new file mode 100644
index 00000000..86eb7d6d
--- /dev/null
+++ b/webui/src/components/common/MonitoringViewport.tsx
@@ -0,0 +1,79 @@
+import { createContext, useContext, useEffect, useLayoutEffect, useRef, useState, type ReactNode, type RefObject } from 'react';
+
+export const MonitoringViewportContext = createContext<{
+  root: RefObject<HTMLDivElement | null>;
+  active: boolean;
+  focusMessageId?: string | null;
+} | null>(null);
+
+type Disclosure = { open: boolean; touched: boolean };
+const DisclosureContext = createContext<Map<string, Disclosure> | null>(null);
+
+/** Keep user expansion choices when a message leaves and re-enters the viewport. */
+export function useMonitoringDisclosure(key: string, defaultOpen: boolean) {
+  const cache = useContext(DisclosureContext);
+  const [state, setState] = useState<Disclosure>(() => cache?.get(key) || { open: defaultOpen, touched: false });
+  useEffect(() => {
+    setState(previous => previous.touched || previous.open === defaultOpen ? previous : { open: defaultOpen, touched: false });
+  }, [defaultOpen]);
+  useEffect(() => { cache?.set(key, state); }, [cache, key, state]);
+  return [state.open, (open: boolean) => {
+    const next = { open, touched: true };
+    cache?.set(key, next);
+    setState(next);
+  }] as const;
+}
+
+/** Lightweight anchor shells remain mounted; expensive message bodies only exist near the reader. */
+export function MonitoringMessageViewport({ id, sourceIds, active, children }: {
+  id: string; sourceIds?: string[]; active: boolean; children: ReactNode;
+}) {
+  const viewport = useContext(MonitoringViewportContext);
+  const node = useRef<HTMLDivElement>(null);
+  const height = useRef(240);
+  const disclosures = useRef(new Map<string, Disclosure>());
+  const [visible, setVisible] = useState(() => !viewport || typeof IntersectionObserver === 'undefined');
+  const forced = active || !!(viewport?.focusMessageId && (id === viewport.focusMessageId || sourceIds?.includes(viewport.focusMessageId)));
+  const mounted = !viewport || visible || forced;
+
+  useEffect(() => {
+    if (!viewport?.active || typeof IntersectionObserver === 'undefined' || !node.current) return;
+    const observer = new IntersectionObserver(entries => {
+      const entry = entries[entries.length - 1];
+      if (entry) setVisible(entry.isIntersecting);
+    }, { root: viewport.root.current, rootMargin: '1200px 0px' });
+    observer.observe(node.current);
+    return () => observer.disconnect();
+  }, [viewport?.root, viewport?.active]);
+
+  useLayoutEffect(() => {
+    if (!viewport?.active || !mounted || !node.current) return;
+    const measure = () => {
+      const measured = node.current?.getBoundingClientRect().height || 0;
+      if (measured > 0) height.current = measured;
+    };
+    measure();
+    if (typeof ResizeObserver === 'undefined') return;
+    const observer = new ResizeObserver(measure);
+    observer.observe(node.current);
+    return () => observer.disconnect();
+  }, [mounted, viewport?.active]);
+
+  return <div ref={node} data-message-id={id} data-monitor-placeholder={mounted ? undefined : ''}
+    className="rounded-md transition-shadow duration-300" style={mounted ? undefined : { height: height.current }}>
+    <DisclosureContext.Provider value={disclosures.current}>{mounted ? children : null}</DisclosureContext.Provider>
+  </div>;
+}
+
+/** renderBody is deliberately a function: unopened payloads must not be serialized. */
+export function MonitoringDeferredDetails({ summary, renderBody, cacheKey, className, testId }: {
+  summary: ReactNode; renderBody: () => ReactNode; cacheKey: string; className?: string; testId?: string;
+}) {
+  const enabled = !!useContext(MonitoringViewportContext);
+  const [open, setOpen] = useMonitoringDisclosure(cacheKey, false);
+  return <details className={className} data-testid={testId} open={enabled ? open : undefined}>
+    <summary className="cursor-pointer px-3 py-2.5 text-sm font-medium text-slate-800 dark:text-slate-200"
+      onClick={enabled ? event => { event.preventDefault(); setOpen(!open); } : undefined}>{summary}</summary>
+    {(!enabled || open) && renderBody()}
+  </details>;
+}
