+import client from './client';
+
+export type KnowledgeSource = 'outputs' | 'memory';
+export type KnowledgeView = KnowledgeSource | 'knowledge';
+export type KnowledgeRoot = 'personal' | 'shared' | 'legacy' | 'memory';
+
+export interface KnowledgeNode {
+  name: string;
+  path: string;
+  root: KnowledgeRoot;
+  root_label: string;
+  type: 'file' | 'directory';
+  size?: number;
+  modified_at?: number;
+  is_text_file?: boolean;
+  children?: KnowledgeNode[];
+}
+
+export interface OutputGroup {
+  date: string;
+  file_count: number;
+  entries: KnowledgeNode[];
+}
+
+export interface OutputListResponse {
+  groups: OutputGroup[];
+  other: KnowledgeNode[];
+  truncated: boolean;
+}
+
+export interface MemorySection {
+  id: 'profile' | 'global' | 'projects' | 'daily';
+  entries: KnowledgeNode[];
+}
+
+export interface MemoryListResponse {
+  sections: MemorySection[];
+}
+
+export interface KnowledgeFileResponse {
+  path: string;
+  content: string;
+  truncated: boolean;
+  size: number;
+  preview_limit_bytes: number;
+}
+
+export interface CatalogNode extends KnowledgeNode {
+  category: string;
+  category_title: string;
+  subcategory: string;
+  subcategory_title: string;
+  tags: string[];
+  date: string;
+  topic: string;
+  topic_title: string;
+  kind: 'document' | 'evidence' | 'process';
+  extension: string;
+  version_count: number;
+}
+
+export interface CatalogSummary {
+  categories: { id: string; title: string; description: string; count: number;
+    subcategories: { id: string; title: string; count: number }[] }[];
+  count: number;
+  topics: number;
+  tags: string[];
+  extensions: string[];
+  truncated: boolean;
+  indexed_at: number;
+}
+
+export interface CatalogPage {
+  items: CatalogNode[];
+  total: number;
+  file_count: number;
+  offset: number;
+  has_more: boolean;
+  indexed_at: number;
+  truncated: boolean;
+}
+
+export interface CatalogContext { node: CatalogNode | null; related: CatalogNode[]; related_truncated?: boolean }
+
+export interface ExperienceSource {
+  id: string;
+  root: KnowledgeRoot;
+  path: string;
+  name: string;
+  date: string;
+}
+
+export interface ExperienceCoverage {
+  total: number;
+  processed: number;
+  skipped: number;
+  failed: number;
+  pending?: number;
+  unsupported?: number;
+  too_large?: number;
+  incomplete?: boolean;
+  generation_failed?: boolean;
+}
+
+export interface ExperienceDaily {
+  enabled: boolean;
+  locked: boolean;
+  date: string;
+  timezone: string;
+  mode: 'initial' | 'incremental' | 'reused';
+  sample_count: number;
+  sample_limit: number;
+  available_count: number;
+  pending_count: number;
+  base_version: string | null;
+  generation_method: 'model' | 'extractive' | 'reused';
+  scan_incomplete?: boolean;
+}
+
+export interface ExperienceDocument {
+  status: 'empty' | 'ready' | 'running' | 'failed' | 'stale';
+  category: string;
+  title: string;
+  content: string | null;
+  updated_at: string | null;
+  last_attempt_at?: string | null;
+  version: string | null;
+  sources: ExperienceSource[];
+  coverage: ExperienceCoverage;
+  pending_coverage?: ExperienceCoverage | null;
+  daily?: ExperienceDaily | null;
+  changes: { added: number; modified: number; removed: number };
+  error: string | null;
+}
+
+export interface ExperienceVersion { version: string; updated_at: string; processed: number }
+
+function fileParams(source: KnowledgeSource, node: KnowledgeNode) {
+  return { source, root: node.root, path: node.path };
+}
+
+function fileUrl(endpoint: 'preview' | 'download', source: KnowledgeSource, node: KnowledgeNode) {
+  const params = new URLSearchParams(fileParams(source, node));
+  return `${client.defaults.baseURL ?? ''}/api/knowledge/${endpoint}?${params.toString()}`;
+}
+
+export const knowledgeAPI = {
+  experience: (category: string, version?: string) =>
+    client.get<ExperienceDocument>(`/api/knowledge/experience/${encodeURIComponent(category)}`, { params: version ? { version } : undefined }),
+  experienceHistory: (category: string) =>
+    client.get<ExperienceVersion[]>(`/api/knowledge/experience/${encodeURIComponent(category)}/history`),
+  refreshExperience: (category: string) =>
+    client.post<{ status: 'running' } | { status: 'unchanged'; version: string; daily: ExperienceDaily }>(
+      '/api/knowledge/experience/refresh', { category },
+    ),
+  outputEntry: (root: string, path: string) =>
+    client.get<KnowledgeNode>('/api/knowledge/output-entry', { params: { root, path } }),
+  catalog: (include_process: boolean, refresh = false) =>
+    client.get<CatalogSummary>('/api/knowledge/catalog', { params: { include_process, refresh } }),
+  catalogFiles: (params: Record<string, string | number | boolean>) =>
+    client.get<CatalogPage>('/api/knowledge/catalog/files', { params }),
+  catalogContext: (node: Pick<KnowledgeNode, 'root' | 'path'>) =>
+    client.get<CatalogContext>('/api/knowledge/catalog/context', { params: { root: node.root, path: node.path } }),
+  listOutputs: () => client.get<OutputListResponse>('/api/knowledge/outputs'),
+  listMemory: () => client.get<MemoryListResponse>('/api/knowledge/memory'),
+  readFile: (source: KnowledgeSource, node: KnowledgeNode) =>
+    client.get<KnowledgeFileResponse>('/api/knowledge/file', { params: fileParams(source, node) }),
+  previewUrl: (source: KnowledgeSource, node: KnowledgeNode) => fileUrl('preview', source, node),
+  downloadUrl: (source: KnowledgeSource, node: KnowledgeNode) => fileUrl('download', source, node),
+};
