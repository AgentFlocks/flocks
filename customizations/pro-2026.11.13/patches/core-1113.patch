+    const view = render(<ManagedManualRun workflowId={ids[0]} trigger={trigger} />);
+    await open();
+    fireEvent.change(screen.getByRole('textbox'), { target: { value: '{"scenario":"normal"}' } });
+    await run();
+    view.rerender(<ManagedManualRun workflowId={ids[1]} trigger={trigger} />);
+    expect(screen.getByRole('button', { name: '手动运行' })).toHaveAttribute('aria-expanded', 'false');
+    await open();
+    expect(screen.getByRole('textbox')).toHaveValue('{}');
+    await run();
+    await act(async () => newRequest.resolve(response('error', { result: { id: 'new-exec', status: 'error' } })));
+    await act(async () => oldRequest.resolve(response('success', { result: { id: 'old-exec', status: 'success' } })));
