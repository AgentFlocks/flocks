+    async def query(policy, session, message, capability, event, entity):
+        if entity == 'proof':
+            return {'data': [{'uuId': event['id'], 'alertTimeLine': []}]}, {'action': 'get_proof', 'uuid': event['id']}
+        assert entity == 'host'
