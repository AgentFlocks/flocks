@@ -0,0 +1,118 @@
+"""A Git-maintained distribution must not be replaced by an official release."""
+
+from pathlib import Path
+from unittest.mock import AsyncMock
+
+import pytest
+import typer
+from fastapi import HTTPException
+from starlette.requests import Request
+from typer.testing import CliRunner
+
+from flocks.updater import deploy, source_branch, updater
+
+
+@pytest.fixture
+def git_source(tmp_path, monkeypatch):
+    (tmp_path / "pyproject.toml").write_text(
+        '[tool.flocks.customization]\nbranch = "zw_dev"\nupdate-method = "git"\n',
+        encoding="utf-8",
+    )
+    monkeypatch.setattr(source_branch, "_source_root", lambda: tmp_path)
+    monkeypatch.setattr(deploy, "detect_deploy_mode", lambda: "source")
+    return tmp_path
+
+
+def test_committed_distribution_declares_git_updates(monkeypatch):
+    root = Path(__file__).resolve().parents[2]
+    monkeypatch.setattr(source_branch, "_source_root", lambda: root)
+    assert source_branch.source_update_refusal() == source_branch.SOURCE_BRANCH_UPGRADE_REFUSAL
+
+
+def test_plain_source_is_still_eligible_for_official_updates():
+    assert source_branch.source_update_refusal() is None
+    assert deploy.update_allowed_for_mode("source") is True
+
+
+def test_git_distribution_refuses_source_replacement(git_source):
+    assert deploy.update_allowed_for_mode("source") is False
+    assert deploy.install_modification_refusal("source") == source_branch.SOURCE_BRANCH_UPGRADE_REFUSAL
+    assert deploy.update_refusal_reason("source") == source_branch.SOURCE_BRANCH_UPGRADE_REFUSAL
+
+
+@pytest.mark.parametrize("mode,reason", [
+    ("managed", deploy.MANAGED_UPGRADE_REFUSAL),
+    ("docker", deploy.DOCKER_UPGRADE_REFUSAL),
+    ("offline", deploy.OFFLINE_UPGRADE_REFUSAL),
+])
+def test_deployment_restrictions_keep_their_own_reason(git_source, mode, reason):
+    assert deploy.update_allowed_for_mode(mode) is False
+    assert deploy.update_refusal_reason(mode) == reason
+
+
+@pytest.mark.asyncio
+async def test_check_reports_local_version_without_remote_access(git_source, monkeypatch):
+    monkeypatch.setattr(updater, "_get_updater_config", AsyncMock(side_effect=AssertionError("must not fetch")))
+    monkeypatch.setattr(updater, "get_current_version", lambda: "2026.11.09")
+    info = await updater.check_update()
+    assert info.current_version == "2026.11.09"
+    assert info.update_allowed is False
+    assert info.has_update is False
+    assert info.error is None
+
+
+@pytest.mark.asyncio
+async def test_direct_update_refuses_before_download_or_writes(git_source, monkeypatch):
+    monkeypatch.setattr(updater, "_get_updater_config", AsyncMock(side_effect=AssertionError("must not fetch")))
+    before = (git_source / "pyproject.toml").read_bytes()
+    events = [event async for event in updater.perform_update("v2026.11.10")]
+    assert len(events) == 1
+    assert events[0].stage == "error"
+    assert events[0].success is False
+    assert "zw_dev" in events[0].message
+    assert (git_source / "pyproject.toml").read_bytes() == before
+
+
+@pytest.mark.asyncio
+async def test_dependency_repair_checks_the_target_checkout(git_source, monkeypatch):
+    run = AsyncMock(return_value=(0, "", ""))
+    monkeypatch.setattr(updater, "_run_async", run)
+    refusal = await updater._sync_project_dependencies(uv_path="uv", install_root=git_source)
+    assert refusal == source_branch.SOURCE_BRANCH_UPGRADE_REFUSAL
+    run.assert_not_awaited()
+
+    plain_source = git_source / "plain-source"
+    plain_source.mkdir()
+    (plain_source / "pyproject.toml").write_text('[project]\nname = "ordinary"\n')
+    assert await updater._sync_project_dependencies(uv_path="uv", install_root=plain_source) is None
+    run.assert_awaited_once()
+
+
+@pytest.mark.parametrize("arguments,exit_code", [
+    (["--yes"], 1),
+    (["--force", "--yes"], 1),
+    (["--channel", "extension", "--yes"], 1),
+    (["--check"], 0),
+])
+def test_cli_explains_git_update_path(git_source, arguments, exit_code):
+    from flocks.cli.commands.update import update_command
+
+    cli = typer.Typer()
+    cli.command("update")(update_command)
+    result = CliRunner().invoke(cli, arguments)
+    assert result.exit_code == exit_code
+    assert "zw_dev" in result.output
+    assert "git pull --ff-only origin zw_dev" in " ".join(result.output.split())
+
+
+@pytest.mark.asyncio
+async def test_http_upgrade_refuses_with_conflict(git_source, monkeypatch):
+    from flocks.server.routes import update as routes
+
+    monkeypatch.setattr(routes, "require_admin", lambda request: None)
+    monkeypatch.setattr(routes, "detect_deploy_mode", lambda: "source")
+    request = Request({"type": "http", "method": "POST", "path": "/api/update/apply", "headers": []})
+    with pytest.raises(HTTPException) as caught:
+        await routes.apply_update(request)
+    assert caught.value.status_code == 409
+    assert "zw_dev" in caught.value.detail
