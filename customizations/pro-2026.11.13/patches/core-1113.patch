+def concat_ws_to_dpipe_sql(self: Generator, expression: exp.ConcatWs) -> str:
+    delim, *rest_args = expression.expressions
+    return self.sql(
+        reduce(
+            lambda x, y: exp.DPipe(this=x, expression=exp.DPipe(this=delim, expression=y)),
+            rest_args,
+        )
+    )
