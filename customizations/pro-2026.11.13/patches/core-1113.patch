+        spec = importlib.util.spec_from_file_location("knowledge_experience_daily_test", path)
+        self.daily = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(self.daily)
+        patch.object(self.module, "_daily_module", return_value=self.daily).start()
+        self.clock = datetime(2026, 9, 11, 4, 0, tzinfo=timezone.utc)
+        patch.object(self.daily, "_now", side_effect=lambda: self.clock).start()
+        patch.object(self.module, "_now", side_effect=lambda: self.clock.isoformat(timespec="seconds")).start()
+
+    def source(self, name="巡检报告.md", text="巡检发现：设备在线。", **kwargs):
+        path = legacy_tests.KnowledgeExperienceTests.source(self, name, text, **kwargs)
+        os.utime(path, (self.clock.timestamp(), self.clock.timestamp()))
+        return path
+
+    def next_day(self):
+        self.clock += timedelta(days=1)
+
+    def saved(self):
