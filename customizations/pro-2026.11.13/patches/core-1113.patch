@@ -0,0 +1,54 @@
+import { act, cleanup, renderHook } from '@testing-library/react';
+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest';
+import { usageAPI } from '@/api/provider';
+import type { UsageStats } from '@/types';
+import { __resetProviderUsageForTesting, useProviderUsage } from './useProviderUsage';
+vi.mock('@/api/provider', () => ({ usageAPI: { getSummary: vi.fn() } }));
+const getSummary = vi.mocked(usageAPI.getSummary);
+const stats = (tokens: number) => ({ summary: { total_tokens: tokens }, by_provider: [], by_model: [], daily: [] } as UsageStats);
+const deferred = () => { let resolve!: (value: { data: UsageStats }) => void;
+  const promise = new Promise<{ data: UsageStats }>(r => { resolve = r; }); return { promise, resolve }; };
+beforeEach(() => { vi.useFakeTimers(); getSummary.mockReset(); sessionStorage.clear(); __resetProviderUsageForTesting(); });
+afterEach(() => { cleanup(); vi.useRealTimers(); __resetProviderUsageForTesting(); });
+describe('provider usage request scheduling', () => {
+  it('accepts responses slower than several polling intervals without overlapping requests', async () => {
+    const slow = deferred(); getSummary.mockReturnValue(slow.promise as never);
+    const { result } = renderHook(() => useProviderUsage('a', 'admin'));
+    await act(async () => { await vi.advanceTimersByTimeAsync(16_000); });
+    expect(getSummary).toHaveBeenCalledTimes(1);
+    expect(result.current.loading).toBe(true);
+    await act(async () => { slow.resolve({ data: stats(123) }); });
+    expect(result.current.data?.summary.total_tokens).toBe(123);
+    expect(result.current.loading).toBe(false);
+    getSummary.mockResolvedValue({ data: stats(140) } as never);
+    await act(async () => { await vi.advanceTimersByTimeAsync(5000); });
+    expect(getSummary).toHaveBeenCalledTimes(2);
+    expect(result.current.data?.summary.total_tokens).toBe(140);
+  });
+  it('shares pending requests and isolates late replies after provider switches', async () => {
+    const a = deferred(); const b = deferred();
+    getSummary.mockImplementation(({ provider_id } = {}) => (provider_id === 'a' ? a.promise : b.promise) as never);
+    const { result, rerender } = renderHook(({ id }) => useProviderUsage(id, 'admin'), { initialProps: { id: 'a' } });
+    rerender({ id: 'b' }); rerender({ id: 'a' });
+    expect(getSummary).toHaveBeenCalledTimes(2);
+    await act(async () => { b.resolve({ data: stats(900) }); });
+    expect(result.current.data).toBeNull();
+    await act(async () => { a.resolve({ data: stats(100) }); });
+    expect(result.current.data?.summary.total_tokens).toBe(100);
+    rerender({ id: 'b' });
+    expect(result.current.data?.summary.total_tokens).toBe(900);
+  });
+  it('restores the last real snapshot after remount and keeps it on network failure', async () => {
+    getSummary.mockResolvedValue({ data: stats(99) } as never);
+    const first = renderHook(() => useProviderUsage('a', 'admin'));
+    await act(async () => {}); first.unmount(); __resetProviderUsageForTesting();
+    getSummary.mockRejectedValue(new Error('timeout'));
+    const { result } = renderHook(() => useProviderUsage('a', 'admin'));
+    expect(result.current.data?.summary.total_tokens).toBe(99);
+    await act(async () => {});
+    expect(result.current.data?.summary.total_tokens).toBe(99);
+    expect(result.current.error).toBe(true);
+    const other = renderHook(() => useProviderUsage('a', 'member'));
+    expect(other.result.current.data).toBeNull();
