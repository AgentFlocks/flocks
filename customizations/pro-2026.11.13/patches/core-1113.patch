+
+const configuration = vi.hoisted(() => ({
+  schemaVersion: 1, enabled: true, ownerName: '李向阳', emailDisplay: 'lxy16400@cnki.net',
+  recoveryMinMinutes: 40, recoveryMaxMinutes: 120,
+}));
+vi.mock('./taskIncidentConfig.json', () => ({ default: configuration }));
+
+function failedTask(overrides: Partial<TaskExecution> = {}): TaskExecution {
+  return {
+    id: 'texec-incident-1', schedulerID: 'scheduler-1', title: '设备巡检任务', description: '', priority: 'normal',
+    source: { sourceType: 'scheduled_trigger' }, triggerType: 'scheduled', status: 'failed', deliveryStatus: 'viewed',
+    completedAt: '2026-09-10T01:00:02Z', updatedAt: '2026-09-10T01:00:03Z', createdAt: '2026-09-10T01:00:00Z',
+    executionInputSnapshot: {}, retry: { maxRetries: 3, retryCount: 1, retryDelaySeconds: 60 },
+    executionMode: 'agent', agentName: 'rex', ...overrides,
+  };
+}
+
+function expectThreeNodes(region: HTMLElement) {
+  const nodes = within(within(region).getByRole('list')).getAllByRole('listitem');
+  expect(nodes).toHaveLength(3);
+  expect(within(region).getAllByRole('heading', { level: 5 }).map((heading) => heading.textContent))
