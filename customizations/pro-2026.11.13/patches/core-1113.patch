+  return <ExperienceContent key={JSON.stringify([user?.id, user?.username, user?.role, user?.status, props.category])} {...props} canUpdate={Boolean(user && user.status === 'active')} />;
+}
+
+function ExperienceContent({ category, onOpenSource, canUpdate }: ExperienceOverviewProps & { canUpdate: boolean }) {
