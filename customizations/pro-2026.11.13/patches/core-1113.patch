+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useSearchParams } from 'react-router-dom';
+import { ChevronDown, ChevronRight, FileText, History, Loader2, RefreshCw, Search } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+import { knowledgeAPI, type CatalogNode, type CatalogPage, type CatalogSummary, type KnowledgeNode } from '@/api/knowledge';
+
+export default function CatalogBrowser({ selected, onSelect, onCategorySelect }: {
+  selected: KnowledgeNode | null;
+  onSelect: (node: KnowledgeNode) => void;
+  onCategorySelect: () => void;
+}) {
+  const { t } = useTranslation('workspace');
+  const [params, setParams] = useSearchParams();
+  const [summary, setSummary] = useState<CatalogSummary | null>(null);
+  const [page, setPage] = useState<CatalogPage | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+  const [revision, setRevision] = useState(0);
+  const [refreshing, setRefreshing] = useState(false);
+  const [search, setSearch] = useState(params.get('query') ?? '');
+  const category = params.get('category') ?? '';
+  const [expandedCategories, setExpandedCategories] = useState<Set<string>>(() => new Set(category ? [category] : []));
+  const subcategory = params.get('subcategory') ?? '';
+  const topic = params.get('topic') ?? '';
+  const includeProcess = params.get('process') === '1';
+  const latest = params.get('latest') !== '0';
+  const withEvidence = params.get('evidence') === '1';
+  const offset = Math.max(0, Number(params.get('offset')) || 0);
+  const tag = params.get('tag') ?? '';
+  const extension = params.get('extension') ?? '';
+  const after = params.get('after') ?? '';
+  const before = params.get('before') ?? '';
+  const query = params.get('query') ?? '';
+  const requestedPath = params.get('path');
+  const requestedRoot = params.get('root');
+  const splitRef = useRef<HTMLDivElement>(null);
+  const dragRef = useRef<{ id: number; y: number; share: number; height: number } | null>(null);
+  const [categoryShare, setCategoryShare] = useState(40);
+  const resizeCategories = (share: number) => setCategoryShare(Math.min(80, Math.max(20, share)));
+
+  const update = useCallback((values: Record<string, string>, replace = false) => {
+    setParams((current) => {
+      const next = new URLSearchParams(current);
+      next.delete('offset');
+      for (const [key, value] of Object.entries(values)) {
+        if (value) next.set(key, value); else next.delete(key);
+      }
+      return next;
+    }, { replace });
+  }, [setParams]);
+
+  useEffect(() => { setSearch(query); }, [query]);
+
+  useEffect(() => {
+    if (search === query) return;
+    const timeout = window.setTimeout(() => update({ query: search, topic: '' }, true), 300);
+    return () => window.clearTimeout(timeout);
+  }, [search, query, update]);
+
+  useEffect(() => {
+    let active = true;
+    setSummary(null);
+    void knowledgeAPI.catalog(includeProcess).then((response) => {
+      if (active) setSummary(response.data);
+    }).catch((err) => { if (active) setError(err?.response?.data?.detail ?? String(err)); });
+    return () => { active = false; };
+  }, [includeProcess, revision]);
+
+  useEffect(() => {
+    let active = true;
+    setLoading(true);
+    setError('');
+    void knowledgeAPI.catalogFiles({ category, subcategory, topic, include_process: includeProcess,
+      latest, with_evidence: withEvidence, offset, limit: 50, tag, extension, after, before, query }).then((response) => {
+      if (active) setPage(response.data);
+    }).catch((err) => {
+      if (active) { setError(err?.response?.data?.detail ?? String(err)); setPage(null); }
+    }).finally(() => { if (active) setLoading(false); });
+    return () => { active = false; };
+  }, [category, subcategory, topic, includeProcess, latest, withEvidence, offset, tag, extension, after, before, query, revision]);
+
+  // Resolve a deep link independently of the current page (including old versions).
+  useEffect(() => {
+    let active = true;
+    if (requestedPath && requestedRoot && (selected?.path !== requestedPath || selected?.root !== requestedRoot)) {
+      void knowledgeAPI.catalogContext({ path: requestedPath, root: requestedRoot as KnowledgeNode['root'] })
+        .then((response) => {
+          if (active && response.data.node) onSelect(response.data.node);
+          else if (active) setError(t('knowledge.catalog.missing'));
+        }).catch(() => { if (active) setError(t('knowledge.catalog.missing')); });
+    }
+    return () => { active = false; };
+  }, [requestedPath, requestedRoot, selected, loading, page, onSelect, t]);
+
+  const refresh = async () => {
+    setRefreshing(true);
+    try {
+      await knowledgeAPI.catalog(includeProcess, true);
