+    assert completed['metrics']['riskClosed'] == 1 and completed['metrics']['closed'] == 1
+    assert completed['events'][0]['assessment']['status'] == 'risk_closed'
+    assert [call['action'] for call in setup.calls].count('update_status') == 1
