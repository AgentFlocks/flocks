@@ -0,0 +1,203 @@
+import { useMemo, useState } from 'react';
+import { AlertTriangle, ChevronDown, ChevronUp, Copy } from 'lucide-react';
+import { useTranslation } from 'react-i18next';
+import type { TaskExecution } from '@/api/task';
+import { useToast } from '@/components/common/Toast';
+import { copyText } from '@/utils/clipboard';
+import TaskIncidentTimeline from './TaskIncidentTimeline';
+import { isMonitoringTask, monitorFailureMessage } from './monitorTaskFailure';
+
+const MAX_DISPLAY_ERROR_LENGTH = 20_000;
+const COLLAPSE_THRESHOLD = 240;
+
+export interface TaskFailurePresentation {
+  message: string;
+  inferred: boolean;
+  stage: 'beforeStart' | 'agentSession' | 'agentExecution' | 'workflowExecution' | 'unknown';
+  retriesExhausted: boolean;
+}
+
+export function getTaskFailurePresentation(
+  task: TaskExecution,
+  translate: (key: string, options?: Record<string, unknown>) => string,
+): TaskFailurePresentation {
+  const recordedError = task.error?.trim();
+  const retriesExhausted = task.retry.maxRetries > 0
+    && task.retry.retryCount >= task.retry.maxRetries;
+
+  if (recordedError) {
+    return {
+      message: monitorFailureMessage(task, recordedError),
+      inferred: false,
+      stage: 'unknown',
+      retriesExhausted,
+    };
+  }
+
+  let stage: TaskFailurePresentation['stage'] = 'unknown';
+  let messageKey = 'queued.failureDetail.fallbackUnknown';
+  if (!task.startedAt) {
+    stage = 'beforeStart';
+    messageKey = 'queued.failureDetail.fallbackBeforeStart';
+  } else if (task.executionMode === 'agent' && !task.sessionID) {
+    stage = 'agentSession';
+    messageKey = 'queued.failureDetail.fallbackAgentSession';
+  } else if (task.executionMode === 'agent') {
+    stage = 'agentExecution';
+    messageKey = 'queued.failureDetail.fallbackAgentExecution';
+  } else if (task.executionMode === 'workflow') {
+    stage = 'workflowExecution';
+    messageKey = 'queued.failureDetail.fallbackWorkflowExecution';
+  }
+
+  const baseMessage = translate(messageKey, { executor: task.agentName || 'Agent' });
+  return {
+    message: retriesExhausted
+      ? `${baseMessage} ${translate('queued.failureDetail.retriesExhausted')}`
+      : baseMessage,
+    inferred: true,
+    stage,
+    retriesExhausted,
+  };
+}
+
+function formatTimestamp(value: string | undefined, language: string): string {
+  if (!value) return '--';
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) return '--';
+  return new Intl.DateTimeFormat(language, {
+    year: 'numeric',
+    month: '2-digit',
+    day: '2-digit',
+    hour: '2-digit',
+    minute: '2-digit',
+    second: '2-digit',
+    hour12: false,
+  }).format(date);
+}
+
+function formatDurationMs(value: number | undefined): string {
+  if (value == null) return '--';
+  if (value < 1000) return `${value}ms`;
+  return `${(value / 1000).toFixed(value < 10_000 ? 2 : 1)}s`;
+}
+
+export default function TaskFailureDetail({ task }: { task: TaskExecution }) {
+  const { t, i18n } = useTranslation('task');
+  const { t: tCommon } = useTranslation('common');
+  const toast = useToast();
+  const [expanded, setExpanded] = useState(false);
+  const monitoring = isMonitoringTask(task);
+  const presentation = useMemo(
+    () => getTaskFailurePresentation(task, (key, options) => t(key, options)),
+    [task, t],
+  );
+  const truncatedByLimit = presentation.message.length > MAX_DISPLAY_ERROR_LENGTH;
+  const displayMessage = truncatedByLimit
+    ? `${presentation.message.slice(0, MAX_DISPLAY_ERROR_LENGTH)}\n${t('queued.failureDetail.truncated')}`
+    : presentation.message;
+  const canCollapse = displayMessage.length > COLLAPSE_THRESHOLD
+    || displayMessage.split('\n').length > 4;
+  const failedAt = task.completedAt || task.updatedAt;
+  const retryProgress = t('queued.failureDetail.retryValue', {
+    count: task.retry.retryCount,
+    max: task.retry.maxRetries,
+  });
+
+  const copiedDetail = monitoring ? displayMessage : [
+    `${t('queued.failureDetail.source')}: ${t(presentation.inferred
+      ? 'queued.failureDetail.inferred'
+      : 'queued.failureDetail.recorded')}`,
+    `${t('queued.failureDetail.reason')}: ${displayMessage}`,
+    `${t('queued.failureDetail.executionId')}: ${task.id}`,
+    `${t('queued.failureDetail.failedAt')}: ${formatTimestamp(failedAt, i18n.language)}`,
+    `${t('queued.failureDetail.duration')}: ${formatDurationMs(task.durationMs)}`,
+    `${t('queued.failureDetail.retryProgress')}: ${retryProgress}`,
+  ].filter(Boolean).join('\n');
+
+  const handleCopy = async () => {
+    try {
+      await copyText(copiedDetail);
+      toast.success(tCommon('clipboard.copySuccessTitle'));
+    } catch (error) {
+      toast.error(
+        tCommon('clipboard.copyFailedTitle'),
+        error instanceof Error ? error.message : tCommon('clipboard.copyFailedDescription'),
+      );
+    }
+  };
+
+  return (<>
+    <section
+      data-customization-id="task.failure-detail"
+      className="mx-6 mt-4 flex-shrink-0 rounded-xl border border-red-200 bg-red-50/70 p-4"
+      aria-label={t('queued.failureDetail.title')}
+    >
+      <div className="flex items-center justify-between gap-3">
+        <div className="flex min-w-0 items-center gap-2">
+          <AlertTriangle className="h-4 w-4 flex-shrink-0 text-red-600" />
+          <h4 className="text-sm font-semibold text-red-800">
+            {t('queued.failureDetail.title')}
+          </h4>
+          {!monitoring && <span className={`rounded px-1.5 py-0.5 text-[10px] font-medium ${
+            presentation.inferred
+              ? 'bg-amber-100 text-amber-700'
+              : 'bg-red-100 text-red-700'
+          }`}>
+            {t(presentation.inferred
+              ? 'queued.failureDetail.inferred'
+              : 'queued.failureDetail.recorded')}
+          </span>}
+        </div>
+        <button
+          type="button"
+          onClick={() => void handleCopy()}
+          className="inline-flex flex-shrink-0 items-center gap-1 rounded-md border border-red-200 bg-white px-2 py-1 text-xs text-red-700 transition-colors hover:bg-red-50"
+        >
+          <Copy className="h-3 w-3" />
+          {tCommon('button.copy')}
+        </button>
+      </div>
+
+      <div className="mt-3">
+        <div className="mb-1 text-xs font-medium text-red-700">
+          {t(monitoring ? 'queued.failureDetail.blocker' : 'queued.failureDetail.reason')}
+        </div>
+        <p className={`break-words whitespace-pre-wrap text-sm leading-6 text-red-900 ${
+          canCollapse && !expanded ? 'line-clamp-4' : ''
+        }`}>
+          {displayMessage}
+        </p>
+        {canCollapse && (
+          <button
+            type="button"
+            onClick={() => setExpanded((value) => !value)}
+            className="mt-1 inline-flex items-center gap-1 text-xs font-medium text-red-700 hover:text-red-900"
+          >
+            {expanded ? <ChevronUp className="h-3 w-3" /> : <ChevronDown className="h-3 w-3" />}
+            {t(expanded ? 'queued.failureDetail.collapse' : 'queued.failureDetail.expand')}
+          </button>
+        )}
+      </div>
+
+      {!monitoring && <dl className="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 border-t border-red-100 pt-3 text-xs sm:grid-cols-3">
+        <Metadata label={t('queued.failureDetail.executionId')} value={task.id} mono />
+        <Metadata label={t('queued.failureDetail.failedAt')} value={formatTimestamp(failedAt, i18n.language)} />
+        <Metadata label={t('queued.failureDetail.duration')} value={formatDurationMs(task.durationMs)} />
+        <Metadata label={t('queued.failureDetail.retryProgress')} value={retryProgress} />
+      </dl>}
+    </section>
+    <TaskIncidentTimeline task={task} />
+  </>);
+}
+
+function Metadata({ label, value, mono = false }: { label: string; value: string; mono?: boolean }) {
+  return (
+    <div className="min-w-0">
+      <dt className="text-red-600/80">{label}</dt>
+      <dd className={`mt-0.5 truncate text-red-900 ${mono ? 'font-mono' : ''}`} title={value}>
+        {value}
+      </dd>
+    </div>
+  );
+}
