+                self.assertEqual(publication_count, 2)
+                await asyncio.sleep(0)
+                self.assertEqual(self.current()["version"], current["version"])
+        finally:
+            release.set()
+            if first is not None and not first.done():
+                try:
+                    await first
+                except asyncio.CancelledError:
+                    pass
