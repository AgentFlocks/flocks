diff --git a/webui/src/pages/Task/monitorTaskFailure.ts b/webui/src/pages/Task/monitorTaskFailure.ts
new file mode 100644
index 00000000..9629e108
--- /dev/null
+++ b/webui/src/pages/Task/monitorTaskFailure.ts
@@ -0,0 +1,26 @@
+import type { TaskExecution } from '@/api/task';
+
+export function isMonitoringTask(task: TaskExecution): boolean {
+  return Boolean(task.executionInputSnapshot?.context?.monitoring)
+    || Boolean(task.sessionID?.startsWith('ses_monitor_'));
+}
+
+/** Project the round's recorded errors, never its historical investigation backlog.
+ * Keep the stored error and session unchanged; unknown formats remain readable.
+ */
+export function monitorFailureMessage(task: TaskExecution, error: string): string {
+  if (!isMonitoringTask(task)) return error;
+  const errors = error.match(/(?:^|\n)待跟进事项[：:]\s*([^\n]+)/)?.[1];
+  if (!errors) return error;
+
+  const message = errors
+    .replace(/智能体调查未完成[：:]\s*/g, '')
+    .replace(/。已有证据和待办保留，不据此判定无风险。?\s*$/, '')
+    .split('；')
+    .map((part) => part.trim()
+      .replace(/[，,]?已有证据(?:和待办)?保留[。]?/g, '')
+      .trim())
+    .filter((part) => part && !/^(?:本轮不再请求同一模型|后续轮次按退避计划重试|已保存(?:恢复|退避)计划|不早于\s*\d{4}-)/.test(part));
+  // Each event remains represented, even when more than five failed in a round.
+  return [...new Set(message)].join('；\n') || error;
+}
