+import { beforeEach, describe, expect, it } from 'vitest';
+import { clearDashboardSnapshots, DASHBOARD_CACHE_TTL_MS, readDashboardSnapshot, saveDashboardSnapshot }
+  from '../../../.flocks/flockshub/plugins/webuis/soc_ui/soc_dashboard/src/dashboardCache';
+
+const filter = { mode: 'relative', range: '7d', start: '', end: '' };
+describe('SOC dashboard return snapshots', () => {
+  beforeEach(clearDashboardSnapshots);
+  it('separates users and time ranges while retaining the last selected range', () => {
+    saveDashboardSnapshot('alice', filter, { stats: { total: 12 } }, 1000);
+    const today = { ...filter, range: 'today' };
+    saveDashboardSnapshot('alice', today, { stats: { total: 2 } }, 1001);
+    saveDashboardSnapshot('bob', filter, { stats: { total: 7 } }, 1002);
+    expect(readDashboardSnapshot('alice', filter, 1003).stats.total).toBe(12);
+    expect(readDashboardSnapshot('alice', undefined, 1003).filter.range).toBe('today');
+    expect(readDashboardSnapshot('bob', filter, 1003).stats.total).toBe(7);
+    expect(readDashboardSnapshot('carol', filter, 1003)).toBeUndefined();
+  });
+  it('discards snapshots after five minutes away', () => {
+    saveDashboardSnapshot('alice', filter, { stats: { total: 12 } }, 1000);
+    expect(readDashboardSnapshot('alice', filter, 1000 + DASHBOARD_CACHE_TTL_MS)).toBeUndefined();
+  });
+});
