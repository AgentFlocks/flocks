{
  "schemaVersion": "hub.plugin.v1",
  "id": "soc-workspace",
  "type": "component",
  "name": "SOC Workspace Component",
  "nameCn": "SOC 工作区场景套件",
  "description": "SOC workspace with alert triage, persistent investigations, governed response and incident reviews.",
  "descriptionCn": "SOC 工作区：告警研判、持续调查、受控处置及事件复盘。",
  "version": "1.1.1",
  "author": "Flocks Team",
  "license": "MIT",
  "homepage": "",
  "category": "workflow-automation",
  "tags": [
    "siem",
    "ndr",
    "integration"
  ],
  "useCases": [
    "alert-triage",
    "log-analysis",
    "security-reporting"
  ],
  "domains": [
    "security-ops"
  ],
  "capabilities": [
    "workflow"
  ],
  "trust": "official",
  "source": {
    "kind": "bundled",
    "path": "plugins/components/soc-workspace"
  },
  "compatibility": {
    "flocks": ">=0.8.0",
    "os": [
      "darwin",
      "linux",
      "windows"
    ]
  },
  "dependencies": {
    "skills": [],
    "tools": [],
    "python": [],
    "external": []
  },
  "permissions": {
    "tools": [
      "soc_workspace_query",
      "soc_case_manage"
    ],
    "network": false,
    "shell": false,
    "filesystem": "read-write"
  },
  "risk": {
    "level": "high",
    "reasons": [
      "Includes incident response approval and governed device execution; investigation and retrospective records remain plugin-owned."
    ]
  },
  "entrypoints": [
    "component.json"
  ],
  "components": [
    {
      "type": "webui",
      "id": "soc_ui"
    },
    {
      "type": "tool",
      "id": "soc_workspace_query",
      "adoptExisting": true
    },
    {
      "type": "workflow",
      "id": "stream_alert_denoise"
    },
    {
      "type": "workflow",
      "id": "stream_alert_triage"
    },
    {
      "type": "tool",
      "id": "soc_case_manage"
    },
    {
      "type": "agent",
      "id": "soc-investigator"
    },
    {
      "type": "workflow",
      "id": "soc_case_investigation"
    }
  ],
  "checksums": {}
}
