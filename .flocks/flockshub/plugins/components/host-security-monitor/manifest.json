{
  "schemaVersion": "hub.plugin.v1",
  "id": "host-security-monitor",
  "type": "component",
  "name": "Security Operations Monitoring",
  "nameCn": "安全运营监测",
  "description": "Read-only scheduled XDR monitoring with human-confirmed disposition and verified status readback.",
  "descriptionCn": "每十分钟只读筛选监测，复用每日原生会话；人工确认处置后写回 XDR 并回查闭环，同步看板与报告。",
  "version": "1.1.0",
  "author": "Flocks Team",
  "license": "MIT",
  "homepage": "",
  "category": "workflow-automation",
  "tags": [
    "xdr",
    "monitoring"
  ],
  "useCases": [
    "alert-triage",
    "log-analysis",
    "security-reporting"
  ],
  "domains": [
    "security-ops"
  ],
  "capabilities": [
    "workflow"
  ],
  "trust": "official",
  "source": {
    "kind": "bundled",
    "path": "plugins/components/host-security-monitor"
  },
  "compatibility": {
    "flocks": ">=0.8.0",
    "os": [
      "darwin",
      "linux",
      "windows"
    ]
  },
  "dependencies": {
    "skills": [],
    "tools": [],
    "python": [],
    "external": []
  },
  "permissions": {
    "tools": [
      "sangfor_xdr_incidents"
    ],
    "network": true,
    "shell": false,
    "filesystem": "read-write"
  },
  "risk": {
    "level": "medium",
    "reasons": [
      "人工确认后修改 XDR 事件处置状态；定时监测保持只读，不执行主机隔离或修复"
    ]
  },
  "entrypoints": [
    "component.json",
    "monitoring.json"
  ],
  "components": [],
  "checksums": {},
  "requiredCoreCapabilities": [
    "monitor.daily.v1",
    "monitor.readonly.v1",
    "monitor.native-messages.v1",
    "monitor.confirmed-disposition.v1"
  ],
  "edition": "oss"
}
