{
  "schemaVersion": "hub.plugin.v1",
  "id": "host-security-monitor",
  "type": "component",
  "name": "Security Operations Monitoring",
  "nameCn": "安全运营监测",
  "description": "Model-directed monitoring investigation with persistent evidence, bounded serial scheduling and verified mail follow-up.",
  "descriptionCn": "多XDR事件监测与责任人邮件闭环；可筛选风险看板、源端关闭分类、双时间排序及已确认风险保留。",
  "version": "1.17.0",
  "author": "Flocks Team",
  "license": "MIT",
  "homepage": "",
  "category": "workflow-automation",
  "tags": [
    "xdr",
    "monitoring"
  ],
  "useCases": [
    "alert-triage",
    "log-analysis",
    "security-reporting"
  ],
  "domains": [
    "security-ops"
  ],
  "capabilities": [
    "workflow"
  ],
  "trust": "official",
  "source": {
    "kind": "bundled",
    "path": "plugins/components/host-security-monitor"
  },
  "compatibility": {
    "flocks": ">=0.8.0",
    "os": [
      "darwin",
      "linux",
      "windows"
    ]
  },
  "dependencies": {
    "skills": [],
    "tools": [],
    "python": [],
    "external": []
  },
  "permissions": {
    "tools": [
      "sangfor_xdr_incidents",
      "tdp_log_search",
      "onesig_strategy_api_query"
    ],
    "network": true,
    "shell": true,
    "filesystem": "read-write"
  },
  "risk": {
    "level": "medium",
    "reasons": [
      "确认风险后向责任人发送单条告警邮件；无风险与中低风险观察到期事件可在下一轮标记忽略，明确完成反馈后标记处置完成并回查，不执行隔离或查杀",
      "关联查询仅使用项目绑定设备；TDP 时间计算使用固定的本地 Python 命令，模型无通用 Shell 权限"
    ]
  },
  "entrypoints": [
    "component.json",
    "monitoring.json"
  ],
  "components": [
    {
      "type": "agent",
      "id": "security-monitor",
      "optional": false
    }
  ],
  "checksums": {},
  "requiredCoreCapabilities": [
    "monitor.daily.v1",
    "monitor.readonly.v1",
    "monitor.native-messages.v1",
    "monitor.confirmed-disposition.v1",
    "monitor.automatic-status.v1",
    "monitor.mail-feedback.v1",
    "monitor.investigation.v1",
    "monitor.agent-component.v1",
    "monitor.production-investigation.v1",
    "monitor.reliable-investigation.v1",
    "monitor.multi-xdr.v1",
    "monitor.mail-manual.v1",
    "monitor.mail-retry.v1",
    "monitor.incident-evidence.v1",
    "monitor.event-list.v1",
    "monitor.confirmed-risk.v1",
    "monitor.next-round-disposition.v1",
    "monitor.source-membership.v1",
    "monitor.mail-controls.v1",
    "monitor.investigation-replan.v1",
    "monitor.event-list-controls.v1",
    "monitor.confirmed-findings.v1"
  ],
  "edition": "oss"
}
