  "version": "1.4.0",
  "author": "Flocks Team",
  "license": "MIT",
  "homepage": "",
  "category": "workflow-automation",
  "tags": [
    "xdr",
    "monitoring"
  ],
  "useCases": [
    "alert-triage",
    "log-analysis",
    "security-reporting"
  ],
  "domains": [
    "security-ops"
  ],
  "capabilities": [
    "workflow"
  ],
  "trust": "official",
  "source": {
    "kind": "bundled",
    "path": "plugins/components/host-security-monitor"
  },
  "compatibility": {
    "flocks": ">=0.8.0",
    "os": [
      "darwin",
      "linux",
      "windows"
    ]
  },
  "dependencies": {
    "skills": [],
    "tools": [],
    "python": [],
    "external": []
  },
  "permissions": {
    "tools": [
      "sangfor_xdr_incidents",
      "tdp_log_search",
      "onesig_strategy_api_query"
    ],
    "network": true,
    "shell": true,
    "filesystem": "read-write"
  },
  "risk": {
    "level": "medium",
    "reasons": [
      "启用邮件跟进后向配置的责任人发送告警；核验回信后同步 XDR 状态，不执行主机隔离或查杀",
      "关联查询仅使用项目绑定设备；TDP 时间计算使用固定的本地 Python 命令，模型无通用 Shell 权限"
    ]
  },
  "entrypoints": [
    "component.json",
    "monitoring.json"
  ],
  "components": [],
  "checksums": {},
  "requiredCoreCapabilities": [
    "monitor.daily.v1",
