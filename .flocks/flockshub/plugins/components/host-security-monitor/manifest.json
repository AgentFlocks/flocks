{
  "schemaVersion": "hub.plugin.v1",
  "id": "host-security-monitor",
  "type": "component",
  "name": "Security Operations Monitoring",
  "nameCn": "安全运营监测",
  "description": "Model-directed monitoring investigation with persistent evidence, bounded serial scheduling and verified mail follow-up.",
  "descriptionCn": "套件内置可安装的监测运营智能体；按证据查询关联，串行调度、邮件协同与回查由主程序保障。",
  "version": "1.6.0",
  "author": "Flocks Team",
  "license": "MIT",
  "homepage": "",
  "category": "workflow-automation",
  "tags": [
    "xdr",
    "monitoring"
  ],
  "useCases": [
    "alert-triage",
    "log-analysis",
    "security-reporting"
  ],
  "domains": [
    "security-ops"
  ],
  "capabilities": [
    "workflow"
  ],
  "trust": "official",
  "source": {
    "kind": "bundled",
    "path": "plugins/components/host-security-monitor"
  },
  "compatibility": {
    "flocks": ">=0.8.0",
    "os": [
      "darwin",
      "linux",
      "windows"
    ]
  },
  "dependencies": {
    "skills": [],
    "tools": [],
    "python": [],
    "external": []
  },
  "permissions": {
    "tools": [
      "sangfor_xdr_incidents",
      "tdp_log_search",
      "onesig_strategy_api_query"
    ],
    "network": true,
    "shell": true,
    "filesystem": "read-write"
  },
  "risk": {
    "level": "medium",
    "reasons": [
      "启用邮件跟进后向配置的责任人发送告警；核验回信后同步 XDR 状态，不执行主机隔离或查杀",
      "关联查询仅使用项目绑定设备；TDP 时间计算使用固定的本地 Python 命令，模型无通用 Shell 权限"
    ]
  },
  "entrypoints": [
    "component.json",
    "monitoring.json"
  ],
  "components": [
    {
      "type": "agent",
      "id": "security-monitor",
      "optional": false
    }
  ],
  "checksums": {},
  "requiredCoreCapabilities": [
    "monitor.daily.v1",
    "monitor.readonly.v1",
    "monitor.native-messages.v1",
    "monitor.confirmed-disposition.v1",
    "monitor.automatic-status.v1",
    "monitor.mail-feedback.v1",
    "monitor.investigation.v1",
    "monitor.agent-component.v1",
    "monitor.production-investigation.v1"
  ],
  "edition": "oss"
}
