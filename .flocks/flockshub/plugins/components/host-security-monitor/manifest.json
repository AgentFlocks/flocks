{
  "schemaVersion": "hub.plugin.v1",
  "id": "host-security-monitor",
  "type": "component",
  "name": "Security Operations Monitoring",
  "nameCn": "安全运营监测",
  "description": "Scheduled XDR monitoring with per-incident mail notifications, natural-language replies and verified status readback.",
  "descriptionCn": "开发联调：每十分钟随机分析一条事件；恶意证据充分时邮件通知，下轮解读完成反馈并标记忽略、回查。",
  "version": "1.3.2",
  "author": "Flocks Team",
  "license": "MIT",
  "homepage": "",
  "category": "workflow-automation",
  "tags": [
    "xdr",
    "monitoring"
  ],
  "useCases": [
    "alert-triage",
    "log-analysis",
    "security-reporting"
  ],
  "domains": [
    "security-ops"
  ],
  "capabilities": [
    "workflow"
  ],
  "trust": "official",
  "source": {
    "kind": "bundled",
    "path": "plugins/components/host-security-monitor"
  },
  "compatibility": {
    "flocks": ">=0.8.0",
    "os": [
      "darwin",
      "linux",
      "windows"
    ]
  },
  "dependencies": {
    "skills": [],
    "tools": [],
    "python": [],
    "external": []
  },
  "permissions": {
    "tools": [
      "sangfor_xdr_incidents"
    ],
    "network": true,
    "shell": false,
    "filesystem": "read-write"
  },
  "risk": {
    "level": "medium",
    "reasons": [
      "启用邮件跟进后向配置的责任人发送告警；核验回信后同步 XDR 状态，不执行主机隔离或查杀"
    ]
  },
  "entrypoints": [
    "component.json",
    "monitoring.json"
  ],
  "components": [],
  "checksums": {},
  "requiredCoreCapabilities": [
    "monitor.daily.v1",
    "monitor.readonly.v1",
    "monitor.native-messages.v1",
    "monitor.confirmed-disposition.v1",
    "monitor.automatic-status.v1",
    "monitor.mail-feedback.v1"
  ],
  "edition": "oss"
}
