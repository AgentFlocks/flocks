  },
  "compatibility": {
    "flocks": ">=2026.10.13",
    "os": [
      "darwin",
      "linux"
    ]
  },
  "dependencies": {
    "skills": [],
    "tools": [],
    "python": [],
    "external": [
      "Node.js available as node on PATH; bundled validators have no npm dependencies",
      "macOS or Linux with OS no-follow and nonblocking file protections for validator CLI",
      "An OS-enforced sandbox meeting SKILL.md controls before executing target-controlled code"
    ]
  },
  "permissions": {
    "tools": [
      "delegate_task",
      "send_to_session",
      "sleep",
      "read",
      "glob",
      "grep",
      "bash",
      "write"
    ],
    "network": false,
    "shell": true,
    "filesystem": "write"
  },
  "risk": {
    "level": "medium",
    "reasons": [
      "完整审计会写入报告和证据；目标代码只能在满足技能约束的隔离沙箱中执行。",
      "技能包不提供沙箱，依赖状态也不证明隔离能力；原生 Windows 无法运行完整校验流程。"
    ]
  },
