{
  "schemaVersion": "hub.plugin.v1",
  "id": "cloudflare-security-audit",
  "type": "skill",
  "name": "Cloudflare Security Audit",
  "nameCn": "Cloudflare 代码安全审计",
  "description": "Cloudflare 源码安全审计，覆盖 AI/LLM、MCP、发布供应链、租户隔离与资源耗尽，提供独立复核、覆盖台账和 JSON 校验。完整审计需 macOS/Linux + Node.js；执行目标代码前须具备符合要求的隔离沙箱。",
  "version": "1.0.0",
  "author": "Cloudflare; Flocks adaptation",
  "license": "MIT",
  "homepage": "https://github.com/cloudflare/security-audit-skill",
  "category": "devtools",
  "tags": [
    "vulnerability",
    "api-security",
    "web-security"
  ],
  "useCases": [
    "vulnerability-management",
    "security-reporting"
  ],
  "domains": [
    "security-ops",
    "devops"
  ],
  "capabilities": [
    "file-analysis",
    "llm-agent"
  ],
  "trust": "community",
  "edition": "oss",
  "source": {
    "kind": "bundled",
    "path": ".flocks/flockshub/plugins/skills/cloudflare-security-audit"
  },
